        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m1, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat2 = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m2, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margematch = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m3, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margelts = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`lts, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`grafmargat1 = 
     ListPlot[$CellContext`margemat1, Joined -> True, PlotStyle -> 
       RGBColor[1, 0, 1], DisplayFunction -> 
       Identity]; $CellContext`grafmargat2 = 
     ListPlot[$CellContext`margemat2, Joined -> True, PlotStyle -> 
