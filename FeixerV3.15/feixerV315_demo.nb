      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Desvanecimento", " ", "da", " ", "liga\[CCedilla]\[ATilde]o", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
         1, $CellContext`bota23 =!= 1, $CellContext`bota24 =!= 
         1, $CellContext`bota26 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
         N[$CellContext`botn]], $CellContext`bota28 = 1; $CellContext`botn = 
         91/10; Print[
         "Dist\[AHat]ncia da liga\[CCedilla]\[ATilde]o:  ", \
$CellContext`dliga, " km."]; $CellContext`f20 = 0; $CellContext`f01 = 
         0; $CellContext`F20 = 
         Table[0., {$CellContext`i, $CellContext`passivo + 
            1}, {$CellContext`j, $CellContext`numfreq}]; $CellContext`F01 = 
         Table[0., {$CellContext`i, $CellContext`passivo + 
            1}, {$CellContext`j, $CellContext`numfreq}]; $CellContext`tempo1 = 
         20/100; $CellContext`tempo2 = 
         0.1 ($CellContext`dliga/2500) (1/
           100); $CellContext`f3 = $CellContext`achuva; 
        Print["   O tempo n\[ATilde]o excedido para a 1\.aa cl\[AAcute]usula \
\[EAcute] ", 
          N[$CellContext`tempo1], " ."]; 
        Print["   O tempo n\[ATilde]o excedido para a 2\.aa cl\[AAcute]usula \
\[EAcute] ", 
          N[$CellContext`tempo2], " ."]; 
        For[$CellContext`i = 1, $CellContext`i <= $CellContext`passivo + 1, 
          
          Increment[$CellContext`i], $CellContext`claux1 = 
           Table[0., {$CellContext`i, $CellContext`numfreq}]; \
$CellContext`claux2 = Table[0., {$CellContext`i, $CellContext`numfreq}]; 
          For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
            Increment[$CellContext`j], 
            Part[$CellContext`claux1, $CellContext`j] = 
             FindRoot[$CellContext`tempo1 == \
$CellContext`prob2[$CellContext`aa1, $CellContext`i, $CellContext`j], \
{$CellContext`aa1, 1}]; 
            Part[$CellContext`F20, $CellContext`i, $CellContext`j] = 
             ReplaceAll[$CellContext`aa1, 
               Part[$CellContext`claux1, $CellContext`j]]; 
            Part[$CellContext`claux2, $CellContext`j] = 
             FindRoot[$CellContext`tempo2 == \
$CellContext`prob2[$CellContext`aa2, $CellContext`i, $CellContext`j], \
{$CellContext`aa2, 1}]; 
            Part[$CellContext`F01, $CellContext`i, $CellContext`j] = 
             ReplaceAll[$CellContext`aa2, 
               Part[$CellContext`claux2, $CellContext`j]]]; 
          If[$CellContext`passivo == 0, 
            Print["   O par\[AHat]metro \!\(\*SubscriptBox[\(q\), \(t\)]\) \
tem o valor de:\n   qt=", 
              $CellContext`numdb[
               Part[$CellContext`qt, 1]], "."]; $CellContext`f20 = 
             Part[$CellContext`F20, 1]; $CellContext`f01 = 
             Part[$CellContext`F01, 1]]; 
          If[$CellContext`passivo >= 1, 
            Print["Tro\[CCedilla]o ", $CellContext`i, 
              " da liga\[CCedilla]\[ATilde]o:"]; 
            Print["   O par\[AHat]metro \!\(\*SubscriptBox[\(q\), \(t\)]\) \
tem o valor de:\n   qt=", 
              $CellContext`numdb[
               Part[$CellContext`qt, $CellContext`i]], "."]; 
            Print["   O desvanecimento n\[ATilde]o excedido durante mais de \
20% do tempo no pior m\[EHat]s \[EAcute]:\n   f20=", 
              $CellContext`numdb[
               Part[$CellContext`F20, $CellContext`i]], " dB."]; 
            Print["   O desvanecimento n\[ATilde]o excedido durante mais de \
0.1\!\(\*FractionBox[\(d\), \(2500\)]\)% do tempo no pior m\[EHat]s \
\[EAcute]:\n   f01=", 
              $CellContext`numdb[
               Part[$CellContext`F01, $CellContext`i]], 
              " dB."]; $CellContext`f20 = $CellContext`f20 + 
              Part[$CellContext`F20, $CellContext`i]; $CellContext`f01 = \
$CellContext`f01 + 
              Part[$CellContext`F01, $CellContext`i]]]; $CellContext`divers = \
$CellContext`nao; Print["Liga\[CCedilla]\[ATilde]o total:"]; 
        Print["   O desvanecimento total n\[ATilde]o excedido durante mais de \
20% do tempo no pior m\[EHat]s \[EAcute]:\n   f20=", 
          $CellContext`numdb[$CellContext`f20], " dB."]; 
        Print["   O desvanecimento total n\[ATilde]o excedido durante mais de \
0.1\!\(\*FractionBox[\(d\), \(2500\)]\)% do tempo no pior m\[EHat]s \
\[EAcute]:\n   f01=", 
