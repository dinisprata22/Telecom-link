Cell[TextData[{
 "\t\t\t",
 StyleBox["1.10.2  Atenua\[CCedilla]\[ATilde]o de obst\[AAcute]culo",
  FontColor->RGBColor[1, 1, 0]]
}], "Subsubsection",
