\[CCedilla]\[ATilde]o em condi\[CCedilla]\[OTilde]es ideais de propaga\
\[CCedilla]\[ATilde]o \[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(CIP\)]\)=", \

         $CellContext`numdb[$CellContext`rsr5], " dB."]; 
       For[$CellContext`j = 
          1; $CellContext`ymax = -200, $CellContext`j <= $CellContext`numfreq, 
         Increment[$CellContext`j], 
         If[$CellContext`ymax < 
          Part[$CellContext`ymaxaux, $CellContext`j], $CellContext`ymax = 
          Part[$CellContext`ymaxaux, $CellContext`j]]]; $CellContext`ymin = \
-20; If[$CellContext`ymax < 3, $CellContext`ymax = 10]; 
       If[$CellContext`numfreq =!= 1, 
