 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tCaso n\[ATilde]o queira introduzir um elemento repetidor passivo, coloque 0 \
(zero) no bot\[ATilde]o , repetidor passivo. Este valor entra por omiss\
\[ATilde]o no projecto. Os outros bot\[OTilde]es s\[ATilde]o de imediato \
omitidos.
\tCaso opte por um ou mais repetidores, indique no bot\[ATilde]o , repetidor \
passivo, o n\[UAcute]mero destes. Esta op\[CCedilla]\[ATilde]o faz com que \
tenha de colocar algumas caracter\[IAcute]sticas do repetidor, pedidas nos \
outros bot\[OTilde]es.\
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Repetidor", " ", "passivo", "  "}]}],
     ButtonFunction:>($CellContext`sim1 = 1; If[
        Or[$CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
         1, $CellContext`bota17 =!= 1, $CellContext`bota18 =!= 
         1, $CellContext`bota19 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`passivo = $CellContext`MyInput[
          "Introduza o n\[UAcute]mero de repetidores passivos na liga\
\[CCedilla]\[ATilde]o.\nAo colocar 0 (zero), indica raio directo.", \
$CellContext`passivo]; 
        Print["N\[UAcute]mero de repetidores passivos:  ", \
$CellContext`passivo, " ."]; 
        If[$CellContext`passivo >= 1, 
          Print["O obst\[AAcute]culo principal corresponde ao ponto ", \
$CellContext`obsta1, " dos ", $CellContext`l, " do ficheiro de entrada."]; 
          If[$CellContext`obsta2 =!= 1, 
            Print[
            "O 1\.ba obst\[AAcute]culo secund\[AAcute]rio corresponde ao \
ponto ", $CellContext`obsta2, "."]]; If[$CellContext`obsta3 =!= 1, 
            Print[
            "O 2\.ba obst\[AAcute]culo secund\[AAcute]rio corresponde ao \
ponto ", $CellContext`obsta3, "."]]]; 
        If[$CellContext`passivo == 
          0, $CellContext`grep = 0; $CellContext`repetidor = 
           False]; $CellContext`h11[
           Pattern[$CellContext`ll, 
            Blank[]]] := If[$CellContext`ll == 1, $CellContext`hae, 
           
           Part[$CellContext`hemipassivo, $CellContext`ll - 
            1]]; $CellContext`l11[
           Pattern[$CellContext`ll, 
            Blank[]]] := If[$CellContext`ll == 1, 1, 
           
           Part[$CellContext`pontospassivo, $CellContext`ll - 
            1]]; $CellContext`h22[
           Pattern[$CellContext`ll, 
            Blank[]]] := 
         If[$CellContext`ll == $CellContext`passivo + 1, $CellContext`har, 
           Part[$CellContext`hrecpassivo, $CellContext`ll]]; $CellContext`l22[
          
           Pattern[$CellContext`ll, 
            Blank[]]] := 
         If[$CellContext`ll == $CellContext`passivo + 1, $CellContext`l, 
           Part[$CellContext`pontospassivo, $CellContext`ll]]]),
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Local", " ", "de", " ", "coloca\[CCedilla]\[ATilde]o", "  "}]}],
     ButtonFunction:>($CellContext`sim2 = 1; If[
