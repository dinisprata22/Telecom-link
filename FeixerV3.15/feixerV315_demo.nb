 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tO processo de c\[AAcute]lculo da diversidade tem como base as express\
\[OTilde]es do cap\[IAcute]tulo 3.9 [1].
\tO limite de validade para o factor de melhoria pela utiliza\[CCedilla]\
\[ATilde]o de diversidade \[EAcute] colocado no Feixer a 1 dB. Abaixo deste \
valor n\[ATilde]o h\[AAcute] melhoria pela utiliza\[CCedilla]\[ATilde]o \
desta.
\tOs valores relativos \[AGrave]s caracter\[IAcute]sticas das antenas, s\
\[ATilde]o por omiss\[ATilde]o, iguais \[AGrave] antena de emiss\[ATilde]o.
\t
\tAten\[CCedilla]\[ATilde]o:\tN\[ATilde]o esquecer que s\[ATilde]o precisos \
dois repetidores passivos - se tiver a utilizar algum - para garantir a \
diversidade no espa\[CCedilla]o.\
\>", "Text",
 CellMargins->{{36, 47}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Caracter\[IAcute]sticas", " ", "das", " ", "antenas", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
         1, $CellContext`bota26 =!= 1, $CellContext`bota28 =!= 
         1, $CellContext`bota291 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
         N[$CellContext`botn]], $CellContext`diampri = $CellContext`MyInput[
          "Introduza o di\[AHat]metro da antena principal em [m].\nNo caso de \
fazer um varrimento de frequ\[EHat]ncias, os di\[AHat]metros ter\[ATilde]o o \
formato:\n\n   ex. 3 frequ\[EHat]ncias:  {2, 2.5, 3} m", \
$CellContext`diampri]; $CellContext`\[Eta]pri = $CellContext`MyInput[
          "Introduza o rendimento da antena principal", \
$CellContext`\[Eta]pri]; $CellContext`diamsec = $CellContext`MyInput[
          "Introduza o di\[AHat]metro da antena secund\[AAcute]ria em [m].\n\
No caso de fazer um varrimento de frequ\[EHat]ncias, os di\[AHat]metros ter\
\[ATilde]o o formato:\n\n   ex. 3 frequ\[EHat]ncias:  {2, 2.5, 3} m", \
$CellContext`diamsec]; $CellContext`\[Eta]sec = $CellContext`MyInput[
          "Introduza o rendimento da antena secund\[AAcute]ria.\n\n   Valor \
por omiss\[ATilde]o: 0.5", $CellContext`\[Eta]sec]; $CellContext`afpri = (Pi/
           4) $CellContext`diampri^2; $CellContext`afsec = (Pi/
           4) $CellContext`diamsec^2; $CellContext`aefcpri = \
$CellContext`afpri $CellContext`\[Eta]pri; $CellContext`aefcsec = \
$CellContext`afsec $CellContext`\[Eta]sec; $CellContext`gp = 
         10 Log[10, ((4 
              Pi)/$CellContext`\[Lambda]^2) $CellContext`aefcpri]; \
$CellContext`gpri = 10^($CellContext`gp/10); $CellContext`gs = 
         10 Log[10, ((4 
              Pi)/$CellContext`\[Lambda]^2) $CellContext`aefcsec]; \
$CellContext`gsec = 10^($CellContext`gs/10)],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Diversidade", " ", "no", " ", "espa\[CCedilla]o", "  "}]}],
      ButtonFunction:>($CellContext`divers = $CellContext`sim; If[
         Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
          1, $CellContext`bota26 =!= 1, $CellContext`bota28 =!= 
          1, $CellContext`bota291 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
          N[$CellContext`botn]], $CellContext`bota2101 = 1; $CellContext`botn = 
          102/10; $CellContext`Dc = $CellContext`MyInput[
           "Introduza a dist\[AHat]ncia entre os centros das antenas em [m]", \
$CellContext`Dc]; 
         Print["Dist\[AHat]ncia entre o centro das antenas:  Dc= ", \
$CellContext`Dc, " m."]; 
         Print["  O di\[AHat]metro da antena principal \[EAcute] de ", \
$CellContext`diampri, 
           " m, sendo o seu rendimento de \[Eta]p= ", $CellContext`\[Eta]pri, 
           " ."]; Print[
          "  O di\[AHat]metro da antena secund\[AAcute]ria \[EAcute] de ", \
$CellContext`diamsec, 
           " m, sendo o seu rendimento de \!\(\*SubscriptBox[\(\[Eta]\), \
\(s\)]\)= ", $CellContext`\[Eta]sec, " ."]; 
         Print["Ganho da antena principal:  gp= ", 
           $CellContext`numdb[$CellContext`gp], " dB."]; 
         Print["Ganho da antena secund\[AAcute]ria:  \
\!\(\*SubscriptBox[\(g\), \(s\)]\)= ", 
           $CellContext`numdb[$CellContext`gs], 
           " dB."]; $CellContext`ki = (1 - 
            Exp[(-3.34) 
             10^(-4) $CellContext`Dc^0.87 $CellContext`f^(-0.12) \
$CellContext`dkm^0.48 \
($CellContext`tempo2/$CellContext`ppn[$CellContext`f01])^(-1.04)]) \
($CellContext`gsec/$CellContext`gpri); $CellContext`kta = $CellContext`tempo2 \
(1/$CellContext`ppn[$CellContext`f01]); $CellContext`p0pncd01 = \
(($CellContext`ki/$CellContext`kta) $CellContext`tempo2)^
           Rational[1, 2]; $CellContext`icd = $CellContext`ki (
            1/$CellContext`p0pncd01); $CellContext`icdg = 
          10 Log[10, $CellContext`icd]; 
         For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
           Increment[$CellContext`j], 
           If[
           Part[$CellContext`icdg, $CellContext`j] < 1, 
            Part[$CellContext`icd, $CellContext`j] = 1; 
            Part[$CellContext`icdg, $CellContext`j] = 0]]; 
         Print["   O factor de melhoria da 2\.aa cl\[AAcute]usula, devido \
\[AGrave] utiliza\[CCedilla]\[ATilde]o de diversidade no espa\[CCedilla]o \
\[EAcute]:\n\!\(\*SubscriptBox[\(i\), \(0\)]\)=", 
           $CellContext`numdb[$CellContext`icdg], " dB."]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Diversidade", " ", "na", " ", "frequ\[EHat]ncia", "  "}]}],
      ButtonFunction:>($CellContext`divers = $CellContext`sim; If[
         Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
          1, $CellContext`bota26 =!= 1, $CellContext`bota28 =!= 
          1, $CellContext`bota291 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
          N[$CellContext`botn]], $CellContext`bota2101 = 1; $CellContext`botn = 
          102/10; $CellContext`\[CapitalDelta]f = $CellContext`MyInput[
           "Introduza a separa\[CCedilla]\[ATilde]o entre portadoras em \
[GHz].\nNo caso de fazer um varrimento de frequ\[EHat]ncias, coloque-as com o \
seguinte formato:\n   ex: 3 frequ\[EHat]ncias => {0.2,0.2,0.2} GHz", \
$CellContext`\[CapitalDelta]f]; 
         Print["Separa\[CCedilla]\[ATilde]o entre portadoras:  \
\[CapitalDelta]f= ", $CellContext`\[CapitalDelta]f, " GHz."]; 
         Print["  O di\[AHat]metro da antena principal \[EAcute] de ", \
$CellContext`diampri, 
           " m, sendo o seu rendimento de \[Eta]p= ", $CellContext`\[Eta]pri, 
           " ."]; Print[
          "  O di\[AHat]metro da antena secund\[AAcute]ria \[EAcute] de ", \
$CellContext`diamsec, 
           " m, sendo o seu rendimento de \!\(\*SubscriptBox[\(\[Eta]\), \
\(s\)]\)= ", $CellContext`\[Eta]sec, " ."]; 
         Print["Ganho da antena principal:  gp= ", 
           $CellContext`numdb[$CellContext`gp], " dB."]; 
         Print[
          "Ganho da antena secund\[AAcute]ria:  \!\(\*SubscriptBox[\(g\), \(s\
\)]\)= ", 
           $CellContext`numdb[$CellContext`gs], " dB."]; 
         For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
           Increment[$CellContext`j], $CellContext`divf = If[
              And[
              Part[$CellContext`gsec, $CellContext`j]/
                Part[$CellContext`gpri, $CellContext`j] <= 0.25, 
               Part[$CellContext`gsec, $CellContext`j]/
                Part[$CellContext`gpri, $CellContext`j] > 
               1], $CellContext`nao, $CellContext`sim]; $CellContext`divf = 
            If[Part[$CellContext`\[CapitalDelta]f, $CellContext`j]/
               Part[$CellContext`f, $CellContext`j] >= 
              0.05, $CellContext`nao, $CellContext`sim]]; 
         If[$CellContext`divf == $CellContext`sim, $CellContext`ki = (
              80.5/($CellContext`f $CellContext`dkm)) ($CellContext`\
\[CapitalDelta]f/$CellContext`f) ($CellContext`gsec/$CellContext`gpri); \
$CellContext`kta = $CellContext`tempo2 (
              1/$CellContext`ppn[$CellContext`f01]); $CellContext`p0pncd01 = \
(($CellContext`ki/$CellContext`kta) $CellContext`tempo2)^
             Rational[1, 2]; $CellContext`icd = $CellContext`ki (
              1/$CellContext`p0pncd01); $CellContext`icdg = 
            10 Log[10, $CellContext`icd]; 
           For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
             Increment[$CellContext`j], 
             If[
             Part[$CellContext`icdg, $CellContext`j] < 1, 
              Part[$CellContext`icd, $CellContext`j] = 1; 
              Part[$CellContext`icdg, $CellContext`j] = 0]]; 
           Print["   O factor de melhoria da 2\.aa cl\[AAcute]usula, devido \
\[AGrave] utiliza\[CCedilla]\[ATilde]o de diversidade na frequ\[EHat]ncia \
\[EAcute]:\n\!\(\*SubscriptBox[\(i\), \(0\)]\)=", 
             $CellContext`numdb[$CellContext`icdg], " dB."]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
