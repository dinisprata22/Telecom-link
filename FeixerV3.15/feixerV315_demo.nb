 Background->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
        RowBox[{"C", "/", "N"}], " ", "necess\[AAcute]ria", " ", "para", " ", 
        "cumprir", " ", "as", " ", "recomenda\[CCedilla]\[OTilde]es", " ", 
        RowBox[{"(", 
         RowBox[{"c", "/", " ", "diversidade"}], ")"}]}]}],
      ButtonFunction:>($CellContext`rsr1div = $CellContext`CNforSESRdiv[]; \
$CellContext`rsr2div = $CellContext`CNforBBERdiv; $CellContext`rsr3div = \
$CellContext`CNforESRdiv; $CellContext`rsr4div = $CellContext`INDchuva; \
$CellContext`rsr5div = $CellContext`cn; $CellContext`rsr6div = 
        Table[0., {$CellContext`x, $CellContext`numfreq}]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula SESR \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(SESR\)]\)=", 
         $CellContext`numdb[$CellContext`rsr1div], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula BBER \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(BBER\)]\)=", 
         $CellContext`numdb[$CellContext`rsr2div], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula ESR \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(ESR\)]\)=", 
         $CellContext`numdb[$CellContext`rsr3div], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para as cl\[AAcute]usulas da chuva \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(chuva\)]\)=", 
         $CellContext`numdb[$CellContext`rsr6div], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula \
indisponibilidade \[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(IND\)]\)=", 
         $CellContext`numdb[$CellContext`rsr4div], 
         " dB."]; $CellContext`margemat1 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr1div, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat2 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr2div, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat3 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr3div, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat4 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr4div, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat5 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr5div, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat6 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr6div, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`grafmargat1 = 
        ListPlot[$CellContext`margemat1, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[1, 0, 1]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat2 = 
        ListPlot[$CellContext`margemat2, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[1, 0, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat3 = 
        ListPlot[$CellContext`margemat3, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 0, 1]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat4 = 
        ListPlot[$CellContext`margemat4, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 1, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat5 = 
        ListPlot[$CellContext`margemat5, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 0, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat6 = 
        ListPlot[$CellContext`margemat6, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 1, 1]}, DisplayFunction -> 
          Identity]; $CellContext`mcriticaux = Table[
          Max[
           Part[$CellContext`rsr1div, $CellContext`j], 
           
           Part[$CellContext`rsr2div, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcriticaux2 = Table[
          Max[
           Part[$CellContext`mcriticaux, $CellContext`j], 
           
           Part[$CellContext`rsr3div, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcriticaux3 = Table[
          Max[
           Part[$CellContext`mcriticaux2, $CellContext`j], 
           
           Part[$CellContext`rsr4div, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`rsrcriticadiv = $CellContext`rsr5div - \
$CellContext`mcriticaux3; 
       For[$CellContext`i = 
          1; $CellContext`rsroptimadiv = -200, $CellContext`i <= \
$CellContext`numfreq, 
         Increment[$CellContext`i], 
         If[$CellContext`rsroptimadiv < 
          Part[$CellContext`rsrcriticadiv, $CellContext`i], \
$CellContext`foptimadiv = 
           Part[$CellContext`f, $CellContext`i]; $CellContext`rsroptimadiv = 
           Part[$CellContext`rsrcriticadiv, $CellContext`i]]]; \
$CellContext`ymaxauxdiv = $CellContext`mcriticaux3; 
       Print["\nA rela\[CCedilla]\[ATilde]o Sinal-Ru\[IAcute]do \
m\[IAcute]nima necess\[AAcute]ria para cumprir todas as cl\[AAcute]usulas \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), SubscriptBox[\(NEC\), \(min\)]]\)=", 
         $CellContext`numdb[$CellContext`ymaxauxdiv], " dB."]; 
       Print["\nA rela\[CCedilla]\[ATilde]o Sinal-Ru\[IAcute]do da liga\
\[CCedilla]\[ATilde]o em condi\[CCedilla]\[OTilde]es ideais de propaga\
\[CCedilla]\[ATilde]o \[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(CIP\)]\)=", \

         $CellContext`numdb[$CellContext`rsr5div], " dB."]; 
       For[$CellContext`j = 
          1; $CellContext`ymaxdiv = -200, $CellContext`j <= \
$CellContext`numfreq, 
         Increment[$CellContext`j], 
         If[$CellContext`ymaxdiv < 
          Part[$CellContext`ymaxauxdiv, $CellContext`j], $CellContext`ymaxdiv = 
          Part[$CellContext`ymaxauxdiv, $CellContext`j]]]; \
$CellContext`ymindiv = -20; If[$CellContext`numfreq =!= 1, 
         Print[
          
          Show[$CellContext`grafmargat1, $CellContext`grafmargat2, \
$CellContext`grafmargat3, $CellContext`grafmargat4, $CellContext`grafmargat5, \
$CellContext`grafmargat6, 
           Graphics[
            Text[
             Style[
             "(C/N)nec da cl\[AAcute]usula SESR", FontSize -> 11, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[1, 0, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymindiv + 4}]], 
           Graphics[
            Text[
             Style[
             "(C/N)nec da cl\[AAcute]usula BBER", FontSize -> 11, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[1, 0, 0]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymindiv + 1}]], 
           Graphics[
            Text[
             Style[
             "(C/N)nec da cl\[AAcute]usula ESR", FontSize -> 11, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[0, 0, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymindiv - 2}]], 
           Graphics[
            Text[
             Style[
             "(C/N)nec da cl\[AAcute]usula indisponibilidade", FontSize -> 11,
               FontWeight -> Bold, FontColor -> 
              RGBColor[0, 1, 0]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymindiv - 5}]], 
           Graphics[
            Text[
             Style[
             "(C/N)nec das cl\[AAcute]usulas SESR,BBER e ESR devido \[AGrave] \
chuva", FontSize -> 11, FontWeight -> Bold, FontColor -> 
              RGBColor[0, 1, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymindiv - 8}]], 
           Graphics[
            Text[
             Style[
             "C/N da liga\[CCedilla]\[ATilde]o ", FontSize -> 11, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[0, 0, 0]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymindiv + 7}]], 
           PlotRange -> {{
              Part[$CellContext`f, 1], 
              
              Part[$CellContext`f, $CellContext`numfreq]}, \
{$CellContext`ymindiv - 10, $CellContext`ymaxdiv + 10}}, Frame -> True, 
           ImageSize -> {700, 500}, PlotLabel -> 
           Style[$CellContext`nomlig, FontSize -> 11], FrameLabel -> {
             Style["Frequ\[EHat]ncia [GHz]", FontSize -> 11], 
             Style[
             "C/N necess\[AAcute]rios para a liga\[CCedilla]\[ATilde]o [dB]", 
              FontSize -> 11]}, DisplayFunction -> $DisplayFunction]]]; 
       Print["A margem de seguran\[CCedilla]a da liga\[CCedilla]\[ATilde]o \
((C/N\!\(\*SubscriptBox[\()\), \(CIP\)]\)-(C/N\!\(\*SubscriptBox[\()\), \
\(NECmin\)]\)) \[EAcute]:\n", 
         $CellContext`numdb[$CellContext`rsrcriticadiv], " dB."]; 
       Print["A frequ\[EHat]ncia \[OAcute]ptima \[EAcute] f=", 
         $CellContext`numhz[$CellContext`foptimadiv], 
         " GHz (\!\(\*SubscriptBox[\(M\), \(seg\)]\)=", 
         $CellContext`numdb[$CellContext`rsroptimadiv], " dB)."]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
