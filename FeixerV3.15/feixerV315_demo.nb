     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Intensidade", " ", "de", " ", "precipita\[CCedilla]\[ATilde]o", 
        "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota13 =!= 1, $CellContext`bota14 =!= 
