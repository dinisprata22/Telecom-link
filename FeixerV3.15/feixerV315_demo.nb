 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tNo projecto da liga\[CCedilla]\[ATilde]o podemos optar por tr\[EHat]s \
maneiras de calcular a atenua\[CCedilla]\[ATilde]o de obst\[AAcute]culo:\n\n\t\
\t",
 StyleBox["1.",
  FontWeight->"Bold"],
 " Segundo a Norma 526-7 da ITU-R;\n\t\n\t\t",
 StyleBox["2.",
  FontWeight->"Bold"],
 " Atenua\[CCedilla]\[ATilde]o calculada segundo o m\[EAcute]todo do Obst\
\[AAcute]culo em L\[AHat]mina;\n\t\n\t\t",
 StyleBox["3.",
  FontWeight->"Bold"],
 " Atenua\[CCedilla]\[ATilde]o calculada segundo o m\[EAcute]todo de \
Deygout;"
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"M\[EAcute]todo", " ", "1", "  "}]}],
     ButtonFunction:>If[
       Or[$CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
        1, $CellContext`bota17 =!= 1, $CellContext`bota18 =!= 
        1, $CellContext`bota19 =!= 1, $CellContext`bota1101 =!= 1], 
       Print[
       "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
        N[$CellContext`botn]], $CellContext`bota1102 = 1; $CellContext`botn = 
        11; If[$CellContext`repetidor, 
         For[$CellContext`jj = 1, $CellContext`jj <= $CellContext`passivo + 1, 
           
           Increment[$CellContext`jj], $CellContext`h1 = 
            Part[$CellContext`h, 
               $CellContext`l11[$CellContext`jj]] + \
$CellContext`h11[$CellContext`jj]; $CellContext`h2 = Part[$CellContext`h, 
               $CellContext`l22[$CellContext`jj]] + \
$CellContext`h22[$CellContext`jj]; 
           Part[$CellContext`aobst2, $CellContext`jj] = $CellContext`aten526[
              $CellContext`l11[$CellContext`jj], 
              $CellContext`l22[$CellContext`jj]]]; $CellContext`aobst = 
          Table[0., {$CellContext`i, $CellContext`numfreq}]; 
         For[$CellContext`i = 1, $CellContext`i <= $CellContext`passivo + 1, 
           Increment[$CellContext`i], 
           For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
             Increment[$CellContext`j], 
             Part[$CellContext`aobst, $CellContext`j] = 
             Part[$CellContext`aobst, $CellContext`j] + 
              Part[$CellContext`aobst2, $CellContext`i, $CellContext`j]]; 
           Print["No tro\[CCedilla]o ", $CellContext`i, 
             ", a atenua\[CCedilla]\[ATilde]o devida \[AGrave] presen\
\[CCedilla]a de obst\[AAcute]culos \[EAcute]:\nAobst=", 
             $CellContext`numdb[
              Part[$CellContext`aobst2, $CellContext`i]], " dB."]]; 
         Print["No percurso completo, a atenua\[CCedilla]\[ATilde]o total \
devida \[AGrave] presen\[CCedilla]a de obst\[AAcute]culos \[EAcute]:\nAobst=", 
           $CellContext`numdb[$CellContext`aobst], 
           " dB."]; $CellContext`Aobst = $CellContext`aobst]],
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"M\[EAcute]todo", " ", "2", "  "}]}],
     ButtonFunction:>If[
