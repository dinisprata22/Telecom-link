Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.8  Atenua\[CCedilla]\[ATilde]o provocada por \
hidrometeoritos",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tOs valores de \[Kappa] e \[Alpha]  (fun\[CCedilla]\[OTilde]es da frequ\
\[EHat]ncia, da temperatura, da forma e distribui\[CCedilla]\[ATilde]o estat\
\[IAcute]stica da dimens\[ATilde]o das gotas de \[AAcute]gua), para as \
polariza\[CCedilla]\[OTilde]es horizontal e vertical, est\[ATilde]o descritas \
pela recomenda\[CCedilla]\[ATilde]o P.838-1 da ITU-R.\n\tA distribui\
\[CCedilla]\[ATilde]o acumulada da intensidade da precipita\[CCedilla]\
\[ATilde]o ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]]],
 " (mm/h) nas zonas H e K (a do continente Europeu) observa-se da seguinte \
tabela (esta faz parte da recomenda\[CCedilla]\[ATilde]o P.837-1 da ITU-R).\n\
\n\t\t\t\t",
 Cell[BoxData[
  StyleBox[GridBox[{
     {
      RowBox[{
       RowBox[{"Intensidade", " ", "de"}], "\n", "  ", 
       "precipita\[CCedilla]\[ATilde]o", "\n", "\t\t\t", 
       RowBox[{"(", 
        RowBox[{"mm", "/", "h"}], ")"}], "\n", "\t      ", 
       RowBox[{"Zona", " ", "H"}]}], 
      RowBox[{
       RowBox[{"Intensidade", " ", "de"}], "\n", "  ", 
       "precipita\[CCedilla]\[ATilde]o", "\n", "\t\t\t", 
       RowBox[{"(", 
        RowBox[{"mm", "/", "h"}], ")"}], "\n", "\t      ", 
       RowBox[{"Zona", " ", "K"}]}], 
      RowBox[{"  ", 
       RowBox[{
        RowBox[{
         RowBox[{"Percentagem", " ", "de", " ", "tempo"}], ",", "\n", "   ", 
         RowBox[{"no", " ", "ano"}], ",", 
         RowBox[{"em", " ", "que", " ", "o", " ", "valor"}]}], "\n", "      ", 
        RowBox[{"da", " ", "intensidade", " ", "de"}], "\n", 
        RowBox[{
        "precipita\[CCedilla]\[ATilde]o", " ", "\[EAcute]", " ", 
         "excedido"}]}]}]},
     {"2", "1.5", "1"},
     {"4", "4.2", "0.3"},
     {"10", "12", "0.1"},
     {"18", "23", "0.03"},
     {"32", 
      StyleBox["42",
       FontWeight->"Bold",
       FontColor->GrayLevel[0],
       Background->None], 
      StyleBox["0.01",
       FontWeight->"Bold",
       FontColor->GrayLevel[0],
       Background->None]},
     {"55", "70", "0.003"},
     {
      RowBox[{Cell[""], "83"}], "100", "0.001"}
    },
    GridBoxDividers->{
     "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
      "RowsIndexed" -> {}}],
   FontFamily->"Verdana"]]],
 "\n\t\t\t\t"
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
