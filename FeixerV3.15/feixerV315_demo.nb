    "0.149896229`", ",", "0.0749481145`", ",", "0.04996540966666667`", ",", 
     "0.03747405725`", ",", "0.0299792458`", ",", "0.024982704833333334`", 
     ",", "0.021413747`"}], "}"}], "\[InvisibleSpace]", "\<\" m.\"\>"}],
