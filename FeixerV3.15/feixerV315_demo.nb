Cell[CellGroupData[{

Cell["\<\
\t\t\t2.9.2.  Dimens\[OTilde]es do repetidor passivo\
\>", "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tO di\[AHat]metro das antenas emissora e receptora, segundo os \
fabricantes, pode ser:\t0.6, 1, 1.5, 2, 3 e 4 metros,\n\n\t\t\t\t\t\t\t\t\t\t\
\t\t2, 4, 6, 8, 10, 12 e 15 p\[EAcute]s (1 p\[EAcute] = 0.3048 m).\n\n\tUm \
repetidor passivo tipo espelho plano pode ter dimens\[OTilde]es at\[EAcute] \
35 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["m", "2"], TraditionalForm]]],
 " (\[EAcute] pouco razo\[AAcute]vel subir esta \[AAcute]rea devido \[AGrave] \
complexidade da montagem e aos custos inerentes).\n\t\n\tAten\[CCedilla]\
\[ATilde]o:\tN\[ATilde]o se esque\[CCedilla]a que a solu\[CCedilla]\[ATilde]o \
optimizada de uma liga\[CCedilla]\[ATilde]o, quanto ao di\[AHat]metro das \
antenas, sejam elas terminais ou repetidoras,\n\t\t       \[EAcute] realmente \
\[OAcute]tima quando todas elas t\[EHat]m o mesmo di\[AHat]metro."
}], "Text",
 CellMargins->{{36, 47}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Redimensionamento", " ", "das", " ", "antenas", " ", "terminais", 
        "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
         1, $CellContext`bota23 =!= 1, $CellContext`bota26 =!= 
         1, $CellContext`bota28 =!= 1, $CellContext`bota291 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
         N[$CellContext`botn]], 
        If[$CellContext`passivo == 0, 
         Print[
         "Aten\[CCedilla]\[ATilde]o -> O percurso n\[ATilde]o tem \
repetidor!"], $CellContext`diametroe = $CellContext`MyInput[
           "Introduza o di\[AHat]metro optimizado da antena emissora em [m]", \
$CellContext`diametroe]; $CellContext`diametror = $CellContext`MyInput[
           "Introduza o di\[AHat]metro optimizado da antena receptora em \
[m]", $CellContext`diametror]]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"   ", 
       RowBox[{
       "\[CapitalAAcute]rea", " ", "efectiva", " ", "do", " ", "repetidor", 
        "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
         1, $CellContext`bota23 =!= 1, $CellContext`bota26 =!= 
         1, $CellContext`bota28 =!= 1, $CellContext`bota291 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
         N[$CellContext`botn]], If[$CellContext`passivo == 0, 
          Print[
          "Aten\[CCedilla]\[ATilde]o -> O percurso n\[ATilde]o tem \
repetidor!"], 
          If[$CellContext`margem3 == 
            0, $CellContext`margem3 = $CellContext`MyInput[
             "Introduza a margem de seguran\[CCedilla]a desejada [dB]", \
$CellContext`margem3]]; 
          Print["Di\[AHat]metro optimizado da antena emissora: ", 
            $CellContext`numdb[$CellContext`diametroe], " m."]; 
          Print["Di\[AHat]metro optimizado da antena receptora: ", 
            $CellContext`numdb[$CellContext`diametror], 
            " m."]; $CellContext`arearep = Table[0., {$CellContext`i, 
              Length[$CellContext`areapassivo]}]; 
          For[$CellContext`i = 1, $CellContext`i <= $CellContext`passivo, 
            Increment[$CellContext`i], 
            Part[$CellContext`arearep, $CellContext`i] = 
             10^(($CellContext`margem3 - $CellContext`mcritica)/20) (
               Part[$CellContext`areapassivo, $CellContext`i] \
$CellContext`diame $CellContext`diamr/($CellContext`diametroe \
$CellContext`diametror)); 
            For[$CellContext`j = 1, $CellContext`j < $CellContext`numfreq + 1, 
              Increment[$CellContext`j], Print["Para f= ", 
                Part[$CellContext`f, $CellContext`j], 
                ", a \[AAcute]rea efectiva do repetidor passivo ter\[AAcute] \
de ser de ", 
                $CellContext`numdb[
                 Part[$CellContext`arearep, $CellContext`i, $CellContext`j]], 
                " \!\(\*SuperscriptBox[\(m\), \(2\)]\) para cumprir a margem \
de seguran\[CCedilla]a desejada de ", $CellContext`margem3, " dB."]; 
              If[Part[$CellContext`arearep, $CellContext`i, $CellContext`j] >= 
                35, 
                Print[
                "(Aten\[CCedilla]\[ATilde]o que a \[AAcute]rea fisica n\
\[ATilde]o deve exceder os 35 \!\(\*SuperscriptBox[\(m\), \(2\)]\).)"]]]]] 
        Print["\nAEN\[CapitalCCedilla]\[CapitalATilde]O: Caso deseje alterar \
as as caracter\[IAcute]sticas das antenas terminais e do repetidor, dever\
\[AAcute] voltar \[AGrave]s sec\[CCedilla]\[OTilde]es 1.4 e 1.10.\n"]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.5152360079375*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}]
}, Open  ]]
}, Open  ]],

