$CellContext`acent + $CellContext`pondt; 
          Print["   A rela\[CCedilla]\[ATilde]o sinal/ru\[IAcute]do \[AGrave] \
sa\[IAcute]da do desmodulador \[EAcute]:\n(\!\(\*FractionBox[\(S\), \
\(N\)]\)\!\(\*SubscriptBox[\()\), \(bf\)]\)=", 
            $CellContext`numdb[$CellContext`SNbf], " dB."]]; 
        If[$CellContext`analog == $CellContext`video, 
          Print["A pondera\[CCedilla]\[ATilde]o introduzida:", 
            $CellContext`numdb[$CellContext`pondv], " dB."]; 
          Print["A acentua\[CCedilla]\[ATilde]o introduzida:", 
            $CellContext`numdb[$CellContext`acentv], " dB."]; $CellContext`pp = 
           3; $CellContext`SNbf = $CellContext`cn + 1.76 + 
