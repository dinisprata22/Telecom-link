sa\[IAcute]da do desmodulador \[EAcute]:\n(\!\(\*FractionBox[\(S\), \
\(N\)]\)\!\(\*SubscriptBox[\()\), \(TV\)]\)=", 
            $CellContext`numdb[$CellContext`SNbf], " dB."]]],
