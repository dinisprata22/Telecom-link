Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.9  Atenua\[CCedilla]\[ATilde]o dos guias",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tOs guias de sec\[CCedilla]\[ATilde]o el\[IAcute]ptica (os mais utilizados) \
correspondem aos da figura 7.6, cap\[IAcute]tulo 7.7 de [1].
\tO valor do comprimento do guia \[EAcute] dado pela soma da altura dos \
mastros emissor/receptor e das folgas necess\[AAcute]rias para que este \
chegue \[AGrave]s antenas e/ou cabine do equipamento. Na folga, \[EAcute] \
usual colocar 10 metros em ambos os mastros.
\tEsta sec\[CCedilla]\[ATilde]o apenas designa guias para frequ\[EHat]ncia \
inferiores a 27 GHz.
\t \
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Folga", " ", "dos", " ", "guias", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota14 =!= 1, $CellContext`bota15 =!= 
         1, $CellContext`bota16 =!= 1, $CellContext`bota17 =!= 
         1, $CellContext`bota18 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`folga = $CellContext`MyInput[
         "Introduza a folga dada aos guias para instala\[CCedilla]\[ATilde]o \
no mastro", $CellContext`folga]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Atenua\[CCedilla]\[ATilde]o", " ", "dos", " ", "guias", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota14 =!= 1, $CellContext`bota15 =!= 
         1, $CellContext`bota16 =!= 1, $CellContext`bota17 =!= 
         1, $CellContext`bota18 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`bota19 = 1; $CellContext`botn = 
         101/10; Print[
         "Folga dada:  ", $CellContext`folga, " m."]; $CellContext`ewl = 
         Table[0., {$CellContext`i, 14}]; $CellContext`ewint = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; \
$CellContext`guias = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`ag = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`i = 
         1; For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
          Increment[$CellContext`j], 
          While[Part[$CellContext`gui, $CellContext`i, 14] < 
            Part[$CellContext`f, $CellContext`j], 
            Increment[$CellContext`i]]; 
          Part[$CellContext`guias, $CellContext`j] = {
             Part[$CellContext`gui, $CellContext`i, 1], $CellContext`i}; 
          Print["O guia el\[IAcute]ptico utilizado \[AGrave] frequ\[EHat]ncia \
de ", 
            Part[$CellContext`f, $CellContext`j], 
            " GHz tem a designa\[CCedilla]\[ATilde]o EW", 
            Part[$CellContext`guias, $CellContext`j, 1], "."]]; 
        For[$CellContext`i = 1, $CellContext`i <= $CellContext`numfreq, 
          Increment[$CellContext`i], $CellContext`j = 1; 
          While[($CellContext`j = $CellContext`j + 1) <= 15, 
            Part[$CellContext`ewl, $CellContext`j - 1] = 
            Part[$CellContext`gui, 
              
              Part[$CellContext`guias, $CellContext`i, 
               2], $CellContext`j]]; $CellContext`ew = 
           Partition[$CellContext`ewl, 2]; $CellContext`ewint = 
           Interpolation[$CellContext`ew]; 
          Part[$CellContext`ag, $CellContext`i] = $CellContext`ewint[
             
             Part[$CellContext`f, $CellContext`i]]]; $CellContext`Age = \
($CellContext`ag/
           100) ($CellContext`hae + $CellContext`folga); $CellContext`Agr = \
($CellContext`ag/100) ($CellContext`har + $CellContext`folga); 
        Print["O guia de emiss\[ATilde]o tem uma atenua\[CCedilla]\[ATilde]o \
de:\nAge=", 
          $CellContext`numdb[$CellContext`Age], " dB."]; 
        Print["O guia de recep\[CCedilla]\[ATilde]o tem uma atenua\[CCedilla]\
\[ATilde]o de:\nAgr=", 
          $CellContext`numdb[$CellContext`Agr], " dB."]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Gr\[AAcute]fico", " ", "dos", " ", "guias", "  "}]}],
      ButtonFunction:>(
       Print["Gr\[AAcute]fico n\[ATilde]o dispon\[IAcute]vel. Consultar sec\
\[CCedilla]\[ATilde]o 7.7 de [1]."]; Null),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236006546875*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

