        "cumprir", " ", "as", " ", "recomenda\[CCedilla]\[OTilde]es", "  "}]}],
      ButtonFunction:>($CellContext`rsrimp = 
        0; $CellContext`rsr1 = $CellContext`CNforSESR[]; $CellContext`rsr2 = \
$CellContext`CNforBBER; $CellContext`rsr3 = $CellContext`CNforESR; \
$CellContext`rsr4 = $CellContext`INDchuva; $CellContext`rsr5 = \
$CellContext`cn; $CellContext`rsr6 = 
        Table[0., {$CellContext`x, $CellContext`numfreq}]; \
$CellContext`margemat1 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr1, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat2 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr2, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat3 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr3, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat4 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr4, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat5 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr5, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat6 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr6, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`rsr1x = $CellContext`rsr1; \
$CellContext`rsr2x = $CellContext`rsr2; $CellContext`rsr3x = \
$CellContext`rsr3; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         If[
          Part[$CellContext`rsr1, $CellContext`i] == Null, 
           Part[$CellContext`rsr1x, $CellContext`i] = "*"; 
           Part[$CellContext`rsr1, $CellContext`i] = Infinity]; 
         If[Part[$CellContext`rsr2, $CellContext`i] == Null, 
           Part[$CellContext`rsr2x, $CellContext`i] = "*"; 
           Part[$CellContext`rsr2, $CellContext`i] = Infinity]; 
         If[Part[$CellContext`rsr3, $CellContext`i] == Null, 
           Part[$CellContext`rsr3x, $CellContext`i] = "*"; 
           Part[$CellContext`rsr3, $CellContext`i] = Infinity]]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula SESR \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(SESR\)]\)=", 
         $CellContext`numdb[$CellContext`rsr1x], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula BBER \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(BBER\)]\)=", 
         $CellContext`numdb[$CellContext`rsr2x], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula ESR \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(ESR\)]\)=", 
         $CellContext`numdb[$CellContext`rsr3x], " dB."]; 
