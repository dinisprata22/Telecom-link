Cell[CellGroupData[{

Cell[TextData[StyleBox["\t3.10  Margens cr\[IAcute]ticas ",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["\t\t\t3.10.1  Cl\[AAcute]usula SESR",
 FontColor->RGBColor[1, 1, 0]]], "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{" ", "SESR", " "}],
      ButtonFunction:>($CellContext`sesrcn[
           Pattern[$CellContext`cn, 
            Blank[]]] := 
         Module[{$CellContext`muSESR, $CellContext`mrSESR, \
$CellContext`sesr}, $CellContext`MuSESR = $CellContext`cn - \
$CellContext`CNberSESR; $CellContext`muSESR = 
            10^($CellContext`MuSESR/10); $CellContext`mrSESR = 
            1/(1/$CellContext`muSESR + 
             1/$CellContext`Ms); $CellContext`sesr = \
$CellContext`kt[]/$CellContext`mrSESR]; 
        Null) ($CellContext`CNforSESR[] := 
         Module[{$CellContext`mrminSESR, $CellContext`muminSESR, \
$CellContext`MuminSESR, $CellContext`calcCNforSESR, \
$CellContext`CNCIPminSESR}, $CellContext`mrminSESR = \
$CellContext`kt[]/$CellContext`SESR; $CellContext`muminSESR = 
            1/(1/$CellContext`mrminSESR - 
             1/$CellContext`Ms); $CellContext`MuminSESR = 
            Table[0, {$CellContext`a, $CellContext`numfreq}]; \
$CellContext`calcCNforSESR = Table[0, {$CellContext`a, $CellContext`numfreq}]; 
           For[$CellContext`i = 0, $CellContext`i < $CellContext`numfreq + 1, 
             
             Increment[$CellContext`i], 
             If[
             Part[$CellContext`muminSESR, $CellContext`i] < 0, 
              Part[$CellContext`calcCNforSESR, $CellContext`i] = Null, 
              Part[$CellContext`MuminSESR, $CellContext`i] = 10 Log[10, 
                  Part[$CellContext`muminSESR, $CellContext`i]]; 
              Part[$CellContext`calcCNforSESR, $CellContext`i] = 
               Part[$CellContext`CNberSESR, $CellContext`i] + 
                Part[$CellContext`MuminSESR, $CellContext`i]]]; \
$CellContext`CNCIPminSESR = $CellContext`calcCNforSESR]; 
        Null) ($CellContext`sesr = $CellContext`sesrcn[$CellContext`cn]; 
        Null) (Print["Valor da norma SESR = ", $CellContext`SESR]; Null) (
        For[$CellContext`i = 0, $CellContext`i < $CellContext`numfreq + 1, 
          Increment[$CellContext`i], 
          If[Part[$CellContext`sesr, $CellContext`i] <= $CellContext`SESR, 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula cumprida, sesr=", 
            Part[$CellContext`sesr, $CellContext`i]], 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula n\[ATilde]o cumprida, sesr=", 
            Part[$CellContext`sesr, $CellContext`i]]]]; Null) 
       Print["A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do necess\
\[AAcute]ria para cumprir a cl\[AAcute]usula SESR \[EAcute] \
(\!\(\*FractionBox[\(C\), \(N\)]\)\!\(\*SubscriptBox[\()\), \(CIP_SESR\)]\)=", 
         $CellContext`numdb[
          $CellContext`CNforSESR[]], " dB."],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.51523600875*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

