Cell[BoxData["\<\"\\nAEN\[CapitalCCedilla]\[CapitalATilde]O: Caso deseje \
alterar as as caracter\[IAcute]sticas das antenas terminais e do repetidor, \
dever\[AAcute] voltar \[AGrave]s sec\[CCedilla]\[OTilde]es 1.4 e \
1.10.\\n\"\>"], "Print",
 CellChangeTimes->{3.515237203140625*^9}]
}, Open  ]]
}, Open  ]]
}, Open  ]],

