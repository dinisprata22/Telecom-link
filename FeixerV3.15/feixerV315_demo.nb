Cell[CellGroupData[{

Cell[TextData[StyleBox["\t2.3  Rela\[CCedilla]\[ATilde]o \
portadora/ru\[IAcute]do em r\[AAcute]diofrequ\[EHat]ncia (condi\[CCedilla]\
\[OTilde]es ideais de propaga\[CCedilla]\[ATilde]o)",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tA temperatura vista pelas antenas \[EAcute] de 293 K.\
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Factor", " ", "de", " ", "ru\[IAcute]do", "  "}]}],
     ButtonFunction:>($CellContext`uotri = $CellContext`sim; If[
        Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
         N[$CellContext`botn]], $CellContext`nfr = $CellContext`MyInput[
          "Introduza, para cada frequ\[EHat]ncia, o factor de ru\[IAcute]do, \
em dB.\nIndique os valores ENTRE CHAVETAS.\nExemplo: {7.2,7.4,7.6,7.8,8.}\n\n\
Alternativamente, introduza a express\[ATilde]o do factor de ru\[IAcute]do em \
dB.\nA vari\[AAcute]vel  f  indica a frequ\[EHat]ncia.\nExemplo:  7.0+0.1*f", \
$CellContext`nfr]; 
        Print["O factor de ru\[IAcute]do da liga\[CCedilla]\[ATilde]o \
\[EAcute]:\n\!\(\*SubscriptBox[\(n\), \(f\)]\)=", 
          $CellContext`numdb[$CellContext`nfr], " dB."]]),
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Rela\[CCedilla]\[ATilde]o", " ", 
       RowBox[{"portadora", "/", "ru\[IAcute]do"}], " ", "em", " ", "RF", 
       "  "}]}],
     ButtonFunction:>If[
       Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 1], 
       Print[
       "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
        N[$CellContext`botn]], $CellContext`bota23 = 1; $CellContext`botn = 4; 
       If[$CellContext`uotri == $CellContext`sim, 
         Print["Temperatura observada pela antena:  T= 293 K."]; \
$CellContext`n0[
            Pattern[$CellContext`banrf, 
             Blank[]]] := 
          10 Log[10, 1.380658 10^(-23) 293 $CellContext`banrf 
             10^6]; $CellContext`N0 = $CellContext`n0[$CellContext`brf]; 
         Print["O ru\[IAcute]do t\[EAcute]rmico \[EAcute] N0=", 
           $CellContext`numdb[$CellContext`N0], 
           " dBW."]; $CellContext`nruido = $CellContext`N0 + $CellContext`nfr; 
         Print["   O ru\[IAcute]do aos terminais do desmodulador \[EAcute]:\n\
nruido=", 
           $CellContext`numdb[$CellContext`nruido], 
           " dBW."]; $CellContext`cn = $CellContext`pr - $CellContext`nruido; 
         Print["   A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do em \
condi\[CCedilla]\[OTilde]es ideais de propaga\[CCedilla]\[ATilde]o \[EAcute]:\
\n(\!\(\*FractionBox[\(C\), \(N\)]\)\!\(\*SubscriptBox[\()\), \(rf\)]\)=", 
           $CellContext`numdb[$CellContext`cn], 
           " dB."]; $CellContext`lts = $CellContext`nruido + 11; 
         Print["   O Limiar te\[OAcute]rico de sensibilidade \[EAcute]:\n\
Lts=", 
           $CellContext`numdb[$CellContext`lts], 
           " dBW."]; $CellContext`ltsaux1 = 
          Table[0., {$CellContext`i, $CellContext`numfreq}]; \
$CellContext`ltsaux2 = 
          Table[0., {$CellContext`i, $CellContext`numfreq}]; \
$CellContext`nmi1 = 0; $CellContext`nmi2 = 0; 
         For[$CellContext`i = 1, $CellContext`i <= $CellContext`numfreq, 
           Increment[$CellContext`i], 
           If[
           Part[$CellContext`cn, $CellContext`i] >= 11, 
            Part[$CellContext`ltsaux1, $CellContext`i] = 
             Part[$CellContext`f, $CellContext`i]; 
            Increment[$CellContext`nmi1], 
            Part[$CellContext`ltsaux2, $CellContext`i] = 
             Part[$CellContext`f, $CellContext`i]; 
            Increment[$CellContext`nmi2]]]; $CellContext`ltsaux3 = 
          Table[0., {$CellContext`i, $CellContext`nmi1}]; \
$CellContext`ltsaux4 = 
          Table[0., {$CellContext`i, $CellContext`nmi2}]; $CellContext`nmi3 = 
          0; $CellContext`nmi4 = 0; 
         For[$CellContext`i = 1, $CellContext`i <= $CellContext`numfreq, 
           Increment[$CellContext`i], 
           If[Part[$CellContext`ltsaux1, $CellContext`i] =!= 0., 
             
             If[$CellContext`nmi3 < $CellContext`nmi1, 
              Increment[$CellContext`nmi3]; 
              Part[$CellContext`ltsaux3, $CellContext`nmi3] = 
               Part[$CellContext`ltsaux1, $CellContext`i]]]; 
           If[Part[$CellContext`ltsaux2, $CellContext`i] =!= 0., 
             
             If[$CellContext`nmi4 < $CellContext`nmi2, 
              Increment[$CellContext`nmi4]; 
              Part[$CellContext`ltsaux4, $CellContext`nmi4] = 
               Part[$CellContext`ltsaux2, $CellContext`i]]]]; 
         If[$CellContext`nmi1 =!= 0, 
           Print[
           "   A liga\[CCedilla]\[ATilde]o est\[AAcute] acima do Lts para \
f=", $CellContext`ltsaux3, " GHz."]]; If[$CellContext`nmi2 =!= 0, 
           Print[
           "   O projecto n\[ATilde]o pode prosseguir para f=", \
$CellContext`ltsaux4, 
            " GHz. A liga\[CCedilla]\[ATilde]o est\[AAcute] abaixo do \
Lts."]]]],
     Evaluator->Automatic]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236007390625*^9},
 FontColor->RGBColor[1, 1, 0],
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}]
}, Open  ]],

