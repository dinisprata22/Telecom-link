    If[$CellContext`divers == $CellContext`sim, $CellContext`m2 = \
$CellContext`m2 + $CellContext`icdg]; 
    Print["   A margem cr\[IAcute]tica para a 1\.aa cl\[AAcute]usula:\nm1=", 
      $CellContext`numdb[$CellContext`m1], " dB."]; 
    If[$CellContext`divers == $CellContext`sim, 
      Print[
      "   A margem cr\[IAcute]tica para a 2\.aa cl\[AAcute]usula contempla \
diversidade."]]; 
    Print["   A margem cr\[IAcute]tica para a 2\.aa cl\[AAcute]usula:\nm2=", 
      $CellContext`numdb[$CellContext`m2], " dB."]; 
    Print["   A margem cr\[IAcute]tica para o corte:\nm3=", 
      $CellContext`numdb[$CellContext`m3], " dB."]; $CellContext`margemat1 = 
     Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m1, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat2 = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m2, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margematch = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m3, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`grafmargat1 = 
     ListPlot[$CellContext`margemat1, Joined -> True, PlotStyle -> 
       RGBColor[1, 0, 1], DisplayFunction -> 
       Identity]; $CellContext`grafmargat2 = 
     ListPlot[$CellContext`margemat2, Joined -> True, PlotStyle -> 
       RGBColor[0, 0, 1], DisplayFunction -> 
       Identity]; $CellContext`grafmargatch = 
     ListPlot[$CellContext`margematch, Joined -> True, PlotStyle -> 
       GrayLevel[0], DisplayFunction -> Identity]; $CellContext`mcriticaux = 
     Table[
       Min[
        Part[$CellContext`m1, $CellContext`j], 
        Part[$CellContext`m2, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcritica = Table[
       Min[
        Part[$CellContext`mcriticaux, $CellContext`j], 
        Part[$CellContext`m3, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; 
    For[$CellContext`i = 
       1; $CellContext`moptima = -200, $CellContext`i <= $CellContext`numfreq, 
      Increment[$CellContext`i], 
      If[$CellContext`moptima < 
       Part[$CellContext`mcritica, $CellContext`i], $CellContext`foptima = 
        Part[$CellContext`f, $CellContext`i]; $CellContext`moptima = 
        Part[$CellContext`mcritica, $CellContext`i]]]; $CellContext`ymaxaux1 = 
     Table[
       Max[
        Part[$CellContext`m1, $CellContext`j], 
        Part[$CellContext`m2, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`ymaxaux2 = Table[
       Max[
        Part[$CellContext`ymaxaux1, $CellContext`j], 
        Part[$CellContext`m3, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; 
    For[$CellContext`j = 
       1; $CellContext`ymax = -200, $CellContext`j <= $CellContext`numfreq, 
      Increment[$CellContext`j], 
      If[$CellContext`ymax < 
       Part[$CellContext`ymaxaux2, $CellContext`j], $CellContext`ymax = 
       Part[$CellContext`ymaxaux2, $CellContext`j]]]; 
    For[$CellContext`j = 1; $CellContext`ymin = 
       100, $CellContext`j <= $CellContext`numfreq, 
      Increment[$CellContext`j], 
      If[$CellContext`ymin > 
       Part[$CellContext`mcritica, $CellContext`j], $CellContext`ymin = 
       Part[$CellContext`mcritica, $CellContext`j]]]; 
    If[$CellContext`ymax < 3, $CellContext`ymax = 10]; 
    If[$CellContext`numfreq =!= 1, 
      Print[
       Show[$CellContext`grafmargat1, $CellContext`grafmargat2, \
$CellContext`grafmargatch, 
        Graphics[{
          Dashing[{0.01, 0.01}], 
          Line[{{
             Part[$CellContext`f, 1], 3}, {
             Part[$CellContext`f, $CellContext`numfreq], 3}}]}], 
        Graphics[
         Text[
          StyleForm[
          "Margem da 1\.aa cl\[AAcute]usula", FontSize -> 11, FontColor -> 
           RGBColor[1, 0, 1]], {
           Part[$CellContext`f, 
            Floor[$CellContext`numfreq/2]], Part[$CellContext`m1, 
             Floor[$CellContext`numfreq/2]] + 2}]], 
        Graphics[
         Text[
          StyleForm[
          "Margem da 2\.aa cl\[AAcute]usula", FontSize -> 11, FontColor -> 
           RGBColor[0, 0, 1]], {
           Part[$CellContext`f, 
            Floor[$CellContext`numfreq/2]], Part[$CellContext`m2, 
             Floor[$CellContext`numfreq/2]] + 2}]], 
        Graphics[
         Text[
          StyleForm[
          "Margem da 3\.aa cl\[AAcute]usula", FontSize -> 11, FontColor -> 
           GrayLevel[0]], {
           Part[$CellContext`f, 
            Floor[$CellContext`numfreq/2]], Part[$CellContext`m3, 
             Floor[$CellContext`numfreq/2]] + 2}]], PlotRange -> {{
           Part[$CellContext`f, 1], 
           Part[$CellContext`f, $CellContext`numfreq]}, {$CellContext`ymin - 
           10, $CellContext`ymax + 10}}, Frame -> True, 
        ImageSize -> {400, 400}, PlotLabel -> 
        StyleForm[$CellContext`nomlig, FontSize -> 11], FrameLabel -> {
          StyleForm["Frequ\[EHat]ncia [GHz]", FontSize -> 11], 
          StyleForm["Margens cr\[IAcute]ticas [dB]", FontSize -> 11]}, 
        DisplayFunction -> $DisplayFunction]]]; $CellContext`m2 = \
$CellContext`marg2; 
    Print["   A margem cr\[IAcute]tica da liga\[CCedilla]\[ATilde]o \
\[EAcute]:\nm=", 
      $CellContext`numdb[$CellContext`mcritica], " dB."]; 
    Print["A frequ\[EHat]ncia \[OAcute]ptima \[EAcute] f=", 
      $CellContext`numhz[$CellContext`foptima], " GHz."]; 
    Print["A margem \[OAcute]ptima da liga\[CCedilla]\[ATilde]o \[EAcute] m=", 
      $CellContext`numdb[$CellContext`moptima], " dB."]],
  Evaluator->Automatic]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236008125*^9},
 FontColor->RGBColor[1, 1, 0],
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
\t\t\t2.10.3.  Dimens\[OTilde]es do repetidor passivo\
\>", "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tO di\[AHat]metro das antenas emissora e receptora, segundo os \
fabricantes, pode ser:\t0.6, 1, 1.5, 2, 3 e 4 metros,\n\n\t\t\t\t\t\t\t\t\t\t\
\t\t2, 4, 6, 8, 10, 12 e 15 p\[EAcute]s (1 p\[EAcute] = 0.3048 m).\n\n\tUm \
repetidor passivo tipo espelho plano pode ter dimens\[OTilde]es at\[EAcute] \
35 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["m", "2"], TraditionalForm]]],
 " (\[EAcute] pouco razo\[AAcute]vel subir esta \[AAcute]rea devido \[AGrave] \
complexidade da montagem e aos custos inerentes).\n\t\n\tAten\[CCedilla]\
\[ATilde]o:\tN\[ATilde]o se esque\[CCedilla]a que a solu\[CCedilla]\[ATilde]o \
optimizada de uma liga\[CCedilla]\[ATilde]o, quanto ao di\[AHat]metro das \
antenas, sejam elas terminais ou repetidoras,\n\t\t       \[EAcute] realmente \
\[OAcute]tima quando todas elas t\[EHat]m o mesmo di\[AHat]metro."
}], "Text",
 CellMargins->{{36, 47}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Redimensionamento", " ", "das", " ", "antenas", " ", "terminais", 
        "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
         1, $CellContext`bota28 =!= 1, $CellContext`bota291 =!= 
         1, $CellContext`bota2101 =!= 1, $CellContext`bota2102 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
         N[$CellContext`botn]], 
        If[$CellContext`passivo == 0, 
         Print[
         "Aten\[CCedilla]\[ATilde]o -> O percurso n\[ATilde]o tem \
repetidor!"], $CellContext`diametroe = $CellContext`MyInput[
           "Introduza o di\[AHat]metro optimizado da antena emissora em [m]", \
$CellContext`diametroe]; $CellContext`diametror = $CellContext`MyInput[
           "Introduza o di\[AHat]metro optimizado da antena receptora em \
[m]", $CellContext`diametror]]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"   ", 
       RowBox[{
       "\[CapitalAAcute]rea", " ", "efectiva", " ", "do", " ", "repetidor", 
        "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
         1, $CellContext`bota28 =!= 1, $CellContext`bota291 =!= 
         1, $CellContext`bota2101 =!= 1, $CellContext`bota2102 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
         N[$CellContext`botn]], If[$CellContext`passivo == 0, 
          Print[
          "Aten\[CCedilla]\[ATilde]o -> O percurso n\[ATilde]o tem \
repetidor!"], 
          If[$CellContext`margem3 == 
            0, $CellContext`margem3 = $CellContext`MyInput[
             "Introduza a margem de seguran\[CCedilla]a desejada", \
$CellContext`margem3]]; 
          Print["Di\[AHat]metro optimizado da antena emissora: ", 
            $CellContext`numdb[$CellContext`diametroe], " m."]; 
          Print["Di\[AHat]metro optimizado da antena receptora: ", 
            $CellContext`numdb[$CellContext`diametror], " m."]; 
          Print["Rendimento do repetidor do tipo espelho plano \
rect\[AHat]ngular:  \[Eta]=", 
            $CellContext`numdb[$CellContext`\[Eta]esp], " ."]; 
          Print["Rendimento do repetidor do tipo costas-com-costas:  \[Eta]=", 
            $CellContext`numdb[$CellContext`\[Eta]costas], 
            " ."]; $CellContext`arearep = Table[0., {$CellContext`i, 
              Length[$CellContext`areapassivo]}]; 
          For[$CellContext`i = 1, $CellContext`i <= $CellContext`passivo, 
            Increment[$CellContext`i], 
            Part[$CellContext`arearep, $CellContext`i] = 
             10^(($CellContext`margem3 - $CellContext`mcritica)/20) (
               Part[$CellContext`areapassivo, $CellContext`i] \
$CellContext`diame $CellContext`diamr/($CellContext`diametroe \
$CellContext`diametror)); 
            For[$CellContext`j = 1, $CellContext`j < $CellContext`numfreq + 1, 
              Increment[$CellContext`j], Print["Para f= ", 
                Part[$CellContext`f, $CellContext`j], 
                ", a \[AAcute]rea efectiva do repetidor passivo ter\[AAcute] \
de ser de ", 
                $CellContext`numdb[
                 Part[$CellContext`arearep, $CellContext`i, $CellContext`j]], 
                " \!\(\*SuperscriptBox[\(m\), \(2\)]\) para cumprir a margem \
de seguran\[CCedilla]a desejada de ", $CellContext`margem3, " dB."]; 
              If[Part[$CellContext`arearep, $CellContext`i, $CellContext`j] >= 
                35, 
                Print[
                "(Aten\[CCedilla]\[ATilde]o que a \[AAcute]rea fisica n\
\[ATilde]o deve exceder os 35 \!\(\*SuperscriptBox[\(m\), \(2\)]\).)"]]]]] 
        Print["\nAEN\[CapitalCCedilla]\[CapitalATilde]O: Caso deseje alterar \
as as caracter\[IAcute]sticas das antenas terminais e do repetidor, dever\
\[AAcute] voltar \[AGrave]s sec\[CCedilla]\[OTilde]es 1.4 e 1.10.\n"]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.5152360081875*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}]
}, Open  ]]
}, Open  ]]
}, Closed]],

