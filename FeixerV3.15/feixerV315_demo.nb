       1; $CellContext`bota23 = 1; $CellContext`bota24 = 
       1; $CellContext`bota26 = 1; $CellContext`bota28 = 
       1; $CellContext`bota291 = 1; $CellContext`bota292 = 
       1; $CellContext`bota2101 = 1; $CellContext`bota2102 = 
       1; $CellContext`bota31 = 1; $CellContext`bota33 = 
       1; $CellContext`bota34 = 1; $CellContext`bota35 = 
       1; $CellContext`bota37 = 1; $CellContext`bota381 = 
       1; $CellContext`bota382 = 1; $CellContext`bota391 = 
       1; $CellContext`bota392 = 1; 
      Print["Nome do ficheiro de vari\[AAcute]veis :  ", $CellContext`nomevar,
         " ."]),
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{
      "Visualizar", " ", "os", " ", "principais", " ", "par\[AHat]metros", 
       "  "}]}],
     ButtonFunction:>(Off[
        MessageName[General, "spell"]]; 
      Print["frequ\[EHat]ncias :  ", $CellContext`f, " MHz"]; 
      Print["Nome da liga\[CCedilla]\[ATilde]o :  ", $CellContext`nomlig]; 
      Print["Nome do ficheiro de entrada da liga\[CCedilla]\[ATilde]o :  ", \
$CellContext`nomein]; 
      Print["Ritmo bin\[AAcute]rio :  ", $CellContext`fb, " Mbps"]; 
      Print["Modula\[CCedilla]\[ATilde]o :  ", $CellContext`modula]; 
      Print["N\[IAcute]veis por palavra :  ", $CellContext`mniveis]),
     Evaluator->Automatic]}
