Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{" ", 
       RowBox[{"SESR", " ", "devido", " ", "\[AGrave]", " ", "chuva", " ", 
        RowBox[{"c", "/", " ", "diversidade"}]}]}],
      ButtonFunction:>($CellContext`MuSESR = $CellContext`cn - \
$CellContext`CNberSESR; $CellContext`muSESR = 
        10^($CellContext`MuSESR/10); $CellContext`mrSESR = 
        1/(1/$CellContext`muSESR + 
         1/$CellContext`Msdiv); $CellContext`sesrchdiv = 
        Table[0., {$CellContext`a, $CellContext`numfreq}]; 
       Print["Valor da norma SESR = ", $CellContext`SESR]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], (
          Part[$CellContext`sesrchdiv, $CellContext`i] = 0; Null) 
         If[Part[$CellContext`sesrchdiv, $CellContext`i] <= $CellContext`SESR, 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula cumprida, sesrchuva=", 
            Part[$CellContext`sesrchdiv, $CellContext`i]], 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula n\[ATilde]o cumprida, sesrchuva=", 
            Part[$CellContext`sesrchdiv, $CellContext`i]]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
