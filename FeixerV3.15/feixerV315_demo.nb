mais de 0.01% do tempo:\nAr=", 
          $CellContext`numdb[$CellContext`Ar], " dB."]; $CellContext`Arain[
           Pattern[$CellContext`pp, 
            Blank[]]] := $CellContext`Ar 
          0.12 $CellContext`pp^(-(0.546 + 
