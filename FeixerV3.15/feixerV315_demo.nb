Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.3  Altura dos mastros das antenas",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tO valor da altura dos mastros, coincide aqui em termos simplistas com o \
foco das antenas, do tipo parab\[OAcute]lico. Esta altura deve deixar um m\
\[IAcute]nimo de 3 m entre o solo e o extremo inferior da antena.\
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Mastro", " ", "de", " ", "emiss\[ATilde]o", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota111 =!= 1, $CellContext`bota112 =!= 
         1, $CellContext`bota12 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`hae = $CellContext`MyInput[
         "Coloque a altura do mastro de emiss\[ATilde]o em [m]", \
$CellContext`hae]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Mastro", " ", "de", " ", "recep\[CCedilla]\[ATilde]o", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota111 =!= 1, $CellContext`bota112 =!= 
         1, $CellContext`bota12 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`har = $CellContext`MyInput[
         "   Coloque a altura do mastro de recep\[CCedilla]\[ATilde]o em \
[m]", $CellContext`har]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Raio", " ", "directo", "  "}]}],
      ButtonFunction:>(If[
         Or[$CellContext`bota111 =!= 1, $CellContext`bota112 =!= 
          1, $CellContext`bota12 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
          N[$CellContext`botn]], $CellContext`bota13 = 1; $CellContext`botn = 
          4; Print[
          "Altura do mastro de emiss\[ATilde]o:  ", $CellContext`hae, " m."]; 
         Print["Altura do mastro de recep\[CCedilla]\[ATilde]o:  ", \
$CellContext`har, " m."]; $CellContext`mastroe = 
          ListPlot[{{Part[$CellContext`d, 1]/$CellContext`km, 
              Part[$CellContext`h, 1]}, {
             Part[$CellContext`d, 1]/$CellContext`km, 
              Part[$CellContext`h, 1] + $CellContext`hae}}, Joined -> True, 
            PlotStyle -> {
              AbsoluteThickness[2], 
              Hue[0.1, 0.7, 0.5]}, DisplayFunction -> 
            Identity]; $CellContext`mastror = ListPlot[{{$CellContext`dkm, 
              Part[$CellContext`h, $CellContext`l]}, {$CellContext`dkm, 
              Part[$CellContext`h, $CellContext`l] + $CellContext`har}}, 
            Joined -> True, PlotStyle -> {
              AbsoluteThickness[2], 
              Hue[0.1, 0.7, 0.5]}, DisplayFunction -> 
            Identity]; $CellContext`raiodirecto = Graphics[{
             Dashing[{0.01, 0.01}], 
             
             Line[{{Part[$CellContext`d, 1]/$CellContext`km, 
                Part[$CellContext`h, 
                  1] + $CellContext`hae}, {$CellContext`dkm, 
                Part[$CellContext`h, $CellContext`l] + $CellContext`har}}], 
             PlotStyle -> Hue[0.1, 0.7, 0.5]}]; $CellContext`grafico2 = 
          Show[$CellContext`grafico1, $CellContext`mastroe, \
$CellContext`mastror, $CellContext`raiodirecto, 
            Graphics[
             Text[
              StyleForm["(", FontSize -> 18, FontWeight -> "Bold"], {
              Part[$CellContext`d, 1]/$CellContext`km, 
               Part[$CellContext`h, 1] + $CellContext`hae}]], 
            Graphics[
             Text[
              StyleForm[
              ")", FontSize -> 18, FontWeight -> "Bold"], {$CellContext`dkm, 
               Part[$CellContext`h, $CellContext`l] + $CellContext`har}]]]]; 
       Print[$CellContext`grafico2]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.51523600603125*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

