Cell[CellGroupData[{

Cell[TextData[StyleBox["\t\t\t3.10.9  Gr\[AAcute]fico da margem \
cr\[IAcute]tica",
 FontColor->RGBColor[1, 1, 0]]], "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[StyleBox["\nDado que o Y=0, a cl\[AAcute]usula SESR devido \
\[AGrave] chuva \[EAcute] sempre cumprida. Por este motivo a margem referente \
a esta cl\[AAcute]usula n\[ATilde]o \[EAcute] apresentada no gr\[AAcute]fico.\
\n",
 FontColor->RGBColor[0, 0, 1]]], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[1, 0, 0],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Margem", " ", "cr\[IAcute]tica", "  "}]}],
      ButtonFunction:>($CellContext`m1 = 
        10 Log[$CellContext`SESR/$CellContext`sesr]; $CellContext`m2 = 
        10 Log[$CellContext`BBER/$CellContext`bber]; $CellContext`m3 = 
        10 Log[$CellContext`ESR/$CellContext`esr]; $CellContext`m5 = 
        10 Log[$CellContext`BBER/$CellContext`bberchuva]; $CellContext`m6 = 
        10 Log[$CellContext`ESR/$CellContext`esrchuva]; $CellContext`m7 = \
$CellContext`cn - $CellContext`INDchuva; 
       Print["   A margem cr\[IAcute]tica para a cl\[AAcute]usula SESR \
\[EAcute]: (10Log[SESR/sesr])\n\!\(\*SubscriptBox[\(m\), \(SESR\)]\)=", 
         $CellContext`numdb[$CellContext`m1], " dB."]; 
       Print["   A margem cr\[IAcute]tica para a cl\[AAcute]usula BBER \
\[EAcute]:\n\!\(\*SubscriptBox[\(m\), \(BBER\)]\)=", 
         $CellContext`numdb[$CellContext`m2], " dB."]; 
       Print["   A margem cr\[IAcute]tica para a cl\[AAcute]usula ESR \
\[EAcute]:\n\!\(\*SubscriptBox[\(m\), \(ESR\)]\)=", 
         $CellContext`numdb[$CellContext`m3], " dB."]; 
       Print["   A margem cr\[IAcute]tica para a cl\[AAcute]usula BBER devido \
\[AGrave] chuva \[EAcute]:\n\!\(\*SubscriptBox[\(m\), \(BBERCH\)]\)=", 
         $CellContext`numdb[$CellContext`m5], " dB."]; 
       Print["   A margem cr\[IAcute]tica para a cl\[AAcute]usula ESR devido \
\[AGrave] chuva \[EAcute]:\n\!\(\*SubscriptBox[\(m\), \(ESRCH\)]\)=", 
         $CellContext`numdb[$CellContext`m6], " dB."]; 
       Print["   A margem cr\[IAcute]tica para a cl\[AAcute]usula \
indisponibilidade \[EAcute]:\n\!\(\*SubscriptBox[\(m\), \(IND\)]\)=", 
         $CellContext`numdb[$CellContext`m7], " dB."]; $CellContext`margemat1 = 
        Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`m1, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat2 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`m2, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat3 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`m3, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat5 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`m5, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat6 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`m6, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat7 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`m7, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`grafmargat1 = 
        ListPlot[$CellContext`margemat1, Joined -> True, PlotStyle -> {
            Thickness[0.004], 
            RGBColor[1, 0, 1]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat2 = 
        ListPlot[$CellContext`margemat2, Joined -> True, PlotStyle -> {
            Thickness[0.004], 
            RGBColor[1, 0, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat3 = 
        ListPlot[$CellContext`margemat3, Joined -> True, PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 0, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat5 = 
        ListPlot[$CellContext`margemat5, Joined -> True, PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 1, 1]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat6 = 
        ListPlot[$CellContext`margemat6, Joined -> True, PlotStyle -> {
            Thickness[0.004], 
            RGBColor[1, 1, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat7 = 
        ListPlot[$CellContext`margemat7, Joined -> True, PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 0, 1]}, DisplayFunction -> 
          Identity]; $CellContext`mcriticaux = Table[
          Min[
           Part[$CellContext`m1, $CellContext`j], 
           
           Part[$CellContext`m2, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`ymaxaux1 = Table[
          Max[
           Part[$CellContext`m1, $CellContext`j], 
           
           Part[$CellContext`m2, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcriticaux2 = Table[
          Min[
           Part[$CellContext`mcriticaux, $CellContext`j], 
           
           Part[$CellContext`m3, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`ymaxaux2 = Table[
          Max[
           Part[$CellContext`ymaxaux1, $CellContext`j], 
           
           Part[$CellContext`m3, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcriticaux4 = Table[
          Min[
           Part[$CellContext`mcriticaux2, $CellContext`j], 
           
           Part[$CellContext`m5, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`ymaxaux4 = Table[
          Max[
           Part[$CellContext`ymaxaux2, $CellContext`j], 
           
           Part[$CellContext`m5, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcriticaux5 = Table[
          Min[
           Part[$CellContext`mcriticaux4, $CellContext`j], 
           
           Part[$CellContext`m6, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`ymaxaux5 = Table[
          Max[
           Part[$CellContext`ymaxaux4, $CellContext`j], 
           
           Part[$CellContext`m6, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcritica = Table[
          Min[
           Part[$CellContext`mcriticaux5, $CellContext`j], 
           
           Part[$CellContext`m7, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`ymaxaux = Table[
          Max[
           Part[$CellContext`ymaxaux5, $CellContext`j], 
           
           Part[$CellContext`m7, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; 
       For[$CellContext`i = 
          1; $CellContext`moptima = -200, $CellContext`i <= \
$CellContext`numfreq, 
         Increment[$CellContext`i], 
         If[$CellContext`moptima < 
          Part[$CellContext`mcritica, $CellContext`i], $CellContext`foptima = 
           Part[$CellContext`f, $CellContext`i]; $CellContext`moptima = 
           Part[$CellContext`mcritica, $CellContext`i]]]; 
       For[$CellContext`j = 
          1; $CellContext`ymax = -40, $CellContext`j <= $CellContext`numfreq, 
         
         Increment[$CellContext`j], 
         If[$CellContext`ymax < 
          Part[$CellContext`ymaxaux, $CellContext`j], $CellContext`ymax = 
          Part[$CellContext`ymaxaux, $CellContext`j]]]; $CellContext`ymin = \
-60; If[$CellContext`ymax < 3, $CellContext`ymax = 10]; 
       If[$CellContext`numfreq =!= 1, 
         Print[
          
          Show[$CellContext`grafmargat1, $CellContext`grafmargat2, \
$CellContext`grafmargat3, $CellContext`grafmargat5, $CellContext`grafmargat6, \
$CellContext`grafmargat7, 
           Graphics[{
             Dashing[{0.01, 0.01}], 
             Line[{{
                Part[$CellContext`f, 1], 3}, {
                Part[$CellContext`f, $CellContext`numfreq], 3}}]}], 
           Graphics[
            Text[
             Style[
             "Margem da cl\[AAcute]usula SESR", FontSize -> 10, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[1, 0, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymin + 18}]], 
           Graphics[
            Text[
             Style[
             "Margem da cl\[AAcute]usula BBER", FontSize -> 10, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[1, 0, 0]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymin + 13}]], 
           Graphics[
            Text[
             Style[
             "Margem da cl\[AAcute]usula ESR", FontSize -> 10, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[0, 0, 0]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymin + 8}]], 
           Graphics[
            Text[
             Style[
             "Margem da cl\[AAcute]usula BBER devido \[AGrave] chuva", 
              FontSize -> 10, FontWeight -> Bold, FontColor -> 
              RGBColor[0, 1, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymin + 3}]], 
           Graphics[
            Text[
             Style[
             "Margem da cl\[AAcute]usula ESR devido \[AGrave] chuva", 
              FontSize -> 10, FontWeight -> Bold, FontColor -> 
              RGBColor[1, 1, 0]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymin - 2}]], 
           Graphics[
            Text[
             Style[
             "Margem da cl\[AAcute]usula indisponibilidade", FontSize -> 10, 
              FontWeight -> Bold, FontColor -> 
              RGBColor[0, 0, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymin - 7}]], 
           PlotRange -> {{
              Part[$CellContext`f, 1], 
              Part[$CellContext`f, $CellContext`numfreq]}, {$CellContext`ymin - 
              10, $CellContext`ymax + 10}}, Frame -> True, 
           ImageSize -> {700, 500}, PlotLabel -> 
           Style[$CellContext`nomlig, FontWeight -> Bold, FontSize -> 11], 
           FrameLabel -> {
             Style[
             "Frequ\[EHat]ncia [GHz]", FontWeight -> Bold, FontSize -> 11], 
             Style[
             "Margens cr\[IAcute]ticas [dB]", FontWeight -> Bold, FontSize -> 
              11]}, DisplayFunction -> $DisplayFunction]]]; 
       Print["A margem cr\[IAcute]tica da liga\[CCedilla]\[ATilde]o \
\[EAcute]:\n", 
         $CellContext`numdb[$CellContext`mcritica], " dB."]; 
       Print["A frequ\[EHat]ncia \[OAcute]ptima \[EAcute] f=", 
         $CellContext`numhz[$CellContext`foptima], 
         " GHz (\!\(\*SubscriptBox[\(M\), \(crit\)]\)=", 
         $CellContext`numdb[$CellContext`moptima], " dB)."]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.5152360091875*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

