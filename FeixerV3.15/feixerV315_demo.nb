Cell[CellGroupData[{

Cell[TextData[{
 "\t",
 StyleBox["3.6  Recomenda\[CCedilla]\[OTilde]es da ITU",
  FontColor->RGBColor[1, 1, 0]]
}], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tDe acordo com as recomenda\[CCedilla]\[OTilde]es F.1189-1 e P.530-8 da \
ITU-R e G.826 da ITU-T, os novos crit\[EAcute]rios de qualidade est\[ATilde]o \
definidos pelo cumprimento das cl\[AAcute]usulas SESR, BBER e ESR. Estas cl\
\[AAcute]usulas s\[ATilde]o obtidas atrav\[EAcute]s de um valor X, \
normalmente definido com o valor 0,08 . \n\n\t\t\t\t\t",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      RowBox[{"Ritmo", " ", "bin\[AAcute]rio"}], "\[IndentingNewLine]", "   ", 
      RowBox[{"(", 
       RowBox[{"kbits", "/", "s"}], ")"}]}], "esr", "sesr", "bber"},
    {
     RowBox[{
      RowBox[{"1", " ", "500"}], "-", 
      RowBox[{"5", " ", "000"}]}], 
     RowBox[{"0.04", "\[Times]", "X"}], 
     RowBox[{"0.002", "\[Times]", "X"}], 
     RowBox[{"2", "\[Times]", "X", "\[Times]", 
      SuperscriptBox["10", 
       RowBox[{"-", "4"}]]}]},
    {
     RowBox[{">", 
      RowBox[{
       RowBox[{"5", " ", "000"}], "-", 
       RowBox[{"15", " ", "000"}]}]}], 
     RowBox[{"0.05", "\[Times]", "X"}], 
     RowBox[{"0.002", "\[Times]", "X"}], 
     RowBox[{"2", "\[Times]", "X", "\[Times]", 
      SuperscriptBox["10", 
       RowBox[{"-", "4"}]]}]},
    {
     RowBox[{">", 
      RowBox[{
       RowBox[{"15", " ", "000"}], "-", 
       RowBox[{"55", " ", "000"}]}]}], 
     RowBox[{"0.075", "\[Times]", "X"}], 
     RowBox[{"0.002", "\[Times]", "X"}], 
     RowBox[{"2", "\[Times]", "X", "\[Times]", 
      SuperscriptBox["10", 
       RowBox[{"-", "4"}]]}]},
    {
     RowBox[{">", 
      RowBox[{
       RowBox[{"55", " ", "000"}], "-", " ", 
       RowBox[{"160", " ", "000"}]}]}], 
     RowBox[{"0.16", "\[Times]", "X"}], 
     RowBox[{"0.002", "\[Times]", "X"}], 
     RowBox[{"2", "\[Times]", "X", "\[Times]", 
      SuperscriptBox["10", 
       RowBox[{"-", "4"}]]}]}
   },
   GridBoxDividers->{
    "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
     "RowsIndexed" -> {}}]]],
 "\n\nSegundo P.530-8 da ITU-R est\[ATilde]o definidos, na tabela 2 da mesma \
recomenda\[CCedilla]\[ATilde]o, os valores da taxa de erros bin\[AAcute]rios ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ber", "SES"], TraditionalForm]]],
 "e n\[UAcute]mero de blocos por segundo para cada ritmo bin\[AAcute]rio/Tipo \
de percurso.\n\t\t\t\n\t\t\t\n\t\t\t\t",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      RowBox[{"Tipo", " ", "de"}], " ", "\[IndentingNewLine]", "percurso"}], 
     RowBox[{
      RowBox[{"Ritmo", " ", "bin\[AAcute]rio"}], "\[IndentingNewLine]", "   ", 
      RowBox[{"(", 
       RowBox[{"kbits", "/", "s"}], ")"}]}], 
     SubscriptBox["ber", "SES"], 
     RowBox[{"blocos", "/", "s"}], 
     RowBox[{"Bits", "/", "bloco"}]},
    {
     RowBox[{"VC", "-", "11"}], 
     RowBox[{"1", " ", "500"}], 
     RowBox[{"5.4", 
      SuperscriptBox["x10", 
       RowBox[{"-", "4"}]]}], "2000", "832"},
    {
     RowBox[{"VC", "-", "12"}], 
     RowBox[{"2", " ", "000"}], 
     RowBox[{"4.0", 
      SuperscriptBox["x10", 
       RowBox[{"-", "4"}]]}], "2000", "1120"},
    {
     RowBox[{"VC", "-", "2"}], 
     RowBox[{"6", " ", "000"}], 
     RowBox[{"1.3", 
      SuperscriptBox["x10", 
       RowBox[{"-", "4"}]]}], "2000", "3424"},
    {
     RowBox[{"VC", "-", "3"}], 
     RowBox[{"34", " ", "000"}], 
     RowBox[{"6.5", 
      SuperscriptBox["x10", 
       RowBox[{"-", "5"}]]}], "8000", "6120"},
    {
     RowBox[{"VC", "-", "4"}], 
     RowBox[{"140", " ", "000"}], 
     RowBox[{"2.1", 
      SuperscriptBox["x10", 
       RowBox[{"-", "5"}]]}], "8000", "18792"},
    {
     RowBox[{"STM", "-", "1"}], 
     RowBox[{"155", " ", "000"}], 
     RowBox[{"2.3", 
      SuperscriptBox["x10", 
       RowBox[{"-", "5"}]]}], "8000", "19440"}
   },
   GridBoxDividers->{
    "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
     "RowsIndexed" -> {}}]]]
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{" ", 
       RowBox[{"Par\[AHat]metros", " ", "de", " ", "qualidade", " "}]}],
      ButtonFunction:>($CellContext`X = $CellContext`MyInput[
         "Introduza o valor de X para o calculo de SESR, BBER e ESR.\nValor \
recomendado[0.075;0.085]", $CellContext`X]; 
       Print["O valor de X para o c\[AAcute]lculo de SESR, BBER e ESR \
\[EAcute] X=", 
         $CellContext`numdb[$CellContext`X]]; $CellContext`SESR = 
        0.002 $CellContext`X; $CellContext`BBER = 
        2. 10^(-4) $CellContext`X; $CellContext`ESR = 
        Which[1.5 <= N[$CellContext`fb] <= 5., 0.04 $CellContext`X, 
          Inequality[5., Less, 
           N[$CellContext`fb], LessEqual, 15.], 0.05 $CellContext`X, 
          Inequality[15., Less, 
           N[$CellContext`fb], LessEqual, 55.], 0.075 $CellContext`X, 
          Inequality[55., Less, 
           N[$CellContext`fb], LessEqual, 160.], 0.16 $CellContext`X]; 
       Print["O valor de SESR \[EAcute] de ", 
         $CellContext`num5c[$CellContext`SESR]]; 
       Print["O valor de BBER \[EAcute] de ", 
         $CellContext`num5c[$CellContext`BBER]]; 
       Print["O valor de ESR \[EAcute] de ", 
         $CellContext`num5c[$CellContext`ESR]]; Null),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", "rber", "  "}],
      ButtonFunction:>($CellContext`rber = 
        10.^(-12); $CellContext`rber = $CellContext`MyInput[
         "Introduza o valor de rber.\n\n   Valor \
recomendado[10^(-10);10^(-13)]: 10^(-12)", $CellContext`rber]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"C\[AAcute]lculos", " ", "auxiliares", "  "}]}],
      ButtonFunction:>($CellContext`berSESR[] := Switch[
          N[$CellContext`fb], 1.5, 5.4 10^(-4), 1.664, 5.4 10^(-4), 2., 4. 
          10^(-4), 2.24, 4. 10^(-4), 6., 1.3 10^(-4), 6.848, 1.3 10^(-4), 8., 
          1. 10^(-4), 34., 6.5 10^(-5), 48.96, 6.5 10^(-5), 140., 2.1 10^(-5),
           150.336, 2.1 10^(-5), 155., 2.33 10^(-4), 159.52, 2.33 
          10^(-4)]; $CellContext`nn[] := Switch[
          N[$CellContext`fb], 1.5, 2000., 1.664, 2000., 2., 2000., 2.24, 
          2000., 6., 2000., 6.848, 2000., 8., 2000., 34., 8000., 48.96, 8000.,
           140., 8000., 150.336, 8000., 155., 8000., 159.52, 
          8000.]; $CellContext`Nb[] := Switch[
          N[$CellContext`fb], 1.5, 832., 1.664, 832., 2., 1120., 2.24, 1120., 
          6., 3424., 6.848, 3424., 8., 4000., 34., 6120., 48.96, 6120., 140., 
          18792., 150.336, 18792., 155., 19440., 159.52, 19440.]; 
       Print["O valor de berSESR \[EAcute] de ", 
         $CellContext`num5c[
          $CellContext`berSESR[]]]; Print["O valor de n \[EAcute] de ", 
         $CellContext`nn[]]; Print["O valor de Nb \[EAcute] de ", 
         $CellContext`Nb[]]; Print["O valor de rber \[EAcute] de ", 
         N[$CellContext`rber]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236008484375*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

