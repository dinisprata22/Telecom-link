Cell[CellGroupData[{

Cell[TextData[StyleBox["\t3.9  Margem Selectiva ",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[StyleBox["\tA margem selectiva pode ser calculada de uma das \
seguintes formas:\n\t\n\t\t1. M\[EAcute]todo B da recomenda\[CCedilla]\
\[ATilde]o F1093-1 da ITU-R.\n\t\t\tpara mniveis<=64\n\t\n\t\t2. \
M\[EAcute]todo alternativo (\[AAcute]rea da assinatura).\n\t\t\n\t\t\tPara \
sistemas sem iguala\[CCedilla]\[ATilde]o s\[ATilde]o t\[IAcute]picos os \
seguintes valores de assinatura [s] (cap\[IAcute]tulo 5.8.3 [1]):\n\n\t\t\t\
0.5 a 0.8 MHz, para 34 Mbit/s com modula\[CCedilla]\[ATilde]o 4-PSK\n\n\t\t\t\
25 a 30 MHz, para 140 Mbit/s com modula\[CCedilla]\[ATilde]o 16-QAM\n\n\t\t\t\
Os factores de redu\[CCedilla]\[ATilde]o da \[AAcute]rea da assinatura para \
diferentes tipos de igualadores num sistema a 140Mbit/s com modula\[CCedilla]\
\[ATilde]o \t\t\t16-QAM s\[ATilde]o observ\[AAcute]veis no cap. 5.8.4, tabela \
5.8 [1].",
 FontColor->RGBColor[0, 0, 1]]], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[1, 0, 0],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Iguala\[CCedilla]\[ATilde]o", " ", "adaptativa", "  "}]}],
      ButtonFunction:>($CellContext`intri = $CellContext`sim; If[
         Or[$CellContext`bota31 =!= 1, $CellContext`bota33 =!= 
          1, $CellContext`bota34 =!= 1, $CellContext`bota35 =!= 
          1, $CellContext`bota37 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 3.", 
          
          N[$CellContext`botn]], $CellContext`irmp = $CellContext`MyInput[
           "Introduza o factor de redu\[CCedilla]\[ATilde]o da \[AAcute]rea \
da assinatura para desvanecimentos selectivos de fase m\[IAcute]nima.\n\
Aconselha-se a consulta do cap. 5.8.4 [1].", 490]; 
         Print["Factor de redu\[CCedilla]\[ATilde]o da \[AAcute]rea da \
assinatura para desvanecimentos de fase m\[IAcute]nima:  \
\!\(\*SubscriptBox[\(i\), \(mp\)]\)= ", $CellContext`irmp, 
           " ."]; $CellContext`irnmp = $CellContext`MyInput[
           "Introduza o factor de redu\[CCedilla]\[ATilde]o da \[AAcute]rea \
da assinatura para desvanecimentos selectivos de fase n\[ATilde]o \
m\[IAcute]nima.\nAconselha-se a consulta do cap. 5.8.4 [1].", 35]; 
         Print["Factor de redu\[CCedilla]\[ATilde]o da \[AAcute]rea da \
assinatura para desvanecimentos de fase n\[ATilde]o m\[IAcute]nima:  \
\!\(\*SubscriptBox[\(i\), \(nmp\)]\)= ", $CellContext`irnmp, " ."]]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"M\[EAcute]todo", " ", "1", " "}]}],
      ButtonFunction:>($CellContext`intru2 = $CellContext`sim; \
$CellContext`irg = 1; If[
         Or[$CellContext`bota31 =!= 1, $CellContext`bota33 =!= 
          1, $CellContext`bota34 =!= 1, $CellContext`bota35 =!= 
          1, $CellContext`bota37 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 3.", 
          N[$CellContext`botn]], $CellContext`ms[] := 
          
          Module[{$CellContext`\[Eta], $CellContext`n, $CellContext`\[Tau], \
$CellContext`Ts, $CellContext`Kn, $CellContext`Psmp, $CellContext`ms}, \
$CellContext`\[Eta] = 1 - E^((-0.2) $CellContext`kt[]^(3/4)); $CellContext`n = 
             1.4; $CellContext`\[Tau] = 
             0.7 ($CellContext`dkm/50)^$CellContext`n; $CellContext`Ts = 
             Log[2, $CellContext`mniveis]/($CellContext`fb 
              10^6); $CellContext`Kn = 
             Table[0., {$CellContext`x, $CellContext`numfreq}]; 
            For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
              Increment[$CellContext`i], 
              Part[$CellContext`Kn, $CellContext`i] = Switch[
                N[
                 Part[$CellContext`mniveis, $CellContext`i]], 4., 1., 8., 7., 
                16., 5.5, 64., 15.4]]; $CellContext`Psmp = 
             2.16 $CellContext`Kn (
               2 ($CellContext`\[Tau]/
                 10^9)^2)/$CellContext`Ts^2; $CellContext`ms = \
$CellContext`kt[]/($CellContext`\[Eta] $CellContext`Psmp)]; 
         If[$CellContext`intri == $CellContext`sim, 
           If[$CellContext`dkm <= 20, $CellContext`irg = 
             1/(0.8/$CellContext`irmp + 0.2/$CellContext`irnmp), 
             
             If[$CellContext`dkm <= 
              40, $CellContext`k1 = 
               0.5 + (1/20) 0.3 (40 - $CellContext`dkm); $CellContext`k2 = 
               0.5 - (1/20) 0.3 (40 - $CellContext`dkm); $CellContext`irg = 
               1/($CellContext`k1/$CellContext`irmp + \
$CellContext`k2/$CellContext`irnmp), $CellContext`irg = 
              1/(0.5/$CellContext`irmp + 0.5/$CellContext`irnmp)]]; 
           Print["O factor de melhoria na margem selectiva devido \[AGrave] \
iguala\[CCedilla]\[ATilde]o \[EAcute] de ", 
             $CellContext`numdb[$CellContext`irg], " dB."]]; $CellContext`Ms = 
          N[
             $CellContext`ms[]] $CellContext`irg; $CellContext`mslog = 
          10 Log[10, $CellContext`Ms]; 
         Print["A margem selectiva \[EAcute] Ms=", 
           $CellContext`numdb[$CellContext`mslog], " dB."]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"M\[EAcute]todo", " ", "2", "  "}]}],
      ButtonFunction:>($CellContext`intru2 = $CellContext`sim; \
$CellContext`irg = 
        1; $CellContext`ass = $CellContext`MyInput[
         "Introduza a assinatura em [MHz].\nAconselha-se a consulta do cap. \
5.8.3 [1].\n\[CapitalEAcute] possivel introduzir v\[AAcute]rios valores de \
assinatura para cada frequ\[EHat]ncia. Ex: {30,37.5,30} ", $CellContext`ass]; 
       Print["Assinatura introduzida:  ", $CellContext`ass, 
         " MHz."]; $CellContext`ms[] := 8000/$CellContext`ass; 
       If[$CellContext`intri == $CellContext`sim, 
         If[$CellContext`dkm <= 20, $CellContext`irg = 
           1/(0.8/$CellContext`irmp + 0.2/$CellContext`irnmp), 
           
           If[$CellContext`dkm <= 
            40, $CellContext`k1 = 
             0.5 + (1/20) 0.3 (40 - $CellContext`dkm); $CellContext`k2 = 
             0.5 - (1/20) 0.3 (40 - $CellContext`dkm); $CellContext`irg = 
             1/($CellContext`k1/$CellContext`irmp + \
$CellContext`k2/$CellContext`irnmp), $CellContext`irg = 
            1/(0.5/$CellContext`irmp + 0.5/$CellContext`irnmp)]]; 
         Print["O factor de melhoria na margem selectiva devido \[AGrave] \
iguala\[CCedilla]\[ATilde]o \[EAcute] de ", 
           $CellContext`numdb[$CellContext`irg], " dB."]]; $CellContext`Ms = N[
           $CellContext`ms[]] $CellContext`irg; $CellContext`mslog = 
        10 Log[10, $CellContext`Ms]; Print["A margem selectiva \[EAcute] Ms=", 
         $CellContext`numdb[$CellContext`mslog], " dB."]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236008625*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

