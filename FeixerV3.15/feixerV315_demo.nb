Cell[CellGroupData[{

Cell[TextData[StyleBox["\t3.8  Margem Uniforme ",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[StyleBox["\tCom base nos c\[AAcute]lculos auxiliares da secc\
\[CCedilla]\[ATilde]o 3.6 s\[ATilde]o calculados os C/N correspondentes e as \
respectivas margens uniformes.",
 FontColor->RGBColor[0, 0, 1]]], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[1, 0, 0],
 Background->None],

Cell[BoxData[
 ButtonBox[
  RowBox[{"  ", 
   RowBox[{"Margem", " ", "uniforme", "  "}]}],
  ButtonFunction:>($CellContext`intri = $CellContext`nao; $CellContext`intru1 = \
$CellContext`sim; $CellContext`bota381 = 1; $CellContext`CNberSESR = 
    Table[0, {$CellContext`a, $CellContext`numfreq}]; $CellContext`CNrber = 
    Table[0, {$CellContext`a, $CellContext`numfreq}]; $CellContext`CNberIND = 
    Table[0, {$CellContext`a, $CellContext`numfreq}]; \
$CellContext`calcCNberSESR[
      Pattern[$CellContext`n, 
       Blank[]]] := Part[
      FindRoot[Part[
         $CellContext`pber[$CellContext`CN], $CellContext`n] == \
$CellContext`berSESR[], {$CellContext`CN, 20.}], 1, 
      2]; $CellContext`calcCNrber[
      Pattern[$CellContext`n, 
       Blank[]]] := Part[
      FindRoot[Part[
         $CellContext`pber[$CellContext`CN], $CellContext`n] == \
$CellContext`rber, {$CellContext`CN, 20.}], 1, 2]; $CellContext`calcCNberIND[
      Pattern[$CellContext`n, 
       Blank[]]] := Part[
      FindRoot[Part[
         $CellContext`pber[$CellContext`CN], $CellContext`n] == \
$CellContext`berIND, {$CellContext`CN, 20.}], 1, 2]; 
   For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
     Increment[$CellContext`i], 
     Part[$CellContext`CNberSESR, $CellContext`i] = \
$CellContext`calcCNberSESR[$CellContext`i]; 
     Part[$CellContext`CNrber, $CellContext`i] = \
$CellContext`calcCNrber[$CellContext`i]; 
     Part[$CellContext`CNberIND, $CellContext`i] = \
$CellContext`calcCNberIND[$CellContext`i]]; 
   Print["A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do correspondente \
a \!\(\*SubscriptBox[\(ber\), \(SESR\)]\) \[EAcute] (\!\(\*FractionBox[\(C\), \
\(N\)]\)\!\(\*SubscriptBox[\()\), \(SESR\)]\)=", 
     $CellContext`numdb[$CellContext`CNberSESR], " dB."]; 
   Print["A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do correspondente \
a rber \[EAcute] (\!\(\*FractionBox[\(C\), \(N\)]\)\!\(\*SubscriptBox[\()\), \
\(rber\)]\)=", 
     $CellContext`numdb[$CellContext`CNrber], " dB."]; 
   Print["A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do correspondente \
a ber=\!\(\*SuperscriptBox[\(10\), \(-3\)]\) \[EAcute] (\!\(\*FractionBox[\(C\
\), \(N\)]\)\!\(\*SubscriptBox[\()\), \(ind\)]\)=", 
     $CellContext`numdb[$CellContext`CNberIND], 
     " dB."]; $CellContext`MuSESR = $CellContext`cn - $CellContext`CNberSESR; 
   Print["A margem uniforme correspondente a \!\(\*SubscriptBox[\(ber\), \
\(SESR\)]\) \[EAcute] MuSESR=", 
     $CellContext`numdb[$CellContext`MuSESR], 
     " dB."]; $CellContext`Murber = $CellContext`cn - $CellContext`CNrber; 
   Print["A margem uniforme correspondente a rber \[EAcute] Murber=", 
     $CellContext`numdb[$CellContext`Murber], " dB."]),
  Evaluator->Automatic]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.5152360085625*^9},
 FontColor->RGBColor[1, 1, 0],
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do \
correspondente a \\!\\(\\*SubscriptBox[\\(ber\\), \\(SESR\\)]\\) \[EAcute] \
(\\!\\(\\*FractionBox[\\(C\\), \\(N\\)]\\)\\!\\(\\*SubscriptBox[\\()\\), \
