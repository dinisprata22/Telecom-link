Cell[TextData[{
 StyleBox["Ru\[IAcute]do admiss\[IAcute]vel em circuitos reais \
(cap\[IAcute]tulo 4.11 de [1]):",
  FontColor->GrayLevel[0.333333]],
 "\n\n",
 StyleBox["\tA pot\[EHat]ncia de ru\[IAcute]do psofom\[EAcute]trico \
m\[EAcute]dia durante 1 minuto, no ponto de n\[IAcute]vel zero, no canal \
telef\[OAcute]nico mais desfavor\[AAcute]vel de uma liga\[CCedilla]\[ATilde]o \
por feixes hertzianos, em linha de vista, com multiplexagem por \
divis\[ATilde]o na frequ\[EHat]ncia, n\[ATilde]o deve exceder os limites,\n\n\
\t. Nas liga\[CCedilla]\[OTilde]es de comprimento d (em km), entre 280 e 2500 \
km, n\[ATilde]o muito diferentes do circuito fict\[IAcute]cio de \
refer\[EHat]ncia:\n\t\t\n\t\t1\.aaCl\[AAcute]usula,\t3d pW0p, durante mais de \
20% do tempo do pior m\[EHat]s.\n\t\t2\.aaCl\[AAcute]usula,\t47 500 pW0p, \
durante mais de ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["d", "2500"], ")"}], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\[Times]0.1% do tempo do pior m\[EHat]s.\n\n\t. Nas \
liga\[CCedilla]\[OTilde]es que difiram notavelmente do circuito \
fict\[IAcute]cio de refer\[EHat]ncia:\n\t\n\t- para 50 \[LessEqual] d \
\[LessEqual] 840,\n\n\t\t1\.aaCl\[AAcute]usula,\t3d + 200 pW0p, durante mais \
de 20% do tempo do pior m\[EHat]s.\n\t\t2\.aaCl\[AAcute]usula,\t47 500 pW0p, \
durante mais de ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["280", "2500"], ")"}], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\[Times]0.1% do tempo do pior m\[EHat]s, quando d<280, ou ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["d", "2500"], ")"}], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\[Times]0.1% do tempo do pior m\[EHat]s, quando d>280km.\n\n\t- \
para 840 \[LessEqual] d \[LessEqual] 1670,\n\n\t\t1\.aaCl\[AAcute]usula,\t3d \
+ 400 pW0p, durante mais de 20% do tempo do pior m\[EHat]s.\n\t\t2\.aaCl\
\[AAcute]usula,\t47 500 pW0p, durante mais de ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["d", "2500"], ")"}], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\[Times]0.1% do tempo do pior m\[EHat]s  .\n\n\t- para 1670 \
\[LessEqual] d \[LessEqual] 2500,\n\n\t\t1\.aaCl\[AAcute]usula,\t3d + 600 \
pW0p, durante mais de 20% do tempo do pior m\[EHat]s.\n\t\t\
2\.aaCl\[AAcute]usula,\t47 500 pW0p, durante mais de ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["280", "2500"], ")"}], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\[Times]0.1% do tempo do pior m\[EHat]s.\n\n\tPara liga\[CCedilla]\
\[OTilde]es estabelecidas sobre feixes hertzianos transorizonte, a \
pot\[EHat]ncia de ru\[IAcute]do psofom\[EAcute]trico m\[EAcute]dia durante 1 \
minuto, no ponto de n\[IAcute]vel zero, no canal telef\[OAcute]nico mais \
desfavor\[AAcute]vel, n\[ATilde]o deve exceder os limites,\n\n\t\t1\.aaCl\
\[AAcute]usula,\t10d pW0p, durante mais de 20% do tempo do pior m\[EHat]s (d \
em km).\n\t\t2\.aaCl\[AAcute]usula,\t63 000 pW0p, durante mais de ",
  FontColor->RGBColor[0, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["d", "2500"], ")"}], TraditionalForm]],
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\[Times]0.5% do tempo do pior m\[EHat]s.",
  FontColor->RGBColor[0, 0, 1]],
 "\n\n\n",
 StyleBox["Cl\[AAcute]usulas a cumprir (cap\[IAcute]tulo 4.10 de [1]):",
  FontColor->GrayLevel[0.333333]],
 "\n\n",
 StyleBox["\tSinal Telef\[OAcute]nico: a pot\[EHat]ncia de ru\[IAcute]do, no \
ponto de n\[IAcute]vel zero, no canal mais desfavor\[AAcute]vel n\[ATilde]o \
deve ultrapassar,\n\t\n\t1\.aaCl\[AAcute]usula,\t7500 pW0p, de pot\[EHat]ncia \
psofom\[EAcute]trica m\[EAcute]dia durante 1 minuto, durante mais de 20% do \
tempo do pior m\[EHat]s.\n\t2\.aaCl\[AAcute]usula,\t47500 pW0p, de \
pot\[EHat]ncia psofom\[EAcute]trica m\[EAcute]dia durante 1 minuto, durante \
mais de 0.1% do tempo do pior m\[EHat]s.\n\tCl\[AAcute]usula da chuva,\t1 000 \
000 pW0p , de pot\[EHat]ncia n\[ATilde]o ponderada com tempo de integra\
\[CCedilla]\[ATilde]o de  5ms, durante mais de 0.01% do pior m\[EHat]s.\n\n\t\
Sinal de Televis\[ATilde]o: a rela\[CCedilla]\[ATilde]o entre a amplitude \
nominal do sinal de lumin\[AHat]ncia e o valor quadr\[AAcute]tico \
m\[EAcute]dio do ru\[IAcute]do ponderado, n\[ATilde]o deve ser inferior,\n\n\t\
1\.aaCl\[AAcute]usula,\t57 dB, durante mais de 20% do tempo do pior \
m\[EHat]s.\n\t2\.aaCl\[AAcute]usula,\t45 dB, durante mais de 0.1% do tempo do \
pior m\[EHat]s.",
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellMargins->{{36, 47}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 Background->None]
}, Open  ]],

