\[Alpha]2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`f1 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`f2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; 
        For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
          Increment[$CellContext`j], 
          While[Part[$CellContext`rh, $CellContext`i, 1] < 
            Part[$CellContext`f, $CellContext`j], $CellContext`i = \
$CellContext`i + 1]; 
          Part[$CellContext`f1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 1] 10^9; 
          Part[$CellContext`f2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 1] 10^9; 
          Part[$CellContext`\[Kappa]1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 3]; 
          Part[$CellContext`\[Kappa]2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 3]; 
          Part[$CellContext`\[Alpha]1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 5]; 
          Part[$CellContext`\[Alpha]2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 5]]; $CellContext`\[Kappa] = 
         10^(Log[10, $CellContext`\[Kappa]1] + ((
              Log[10, $CellContext`\[Kappa]2] - Log[
              10, $CellContext`\[Kappa]1])/(Log[10, $CellContext`f2] - Log[
             10, $CellContext`f1])) (Log[10, $CellContext`fhz] - Log[
             10, $CellContext`f1])); 
        Print["\nAntenas utilizando polariza\[CCedilla]\[ATilde]o vertical:"]; 
        Print["Intensidade de precipita\[CCedilla]\[ATilde]o:  ", \
$CellContext`Rint, " mm/h."]; 
        Print["Frac\[CCedilla]\[ATilde]o de tempo no ano em que o valor da \
intensidade de precipita\[CCedilla]\[ATilde]o \[EAcute] excedido:  ", 
          $CellContext`numpr[$CellContext`Panual], " ."]; 
        Print["Valor de \[Kappa] \[AGrave] frequ\[EHat]ncia imposta \
\[EAcute]:\n\[Kappa]=", 
          $CellContext`numpr[$CellContext`\[Kappa]], 
          "."]; $CellContext`\[Alpha] = $CellContext`\[Alpha]1 + \
(($CellContext`\[Alpha]2 - $CellContext`\[Alpha]1)/(Log[10, $CellContext`f2] - 
            Log[10, $CellContext`f1])) (Log[10, $CellContext`fhz] - Log[
            10, $CellContext`f1]); 
        Print["Valor de \[Alpha] \[AGrave] frequ\[EHat]ncia imposta \
\[EAcute]:\n\[Alpha]=", 
          $CellContext`numhz[$CellContext`\[Alpha]], 
          "."]; $CellContext`\[Gamma] = $CellContext`\[Kappa] \
$CellContext`Rint^$CellContext`\[Alpha]; 
        Print["O coeficiente de atenua\[CCedilla]\[ATilde]o por unidade de \
comprimento:\n\[Gamma]=", 
          $CellContext`numhz[$CellContext`\[Gamma]], 
          "."]; $CellContext`Def = $CellContext`dkm/(
