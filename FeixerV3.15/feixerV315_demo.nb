Cell[TextData[StyleBox["\t1.13  Pot\[EHat]ncia de recep\[CCedilla]\[ATilde]o",
 
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tA pot\[EHat]ncia de recep\[CCedilla]\[ATilde]o \[EAcute] calculada pela f\
\[OAcute]rmula de Friis, para valores de zona distante da antena de maiores \
dimens\[OTilde]es,   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "min"], "\[LessEqual]", 
    FractionBox[
     RowBox[{"2", "\[Times]", 
      SuperscriptBox[
       SubscriptBox["D", "ant"], "2"]}], "\[Lambda]"]}], TraditionalForm]]],
 " . No caso desta n\[ATilde]o estar na zona distante, introduza uma atenua\
\[CCedilla]\[ATilde]o suplementar (consultar cap\[IAcute]tulo 2.12, fig. 2.62 \
[1])."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Atenua\[CCedilla]\[ATilde]o", " ", "suplementar", "  "}]}],
      ButtonFunction:>If[$CellContext`botaII =!= 1, 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Ter\[AAcute] que introduzir o ficheiro \
de entrada, na sec\[CCedilla]\[ATilde]o II."], 
        If[
         Or[$CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
          1, $CellContext`bota17 =!= 1, $CellContext`bota18 =!= 
          1, $CellContext`bota19 =!= 1, $CellContext`bota121 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
          N[$CellContext`botn]], $CellContext`asup = $CellContext`MyInput[
          "Introduza a atenua\[CCedilla]\[ATilde]o suplementar em [dB]", \
$CellContext`asup]]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Pot\[EHat]ncia", " ", "de", " ", "emiss\[ATilde]o", "  "}]}],
      ButtonFunction:>($CellContext`ioutr = $CellContext`sim; 
       If[$CellContext`botaII =!= 1, 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Ter\[AAcute] que introduzir o ficheiro \
de entrada, na sec\[CCedilla]\[ATilde]o II."], 
         If[
          
          Or[$CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
           1, $CellContext`bota17 =!= 1, $CellContext`bota18 =!= 
           1, $CellContext`bota19 =!= 1, $CellContext`bota121 =!= 1], 
          Print[
          "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
           
           N[$CellContext`botn]], $CellContext`pew = $CellContext`MyInput[
            "Introduza, para cada frequ\[EHat]ncia, a pot\[EHat]ncia de emiss\
\[ATilde]o, em watt.\nIndique os valores ENTRE CHAVETAS.\nExemplo: \
{2.61,1.14,0.70,0.49,0.38}\n\nAlternativamente, introduza a express\[ATilde]o \
da pot\[EHat]ncia de emiss\[ATilde]o em watt. A vari\[AAcute]vel  f  indica a \
frequ\[EHat]ncia. O expoente \[EAcute] feito com um ^ .\nExemplo:  \
6.0/f^1.2", $CellContext`pew]; $CellContext`pe = 10 Log[10, $CellContext`pew]; 
          Print["A pot\[EHat]ncia de emiss\[ATilde]o \[EAcute]:\npe=", 
            $CellContext`numdb[
             N[$CellContext`pe]], " dBW."]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Pot\[EHat]ncia", " ", "de", " ", "recep\[CCedilla]\[ATilde]o", 
        "  "}]}],
      ButtonFunction:>If[$CellContext`botaII =!= 1, 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Ter\[AAcute] que introduzir o ficheiro \
de entrada, na sec\[CCedilla]\[ATilde]o II."], 
        If[
         Or[$CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
          1, $CellContext`bota17 =!= 1, $CellContext`bota18 =!= 
          1, $CellContext`bota19 =!= 1, $CellContext`bota121 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
          N[$CellContext`botn]], $CellContext`bota123 = 1; $CellContext`botn = 
          0; If[$CellContext`ioutr == $CellContext`sim, 
           Print["Atenua\[CCedilla]\[ATilde]o suplementar colocada:  ", \
$CellContext`asup, " dB."]; $CellContext`pe = 
            10 Log[10, $CellContext`pew]; $CellContext`pr = $CellContext`pe + \
$CellContext`ge + $CellContext`Gr + $CellContext`grep - $CellContext`L0 - \
$CellContext`Aobst - $CellContext`aatmos - $CellContext`Age - \
$CellContext`Agr - $CellContext`asup; 
           Print["   A pot\[EHat]ncia de recep\[CCedilla]\[ATilde]o, em condi\
\[CCedilla]\[OTilde]es ideais de propaga\[CCedilla]\[ATilde]o, dada pela f\
\[OAcute]rmula de Friis \[EAcute]:\npr=", 
             $CellContext`numdb[$CellContext`pr], " dBW."]]]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
