\[CCedilla]o }}\n   Note que \[EAcute] necess\[AAcute]rio definir tro\
\[CCedilla]os, nem que seja apenas um, que cubra todos os pontos do \
perfil."]]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "C\[AAcute]lculo", " ", "das", " ", "reflex\[OTilde]es", "  "}]}],
      ButtonFunction:>($CellContext`pspd2 = 
        Table[0, {$CellContext`i, $CellContext`numfreq}]; $CellContext`s = 
        Table[{Part[$CellContext`ss, $CellContext`i, 
              1] $CellContext`divi - ($CellContext`divi - 1), 
           Part[$CellContext`ss, $CellContext`i, 
              2] $CellContext`divi - ($CellContext`divi - 1), 
           Part[$CellContext`ss, $CellContext`i, 3]}, {$CellContext`i, 
           Length[$CellContext`ss]}]; 
       For[$CellContext`freq = 1, $CellContext`freq <= $CellContext`numfreq, 
         Increment[$CellContext`freq], $CellContext`s1 = 
          1; $CellContext`ppsppd = 0; 
         For[$CellContext`j1 = 1, $CellContext`j1 <= $CellContext`passivo + 1, 
           Increment[$CellContext`j1], 
           
           For[$CellContext`i = $CellContext`p1[$CellContext`j1], \
$CellContext`i < $CellContext`p2[$CellContext`j1], 
            Increment[$CellContext`i], 
            If[Part[$CellContext`s, $CellContext`s1, 2] < $CellContext`i, 
              
              Increment[$CellContext`s1]]; $CellContext`t = (
               2 ($CellContext`ha1[$CellContext`j1] + 
                Part[$CellContext`href, 
                  $CellContext`p1[$CellContext`j1]] - $CellContext`hluis[
                 $CellContext`p1[$CellContext`j1], 
                 
                 Part[$CellContext`tabelatrocosvisiveis, $CellContext`freq, \
$CellContext`i, 1], 
                 
                 Part[$CellContext`tabelatrocosvisiveis, $CellContext`freq, \
$CellContext`i, 2]]))/(Part[$CellContext`s, $CellContext`s1, 3] 
              Part[$CellContext`d2, $CellContext`numpontos2]); \
$CellContext`rr = ($CellContext`ha2[$CellContext`j1] + Part[$CellContext`href, 
                 $CellContext`p2[$CellContext`j1]] - $CellContext`hluis[
                $CellContext`p2[$CellContext`j1], 
                
                Part[$CellContext`tabelatrocosvisiveis, $CellContext`freq, \
$CellContext`i, 1], 
                
                Part[$CellContext`tabelatrocosvisiveis, $CellContext`freq, \
$CellContext`i, 2]])/($CellContext`ha1[$CellContext`j1] + 
              Part[$CellContext`href, 
                $CellContext`p1[$CellContext`j1]] - $CellContext`hluis[
               $CellContext`p1[$CellContext`j1], 
               
               Part[$CellContext`tabelatrocosvisiveis, $CellContext`freq, \
$CellContext`i, 1], 
               
               Part[$CellContext`tabelatrocosvisiveis, $CellContext`freq, \
$CellContext`i, 2]]); $CellContext`ppsppd = If[
               
               Part[$CellContext`tabelatrocosvisiveis, $CellContext`freq, \
$CellContext`i, 3], 
               N[$CellContext`ppsppd + $CellContext`pspd[Part[$CellContext`d2, 
                    
                    Part[$CellContext`tabelatrocosvisiveis, \
$CellContext`freq, $CellContext`i, 1]]/Part[$CellContext`d, $CellContext`l], 
                  Part[$CellContext`d2, 
                    
                    Part[$CellContext`tabelatrocosvisiveis, \
$CellContext`freq, $CellContext`i, 2]]/Part[$CellContext`d, $CellContext`l], 
                  $CellContext`g1[$CellContext`i, $CellContext`j1], 
                  $CellContext`g2[$CellContext`i, $CellContext`j1]]], \
$CellContext`ppsppd]]]; 
         Print["O valor da rela\[CCedilla]\[ATilde]o \
\!\(\*FractionBox[\(ps\), \(pd\)]\) para a frequ\[EHat]ncia de ", 
           Part[$CellContext`f, $CellContext`freq], " GHz \[EAcute] de ", 
           $CellContext`numdb[10 Log[10, $CellContext`ppsppd]], " dB."]; 
         Part[$CellContext`pspd2, $CellContext`freq] = $CellContext`ppsppd]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236007078125*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

