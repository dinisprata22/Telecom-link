Cell[TextData[StyleBox["\t\t\t3.12.4  Cl\[AAcute]usula BBER ",
 FontColor->RGBColor[1, 1, 0]]], "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{" ", 
       RowBox[{"Par\[AHat]metros", "  ", 
        SubscriptBox["\[Alpha]", "1"], " ", "e", "  ", 
        SubscriptBox["\[Alpha]", "2"], " "}]}],
      ButtonFunction:>($CellContext`\[Alpha]11 = $CellContext`MyInput[
         "Introduza o valor do par\[AHat]metro alfa1 \nValor \
recomendado[10;30]", 30]; $CellContext`\[Alpha]22 = $CellContext`MyInput[
         "Introduza o valor do par\[AHat]metro alfa2 \nValor \
recomendado[1;10]", 1]; 
       Print["Par\[AHat]metro alfa1 : ", $CellContext`\[Alpha]11]; 
       Print["Par\[AHat]metro alfa2 : ", $CellContext`\[Alpha]22]),
      Enabled->True,
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 1]], 
    StyleBox[
     ButtonBox[
      RowBox[{" ", 
       RowBox[{"BBER", " ", 
        RowBox[{"c", "/", " ", "diversidade"}]}]}],
      ButtonFunction:>($CellContext`bbercndiv[
          Pattern[$CellContext`cn, 
           Blank[]]] := 
        Module[{$CellContext`Murber, $CellContext`murber, \
$CellContext`mrrber, $CellContext`Prber, $CellContext`sesr, \
$CellContext`mabs, $CellContext`\[Alpha]33, $CellContext`bber}, \
$CellContext`Murber = $CellContext`cn - $CellContext`CNrber; \
$CellContext`murber = 10^($CellContext`Murber/10); $CellContext`mrrber = 
           1/(1/$CellContext`murber + 
            1/$CellContext`Msdiv); $CellContext`Prber = \
$CellContext`kt[]/($CellContext`mrrber^2 $CellContext`idiv); \
$CellContext`sesr = $CellContext`sesrcndiv[$CellContext`cn]; \
$CellContext`mabs = 
           Abs[Log[10, $CellContext`rber/$CellContext`berSESR[]]/Log[
             10, $CellContext`Prber/$CellContext`sesr]]; \
$CellContext`\[Alpha]33 = 
           1; $CellContext`bber = $CellContext`sesr ($CellContext`\[Alpha]11/(
              2.8 $CellContext`\[Alpha]22 ($CellContext`mabs - 
               1))) + $CellContext`Nb[] $CellContext`rber/$CellContext`\
\[Alpha]33]; $CellContext`CNforBBERdiv = 
        Table[0, {$CellContext`a, $CellContext`numfreq}]; \
$CellContext`calcCNforBBER[
          Pattern[$CellContext`n, 
           Blank[]]] := Part[
          FindRoot[Part[
             $CellContext`bbercndiv[$CellContext`CN], $CellContext`n] == \
$CellContext`BBER, {$CellContext`CN, 40.}], 1, 2]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         Part[$CellContext`CNforBBERdiv, $CellContext`i] = \
$CellContext`calcCNforBBER[$CellContext`i]]; $CellContext`bberdiv = \
$CellContext`bbercndiv[$CellContext`cn]; 
       Print["Valor da norma BBER = ", $CellContext`BBER]; 
       For[$CellContext`i = 0, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         If[Part[$CellContext`bberdiv, $CellContext`i] <= $CellContext`BBER, 
          Print["f=", 
           Part[$CellContext`f, $CellContext`i], 
           " - Cl\[AAcute]usula cumprida, bber=", 
           Part[$CellContext`bberdiv, $CellContext`i]], 
          Print["f=", 
           Part[$CellContext`f, $CellContext`i], 
           " - Cl\[AAcute]usula n\[ATilde]o cumprida, bber=", 
           Part[$CellContext`bberdiv, $CellContext`i]]]]; 
       Print["A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do necess\
\[AAcute]ria para cumprir a cl\[AAcute]usula BBER \[EAcute] \
(\!\(\*FractionBox[\(C\), \(N\)]\)\!\(\*SubscriptBox[\()\), \(CIP_BBER\)]\)=", 
         $CellContext`numdb[$CellContext`CNforBBERdiv], " dB."]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236009453125*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

