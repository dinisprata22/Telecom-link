Cell[CellGroupData[{

Cell[TextData[StyleBox["\t2.1  Largura de banda em \
r\[AAcute]diofrequ\[EHat]ncia",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 StyleBox["Telefonia m\[UAcute]ltipla por divis\[ATilde]o na \
frequ\[EHat]ncia:",
  FontColor->GrayLevel[0.333333]],
 "\n\n\tAs caracter\[IAcute]sticas preferidas para os sinais de telefonia m\
\[UAcute]ltipla por divis\[ATilde]o na frequ\[EHat]ncia, onde se observam as \
frequ\[EHat]ncias m\[AAcute]ximas do sinal em banda de base ",
 Cell[BoxData[
  SubscriptBox["f", "m\[AAcute]x"]]],
 " , s\[ATilde]o dados na tabela 4.1, cap\[IAcute]tulo 4.2.2 de [1].\n\tPara \
sinais de telefonia m\[UAcute]ltipla por divis\[ATilde]o na frequ\[EHat]ncia, \
o desvio eficaz de frequ\[EHat]ncia por canal   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]f", "ef"], TraditionalForm]]],
 "  para um sinal de 1 mW a 800 Hz, no ponto de n\[IAcute]vel zero, \[EAcute] \
dado na tabela 4.5, cap\[IAcute]tulo 4.3 de [1].\n\n",
 StyleBox["Video:",
  FontColor->GrayLevel[0.333333]],
 "\n\n\tEm sistemas novos, a ITU-R recomenda a utiliza\[CCedilla]\[ATilde]o \
de 525 ou 625 linhas, com a adop\[CCedilla]\[ATilde]o das normas NTSC, PAL ou \
SECAM para televis\[ATilde]o a cores.\n\tNos pontos de \
jun\[CCedilla]\[ATilde]o video, cuja imped\[AHat]ncia dever\[AAcute] ser de \
75 Ohm assim\[EAcute]trica (em rela\[CCedilla]\[ATilde]o \[AGrave] Terra) ou \
124 Ohm sim\[EAcute]trica, a amplitude nominal do sinal aqui definida como \
amplitude pico-a-pico nominal da componente monocrom\[AAcute]tica (sinal \
resultante da soma dos sinais de sincronismo mais o sinal de \
lumin\[AHat]ncia) \[EAcute] de 1 Volt.\n\tA largura de banda nominal do sinal \
de video varia, para os sistemas usuais, entre 5 e 6 MHz.\n\n\n\tNota:\tA \
largura de banda calculada \[EAcute] a de Nyquist, n\[ATilde]o a largura de \
banda ocupada na realidade."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Caracter\[IAcute]sticas", " ", "do", " ", "sinal", "  "}]}],
      ButtonFunction:>If[$CellContext`bota123 =!= 1, 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], 
        If[$CellContext`bota20 =!= 1, 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
          N[$CellContext`botn]], 
         If[$CellContext`analog == $CellContext`telefonia, \
$CellContext`ncanal = $CellContext`MyInput[
             "Introduza o n\[UAcute]mero de canais telef\[OAcute]nicos", \
$CellContext`ncanal]; $CellContext`\[Sigma]voz = $CellContext`MyInput[
             "Introduza o desvio padr\[ATilde]o da pot\[EHat]ncia da voz em \
[dB]", $CellContext`\[Sigma]voz]; $CellContext`\[Tau]act = \
$CellContext`MyInput[
             "Introduza o \[IAcute]ndice de actividade \[AGrave] hora de \
ponta", $CellContext`\[Tau]act]; $CellContext`ftmax = $CellContext`MyInput[
             "Introduza a frequ\[EHat]ncia m\[AAcute]xima do sinal de banda \
de base em [MHz].\nAconselha-se a consulta da tabela 4.1, cap. 4.2.2 [1].", \
$CellContext`ftmax]; $CellContext`\[CapitalDelta]ftef = $CellContext`MyInput[
             "Introduza o desvio eficaz de frequ\[EHat]ncia por canal em \
[MHz].\nAconselha-se a consulta da tabela 4.5, cap. 4.3 [1].", $CellContext`\
\[CapitalDelta]ftef]; $CellContext`bts = $CellContext`MyInput[
             "Introduza a largura de banda do canal telef\[OAcute]nico em \
[MHz].", $CellContext`bts]]; 
         If[$CellContext`analog == $CellContext`video, $CellContext`\
\[CapitalDelta]fvmax = $CellContext`MyInput[
             "Introduza a frequ\[EHat]ncia m\[AAcute]xima de desvio da \
portadora em [MHz].\nAconselha-se a consulta do cap. 4.2.4 [1].", \
$CellContext`\[CapitalDelta]fvmax]; $CellContext`fvmax = $CellContext`MyInput[
             "Introduza a frequ\[EHat]ncia m\[AAcute]xima do sinal de banda \
de base em [MHz].\nAconselha-se a consulta do cap. 4.2.4 [1].", \
$CellContext`fvmax]; $CellContext`bvs = $CellContext`MyInput[
             "Introduza a largura de banda do sinal de video em [MHz].", \
$CellContext`bvs]]]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Largura", " ", "de", " ", "Banda", "  "}]}],
      ButtonFunction:>If[$CellContext`bota123 =!= 1, 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], 
        If[$CellContext`bota20 =!= 1, 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 2.", 
          N[$CellContext`botn]], $CellContext`bota21 = 1; $CellContext`botn = 
          3; If[$CellContext`analog == $CellContext`telefonia, 
           Print["N\[UAcute]mero de canais introduzido:  n= ", \
$CellContext`ncanal, " canais."]; 
           Print["Desvio padr\[ATilde]o da pot\[EHat]ncia da voz introduzido: \
 \[Sigma]=", 
             $CellContext`numdb[$CellContext`\[Sigma]voz], " dB."]; 
           Print["\[CapitalIAcute]ndice de actividade \[AGrave] hora de \
ponta:  \[Tau]= ", $CellContext`\[Tau]act, " ."]; $CellContext`pm = 
            Which[$CellContext`ncanal <= 60, 2.6 + 
              2 Log[10, $CellContext`ncanal], $CellContext`ncanal <= 240, -1 + 
              4 Log[10, $CellContext`ncanal], $CellContext`ncanal > 240, -15 + 
              10 Log[10, $CellContext`ncanal]]; 
           Print["   A pot\[EHat]ncia m\[EAcute]dia do sinal \
telef\[OAcute]nico \[EAcute] pm=", 
             $CellContext`numdb[
              N[$CellContext`pm]], " dBm0."]; $CellContext`\[CapitalDelta]c = 
            10.5 + 40 $CellContext`\[Sigma]voz/($CellContext`ncanal \
$CellContext`\[Tau]act + 5 (2 $CellContext`\[Sigma]voz)^Rational[1, 2]); 
           Print["   O factor de pico multicanal \[EAcute] \[CapitalDelta]c=", 
             $CellContext`numdb[$CellContext`\[CapitalDelta]c], 
             " dB."]; $CellContext`pmx = $CellContext`pm + $CellContext`\
\[CapitalDelta]c; 
           Print["   A pot\[EHat]ncia m\[AAcute]xima  do sinal de multiplex \
\[EAcute] pmx=", 
             $CellContext`numdb[$CellContext`pmx], " dBm0."]; 
           Print["Frequ\[EHat]ncia m\[AAcute]xima do  sinal de banda de base: \
 \!\(\*SubscriptBox[\(f\), \(max\)]\)=", 
             $CellContext`numhz[$CellContext`ftmax], " MHz."]; 
           Print["Desvio eficaz de frequ\[EHat]ncia  por canal:  \
\!\(\*SubscriptBox[\(\[CapitalDelta]f\), \(ef\)]\)=", 
             $CellContext`numhz[$CellContext`\[CapitalDelta]ftef], " MHz."]; 
           Print["Largura de banda do canal telef\[OAcute]nico:  \
\!\(\*SubscriptBox[\(b\), \(s\)]\)=", 
             $CellContext`numhz[$CellContext`bts], 
             " MHz."]; $CellContext`fc = $CellContext`ftmax - \
$CellContext`bts/2; 
           Print["   A frequ\[EHat]ncia m\[EAcute]dia do canal \[EAcute] fc=", 
             $CellContext`numhz[$CellContext`fc], " MHz."]; $CellContext`fr = 
            1.25 $CellContext`ftmax; 
           Print["   A frequ\[EHat]ncia de resson\[AHat]ncia do circuito da \
acentua\[CCedilla]\[ATilde]o \[EAcute] fr=", 
             $CellContext`numhz[$CellContext`fr], 
             " MHz."]; $CellContext`\[CapitalDelta]ftmax = $CellContext`\
\[CapitalDelta]ftef 10^($CellContext`pmx/20); 
           Print["   A frequ\[EHat]ncia m\[AAcute]xima de desvio da portadora \
\[EAcute] \!\(\*SubscriptBox[\(\[CapitalDelta]f\), \(max\)]\)=", 
             $CellContext`numhz[$CellContext`\[CapitalDelta]ftmax], 
             " MHz."]; $CellContext`brf = 
            2 ($CellContext`\[CapitalDelta]ftmax + $CellContext`ftmax); 
           Print["   A largura de banda em r\[AAcute]diofrequ\[EHat]ncia (f\
\[OAcute]rmula de Carson) \[EAcute] brf=", 
             $CellContext`numhz[$CellContext`brf], " MHz."]]; 
         If[$CellContext`analog == $CellContext`video, 
           Print["Frequ\[EHat]ncia m\[AAcute]xima de desvio da portadora: \
(StyleBox[\[CapitalDelta]f\!\(\*\nStyleBox[\"v\",\n\
Background->None]\)]\!\(\*SubscriptBox[\()\), \(max\)]\)=", 
             $CellContext`numhz[$CellContext`\[CapitalDelta]fvmax], " MHz."]; 
