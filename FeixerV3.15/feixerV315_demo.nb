          Print["A pondera\[CCedilla]\[ATilde]o introduzida: ", 
            $CellContext`numdb[$CellContext`pondt], 
            " dB."]; $CellContext`acent = 
           5 - 10 Log[
             10, 1 + 6.9/(1 + 
               5.25/($CellContext`fr/$CellContext`fc - \
$CellContext`fc/$CellContext`fr)^2)]; 
          Print["   A acentua\[CCedilla]\[ATilde]o \[EAcute] de ", 
            $CellContext`numdb[$CellContext`acent], 
            " dB."]; $CellContext`SNbf = $CellContext`cn + 
