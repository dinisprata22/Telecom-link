Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"  O di\[AHat]metro da antena principal \[EAcute] de \"\>", 
   "\[InvisibleSpace]", "1.5`", 
   "\[InvisibleSpace]", "\<\" m, sendo o seu rendimento de \[Eta]p= \"\>", 
