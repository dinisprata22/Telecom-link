     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Ritmo", " ", "bin\[AAcute]rio", "  "}]}],
      ButtonFunction:>($CellContext`fb = $CellContext`MyInput[
         "Introduza o ritmo bin\[AAcute]rio em [Mbits/s].\nAconselha-se a \
consulta do cap. 5.5.1 [1].", $CellContext`fb]; $CellContext`largurab = \
$CellContext`MyInput[
         "Introduza a largura de banda poss\[IAcute]vel na banda descriminada \
para a transmiss\[ATilde]o em [MHz].\nAconselha-se a consulta do Anexo A [1].\
\nNo caso de fazer um varrimento de frequ\[EHat]ncias, coloque-as com o \
seguinte formato:\n   ex: 3 frequ\[EHat]ncias => {20,30,40} MHz", \
$CellContext`largurab]; $CellContext`\[Beta]exb = $CellContext`MyInput[
         "Introduza o factor de excesso de banda do filtro de Nyquist.\n\
Valores compreendidos entre 0.1 e 0.5 .", $CellContext`\[Beta]exb]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "N\[UAcute]mero", " ", "m\[IAcute]nimo", " ", "de", " ", 
        "n\[IAcute]veis", " ", "por", " ", "palavra", "  "}]}],
      ButtonFunction:>($CellContext`bota31 = 1; 
       Print["Ritmo bin\[AAcute]rio:  \!\(\*SubscriptBox[\(f\), \(b\)]\)= ", \
$CellContext`fb, " Mbits/s."]; 
       Print["Largura de banda para a transmiss\[ATilde]o:  \
\!\(\*SubscriptBox[\(largura\), \(b\)]\)= ", $CellContext`largurab, " MHz."]; 
       Print["Factor de excesso de banda:  \[Beta]=", 
         $CellContext`numhz[$CellContext`\[Beta]exb], 
