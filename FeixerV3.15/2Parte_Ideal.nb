Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.2  Frequ\[EHat]ncia da liga\[CCedilla]\[ATilde]o",
 
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tO Feixer permite fazer varrimento de bandas de frequ\[EHat]ncia. Aten\
\[CCedilla]\[ATilde]o contudo, que se desejar um varrimento diferente do dado \
por omiss\[ATilde]o, ao valor inicial e final do vector de frequ\[EHat]ncias. \
O valor das bandas n\[ATilde]o pode estar abaixo de 1.7 GHz e acima de 27 \
GHz, devido \[AGrave] limita\[CCedilla]\[ATilde]o imposta pelos guias \
existentes em cat\[AAcute]logo.\
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Varrimento", " ", "de", " ", "frequ\[EHat]ncia", "  "}]}],
      ButtonFunction:>If[$CellContext`botaII =!= 1, 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Ter\[AAcute] que introduzir o ficheiro \
de entrada, na sec\[CCedilla]\[ATilde]o II."], 
        If[
         Or[$CellContext`bota111 =!= 1, $CellContext`bota112 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
          
          N[$CellContext`botn]], $CellContext`fr1 = $CellContext`MyInput[
           "Introduza a frequ\[EHat]ncia de varrimento inicial (\
\[GreaterEqual] 1.7) em [GHz]", $CellContext`fr1]; $CellContext`frinc = \
$CellContext`MyInput[
           "Introduza o incremento (zero para n\[ATilde]o ter varrimento) de \
frequ\[EHat]ncia em [GHz]", $CellContext`frinc]; 
         If[$CellContext`frinc =!= 
           0, $CellContext`fr2 = $CellContext`MyInput[
            "   Introduza a frequ\[EHat]ncia de varrimento final \
(\[LessEqual] 27) em [GHz]", $CellContext`fr2]]]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Frequ\[EHat]ncia", " ", "de", " ", "trabalho", "  "}]}],
      ButtonFunction:>If[$CellContext`botaII =!= 1, 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Ter\[AAcute] que introduzir o ficheiro \
de entrada, na sec\[CCedilla]\[ATilde]o II."], 
        If[
         Or[$CellContext`bota111 =!= 1, $CellContext`bota112 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
          N[$CellContext`botn]], $CellContext`bota12 = 1; $CellContext`botn = 
          3; Print["Frequ\[EHat]ncia inicial:  ", $CellContext`fr1, " GHz."]; 
         Print["Incremento de frequ\[EHat]ncia:  ", $CellContext`frinc, 
           " GHz."]; If[$CellContext`frinc =!= 0, 
           Print[
           "Frequ\[EHat]ncia final:  ", $CellContext`fr2, 
            " GHz."]]; $CellContext`f = 
          If[$CellContext`frinc == 0, $CellContext`numfreq = 1; 
            Table[$CellContext`i, {$CellContext`i, $CellContext`fr1, \
$CellContext`fr1}], $CellContext`numfreq = 
             Floor[($CellContext`fr2 - $CellContext`fr1)/$CellContext`frinc] + 
              1; Table[$CellContext`i, {$CellContext`i, $CellContext`fr1, \
$CellContext`fr2, $CellContext`frinc}]]; If[$CellContext`frinc == 0, 
           Print[
           "A frequ\[EHat]ncia de utiliza\[CCedilla]\[ATilde]o \[EAcute] f= ", 
            $CellContext`numhz[$CellContext`f], " GHz."]]; 
         If[$CellContext`frinc =!= 0, 
           Print[
           "S\[ATilde]o ", $CellContext`numfreq, 
            " as frequ\[EHat]ncias em utiliza\[CCedilla]\[ATilde]o:\nf=", 
            $CellContext`numhz[$CellContext`f], 
            " GHz."]]; $CellContext`fhz = $CellContext`f 
           10^9; $CellContext`fMhz = $CellContext`f 10^3; $CellContext`cluz = 
          299792458; $CellContext`\[Lambda] = 
          N[$CellContext`cluz/$CellContext`fhz]; If[$CellContext`frinc == 0, 
           Print[
           "O comprimento de onda em utiliza\[CCedilla]\[ATilde]o \[EAcute] \
\[Lambda]=", 
            $CellContext`numhz[$CellContext`\[Lambda]], " m."]]; 
         If[$CellContext`frinc =!= 0, 
           Print[
           "Os comprimentos de onda em utiliza\[CCedilla]\[ATilde]o \
s\[ATilde]o:\n\[Lambda]=", 
            $CellContext`numhz[$CellContext`\[Lambda]], " m."]]]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.51523600596875*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

