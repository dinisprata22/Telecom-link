Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.7  Distribui\[CCedilla]\[ATilde]o da \
indisponibilidade",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tComprimentos m\[AAcute]ximos das sec\[CCedilla]\[OTilde]es \
r\[AAcute]dioel\[EAcute]ctricas e objectivos de indisponibilidade para cada \
uma das classes de qualidade de liga\[CCedilla]\[ATilde]o r\[AAcute]dioel\
\[EAcute]ctrica, nos termos da recomenda\[CCedilla]\[ATilde]o F.696-2 da \
ITU-R.\n\n\t\t\t\t\t",
 Cell[BoxData[
  StyleBox[GridBox[{
     {"Classe", 
      RowBox[{"Comprimento", "  ", "[", "km", "]"}], 
      RowBox[{"Indisponibilidade", "  ", "[", "%", "]"}]},
     {
      StyleBox["1",
       FontWeight->"Bold",
       FontColor->GrayLevel[0]], 
      StyleBox["280",
       FontWeight->"Bold",
       FontColor->GrayLevel[0]], 
      StyleBox["0.033",
       FontWeight->"Bold",
       FontColor->GrayLevel[0]]},
     {"2", "280", "0.05"},
     {"3", "50", "0.05"},
     {"4", "50", "0.1"}
    },
    GridBoxDividers->{
     "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
      "RowsIndexed" -> {}}],
   FontFamily->"Verdana",
   FontSize->11]]],
 "\n\t\t\t\t\t\n\n\tNo sentido da despenaliza\[CCedilla]\[ATilde]o das liga\
\[CCedilla]\[OTilde]es muito curtas, a recomenda\[CCedilla]\[ATilde]o F.695 \
da ITU-R sugere limitar o valor da dist\[AHat]ncia de \
liga\[CCedilla]\[ATilde]o (dkm)",
 "  ao m\[IAcute]nimo de 280",
 ".\n\tCompete ao projectista da liga\[CCedilla]\[ATilde]o distribuir a \
indisponibilidade total pelas diferentes causas."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Comprimento", " ", "da", " ", "liga\[CCedilla]\[ATilde]o", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
