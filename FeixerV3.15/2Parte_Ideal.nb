             "(C/N)nec da cl\[AAcute]usula SESR", FontSize -> 11, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[1, 0, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
               Part[$CellContext`f, 1]), $CellContext`ymin + 4}]], 
           Graphics[
            Text[
