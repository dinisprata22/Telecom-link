           Print["O tempo m\[EAcute]dio entre avarias do comutador 1+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador1\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador1], 
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador1]; 
         If[$CellContext`elementos == 
           2, $CellContext`MTBFcomutador2 = $CellContext`MyInput[
             "Introduza o tempo m\[EAcute]dio entre avarias do comutador 2+1 \
em [horas]", 78000]; 
           Print["O tempo m\[EAcute]dio entre avarias do comutador 2+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador2\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador2], 
             
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador2]; 
         If[$CellContext`elementos == 
           3, $CellContext`MTBFcomutador3 = $CellContext`MyInput[
             "Introduza o tempo m\[EAcute]dio entre avarias do comutador 3+1 \
em [horas]", 72000]; 
           Print["O tempo m\[EAcute]dio entre avarias do comutador 3+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador3\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador3], 
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador3]; 
         If[$CellContext`elementos == 
           4, $CellContext`MTBFcomutador4 = $CellContext`MyInput[
             "Introduza o tempo m\[EAcute]dio entre avarias do comutador 4+1 \
em [horas]", 67000]; 
           Print["O tempo m\[EAcute]dio entre avarias do comutador 4+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador4\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador4], 
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador4]; If[
           
           And[$CellContext`elementos != 1, $CellContext`elementos != 
            2, $CellContext`elementos != 3, $CellContext`elementos != 4], 
           Print[
           "Aten\[CCedilla]\[ATilde]o -> Coloque 1, 2, 3 ou 4 elementos \
emissor/receptor."]]; $CellContext`MTBFcomut = $CellContext`MTBFcomutador/2; 
         Print["   Tempo m\[EAcute]dio entre avarias dos comutadores, numa \
liga\[CCedilla]\[ATilde]o bidireccional:  \!\(\*SubscriptBox[\(MTBF\), \
\(comut\)]\)= ", 
