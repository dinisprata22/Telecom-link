       If[Length[$CellContext`mniveis] == 
         0, $CellContext`numniveis = $CellContext`mniveis; \
$CellContext`mniveis = 
          Table[$CellContext`numniveis, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`brf = ($CellContext`fb/Log[
            2, $CellContext`mniveis]) (1 + $CellContext`\[Beta]exb)]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
