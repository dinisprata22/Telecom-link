Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.5  Atenua\[CCedilla]\[ATilde]o de \
obst\[AAcute]culo",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tCom vista \[AGrave] poss\[IAcute]vel necessidade de implantar um ou mais \
repetidores no projecto, o Feixer encontra o ponto a que corresponde o obst\
\[AAcute]culo principal, que deve ser visualizado pela defini\[CCedilla]\
\[ATilde]o geom\[EAcute]trica do obst\[AAcute]culo.\n\n\tNo projecto da liga\
\[CCedilla]\[ATilde]o podemos optar por tr\[EHat]s processos de calcular a \
atenua\[CCedilla]\[ATilde]o de obst\[AAcute]culo:\n\n\t\t",
 StyleBox["1.",
  FontWeight->"Bold"],
 " Segundo a Norma 526-7 da ITU-R (aplic\[AAcute]vel para terreno irregular),\
\n\t\n\t\t",
 StyleBox["2.",
  FontWeight->"Bold"],
 " Atenua\[CCedilla]\[ATilde]o calculada segundo o m\[EAcute]todo do Obst\
\[AAcute]culo em L\[AHat]mina,\n\t\n\t\t",
 StyleBox["3.",
  FontWeight->"Bold"],
 " Atenua\[CCedilla]\[ATilde]o calculada segundo o m\[EAcute]todo de Deygout.",
 StyleBox["\n\n",
  FontColor->RGBColor[1, 0, 0]],
 "\tUsando um dos bot\[OTilde]es obteremos a atenua\[CCedilla]\[ATilde]o \
segundo o m\[EAcute]todo pretendido."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{
      "Defini\[CCedilla]\[ATilde]o", " ", "geom\[EAcute]trica", "  "}]}],
     ButtonFunction:>If[
       Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
        1, $CellContext`bota14 =!= 1], 
       Print[
       "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
        N[$CellContext`botn]], $CellContext`bota15 = 1; $CellContext`botn = 
        6; $CellContext`h1 = 
        Part[$CellContext`h, 1] + $CellContext`hae; $CellContext`h2 = 
        Part[$CellContext`h, $CellContext`l] + $CellContext`har; \
$CellContext`aobst = $CellContext`aten526[
         1, $CellContext`l]; $CellContext`obstaculo = 
        If[$CellContext`aobst == 
          Table[0., {$CellContext`i, $CellContext`numfreq}], 
          Print["O percurso n\[ATilde]o tem obst\[AAcute]culo."]; \
$CellContext`Aobst = 0; 
          False, $CellContext`vertprinc = 
           ListPlot[{{
              Part[$CellContext`d, $CellContext`lp]/$CellContext`km, 
               Part[$CellContext`h, 1] + $CellContext`hae - ((
                 Part[$CellContext`d, $CellContext`lp] - 
                 Part[$CellContext`d, 1])/(
                Part[$CellContext`d, $CellContext`l] - 
                Part[$CellContext`d, 1])) (
                Part[$CellContext`h, 1] + $CellContext`hae - 
                Part[$CellContext`h, $CellContext`l] - $CellContext`har)}, {
              Part[$CellContext`d, $CellContext`lp]/$CellContext`km, 
               Part[$CellContext`h, $CellContext`lp]}}, Joined -> True, 
             DisplayFunction -> Identity]; $CellContext`emirep = 
           ListPlot[{{
              Part[$CellContext`d, 1]/$CellContext`km, 
               Part[$CellContext`h, 1] + $CellContext`hae}, {
              Part[$CellContext`d, $CellContext`lp]/$CellContext`km, 
               Part[$CellContext`h, $CellContext`lp]}}, Joined -> True, 
             DisplayFunction -> Identity]; $CellContext`reprec = 
           ListPlot[{{Part[$CellContext`d, $CellContext`lp]/$CellContext`km, 
               Part[$CellContext`h, $CellContext`lp]}, {
              Part[$CellContext`d, $CellContext`l]/$CellContext`km, 
               Part[$CellContext`h, $CellContext`l] + $CellContext`har}}, 
             Joined -> True, DisplayFunction -> 
             Identity]; $CellContext`graficobst1 = 
           Show[$CellContext`grafico2, $CellContext`vertprinc, \
$CellContext`emirep, $CellContext`reprec, 
             Graphics[
              Text[
               StyleForm[
                Part[$CellContext`hin, $CellContext`lp], FontSize -> 11], {
               Part[$CellContext`d, $CellContext`lp]/$CellContext`km, 
                Part[$CellContext`h, $CellContext`lp] + 40}]], 
             Graphics[
              Text[
               StyleForm[{$CellContext`lp}, FontSize -> 11], {
               Part[$CellContext`d, $CellContext`lp]/$CellContext`km, 
                Part[$CellContext`h, $CellContext`lp] + 15}]], 
             DisplayFunction -> Identity]; 
          If[$CellContext`lp1 =!= 
            1, $CellContext`vertsec1 = 
             ListPlot[{{
                Part[$CellContext`d, $CellContext`lp1]/$CellContext`km, 
                 Part[$CellContext`h, 1] + $CellContext`hae - ((
                   Part[$CellContext`d, $CellContext`lp1] - 
                   Part[$CellContext`d, 1])/(
                  Part[$CellContext`d, $CellContext`lp] - 
                  Part[$CellContext`d, 1])) (
                  Part[$CellContext`h, 1] + $CellContext`hae - 
                  Part[$CellContext`h, $CellContext`lp])}, {
                Part[$CellContext`d, $CellContext`lp1]/$CellContext`km, 
                 Part[$CellContext`h, $CellContext`lp1]}}, Joined -> True, 
               DisplayFunction -> Identity]; $CellContext`graficobst1 = 
             Show[$CellContext`graficobst1, $CellContext`vertsec1, 
               Graphics[
                Text[
                 StyleForm[{$CellContext`lp1}, FontSize -> 11], {
                 Part[$CellContext`d, $CellContext`lp1]/$CellContext`km, 
                  Part[$CellContext`h, $CellContext`lp1] + 15}]], 
               Graphics[
                Text[
                 StyleForm[
                  Part[$CellContext`hin, $CellContext`lp1], FontSize -> 11], {
                 Part[$CellContext`d, $CellContext`lp1]/$CellContext`km, 
                  Part[$CellContext`h, $CellContext`lp1] + 40}]]]]; 
          If[$CellContext`lp2 =!= 
            1, $CellContext`vertsec2 = 
             ListPlot[{{
                Part[$CellContext`d, $CellContext`lp2]/$CellContext`km, 
                 Part[$CellContext`h, $CellContext`lp] - ((
                   Part[$CellContext`d, $CellContext`lp2] - 
                   Part[$CellContext`d, $CellContext`lp])/(
                  Part[$CellContext`d, $CellContext`l] - 
                  Part[$CellContext`d, $CellContext`lp])) (
                  Part[$CellContext`h, $CellContext`lp] - 
                  Part[$CellContext`h, $CellContext`l] - $CellContext`har)}, {
                Part[$CellContext`d, $CellContext`lp2]/$CellContext`km, 
                 Part[$CellContext`h, $CellContext`lp2]}}, Joined -> True, 
               DisplayFunction -> Identity]; $CellContext`graficobst1 = 
             Show[$CellContext`graficobst1, $CellContext`vertsec2, 
               Graphics[
                Text[
                 StyleForm[{$CellContext`lp2}, FontSize -> 11], {
                 Part[$CellContext`d, $CellContext`lp2]/$CellContext`km, 
                  Part[$CellContext`h, $CellContext`lp2] + 15}]], 
               Graphics[
                Text[
                 StyleForm[
                  Part[$CellContext`hin, $CellContext`lp2], FontSize -> 11], {
                 Part[$CellContext`d, $CellContext`lp2]/$CellContext`km, 
                  Part[$CellContext`h, $CellContext`lp2] + 
                  40}]]]]; $CellContext`graficobst2 = 
           Show[$CellContext`graficobst1, 
             Graphics[
              Text[
               StyleForm["Legenda: cota [m]", FontSize -> 11], {
               Part[$CellContext`d, 
                  Ceiling[$CellContext`l/3]]/$CellContext`km, 
                Part[$CellContext`h, $CellContext`mh] + 80}]], 
             Graphics[
              Text[
               StyleForm["       {ponto}", FontSize -> 11], {
               Part[$CellContext`d, 
                  Ceiling[$CellContext`l/3]]/$CellContext`km, 
                Part[$CellContext`h, $CellContext`mh] + 55}]], 
             PlotRange -> {{0, $CellContext`dkm}, {
               0, Part[$CellContext`h, $CellContext`mh] + 100}}, 
             DisplayFunction -> $DisplayFunction]; True]; 
       Print[$CellContext`graficobst2]; 
       If[$CellContext`obstaculo, $CellContext`obsta1 = $CellContext`lp; \
$CellContext`obsta2 = $CellContext`lp1; $CellContext`obsta3 = \
$CellContext`lp2; 
         Print["O obst\[AAcute]culo principal est\[AAcute] \[AGrave] dist\
\[AHat]ncia de ", 
           Part[$CellContext`in, $CellContext`lp, 1], 
           " km, a que corresponde o ponto ", $CellContext`lp, 
           " dos ", $CellContext`l, " do ficheiro de entrada."]; 
         If[$CellContext`lp1 =!= 1, 
           Print[
           "O 1\.ba obst\[AAcute]culo secund\[AAcute]rio est\[AAcute] \
\[AGrave] dist\[AHat]ncia de ", 
            Part[$CellContext`in, $CellContext`lp1, 1], 
            " km, a que corresponde o ponto ", $CellContext`lp1, "."]]; 
         If[$CellContext`lp2 =!= 1, 
           Print[
           "O 2\.ba obst\[AAcute]culo secund\[AAcute]rio est\[AAcute] \
\[AGrave] dist\[AHat]ncia de ", 
            Part[$CellContext`in, $CellContext`lp2, 1], 
            " km, a que corresponde o ponto ", $CellContext`lp2, "."]]]],
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"M\[EAcute]todo", " ", "1", "  "}]}],
     ButtonFunction:>If[
       Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
        1, $CellContext`bota14 =!= 1], 
       Print[
       "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
        N[$CellContext`botn]], $CellContext`botn = 6; 
       If[$CellContext`bota15 == 
         1, $CellContext`h1 = 
          Part[$CellContext`h, 1] + $CellContext`hae; $CellContext`h2 = 
          Part[$CellContext`h, $CellContext`l] + $CellContext`har; \
$CellContext`Aobst = $CellContext`aten526[1, $CellContext`l]; 
         If[$CellContext`lp == 0, $CellContext`Aobst = 0]; 
         Print["Atenua\[CCedilla]\[ATilde]o de obst\[AAcute]culo calculada \
pelo m\[EAcute]todo 1, entre a antena emissora e receptora:\nAobst=", 
           $CellContext`numdb[$CellContext`Aobst], " dB."]]],
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"M\[EAcute]todo", " ", "2", "  "}]}],
     ButtonFunction:>If[
       Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
        1, $CellContext`bota14 =!= 1], 
       Print[
       "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
        N[$CellContext`botn]], $CellContext`botn = 6; 
       If[$CellContext`bota15 == 
         1, $CellContext`h1 = 
          Part[$CellContext`h, 1] + $CellContext`hae; $CellContext`h2 = 
          Part[$CellContext`h, $CellContext`l] + $CellContext`har; \
$CellContext`Aobst = $CellContext`atenlamina[1, $CellContext`l]; 
         If[$CellContext`lp == 0, $CellContext`Aobst = 0]; 
         Print["Atenua\[CCedilla]\[ATilde]o de obst\[AAcute]culo calculada \
pelo m\[EAcute]todo 2, entre a antena emissora e receptora:\nAobst=", 
           $CellContext`numdb[$CellContext`Aobst], " dB."]]],
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"M\[EAcute]todo", " ", "3", "  "}]}],
     ButtonFunction:>If[
       Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
        1, $CellContext`bota14 =!= 1], 
       Print[
       "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
        N[$CellContext`botn]], $CellContext`botn = 6; 
       If[$CellContext`bota15 == 
         1, $CellContext`Aobst = $CellContext`atendeygout[
           1, $CellContext`l, 0]; 
         If[$CellContext`lp == 0, $CellContext`Aobst = 0]; 
         Print["Atenua\[CCedilla]\[ATilde]o de obst\[AAcute]culo calculada \
pelo m\[EAcute]todo 3, entre a antena emissora e receptora:\nAobst=", 
           $CellContext`numdb[$CellContext`Aobst], " dB."]]],
     Evaluator->Automatic]}
  }]],
