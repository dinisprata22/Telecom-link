Cell[TextData[StyleBox["\tO desvanecimento r\[AAcute]pido \[EAcute] calculado \
usando o segundo m\[EAcute]todo da Recomenda\[CCedilla]\[ATilde]o P.530-8 da \
ITU-R (cap\[IAcute]tulo 3.3 [1]).\t\n\t\t",
 FontFamily->"Verdana",
 FontSize->11]], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Dist\[AHat]ncia", " ", "da", " ", "liga\[CCedilla]\[ATilde]o", 
        "  "}]}],
      ButtonFunction:>($CellContext`dliga = $CellContext`MyInput[
        "Introduza a dist\[AHat]ncia da liga\[CCedilla]\[ATilde]o em [km]", \
$CellContext`dliga]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Desvanecimento", " ", "da", " ", "liga\[CCedilla]\[ATilde]o", "  "}]}],
      ButtonFunction:>($CellContext`bota37 = 1; $CellContext`botn = 81/10; 
       If[$CellContext`passivo == 0, $CellContext`obsta1 = $CellContext`l]; 
       Print["Dist\[AHat]ncia da liga\[CCedilla]\[ATilde]o introduzida:  ", \
$CellContext`dliga, " km."]; $CellContext`\[Epsilon]pkt = 
        If[Part[$CellContext`d, $CellContext`obsta1] - 
           Part[$CellContext`d, 1] > 
          Part[$CellContext`d, $CellContext`l] - 
           Part[$CellContext`d, $CellContext`obsta1], (
           Part[$CellContext`h, 1] - 
           Part[$CellContext`h, $CellContext`obsta1])/(
          Part[$CellContext`d, $CellContext`obsta1] - 
          Part[$CellContext`d, 1]), (Part[$CellContext`h, $CellContext`l] - 
           Part[$CellContext`h, $CellContext`obsta1])/(
          Part[$CellContext`d, $CellContext`l] - 
          Part[$CellContext`d, $CellContext`obsta1])]; $CellContext`kt[] := \
(($CellContext`kgeo $CellContext`dliga^3.6) $CellContext`f^0.89) (1 + 
           Abs[$CellContext`\[Epsilon]pkt])^(-1.4); 
       Print["   O factor de ocorr\[EHat]ncia de desvanecimento profundo \
\[EAcute]:\n   kt=", 
         $CellContext`num5c[
          $CellContext`kt[]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.51523600853125*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

