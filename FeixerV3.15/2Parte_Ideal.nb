          Module[{$CellContext`\[Eta], $CellContext`n, $CellContext`\[Tau], \
$CellContext`Ts, $CellContext`Kn, $CellContext`Psmp, $CellContext`ms}, \
$CellContext`\[Eta] = 1 - E^((-0.2) $CellContext`kt[]^(3/4)); $CellContext`n = 
             1.4; $CellContext`\[Tau] = 
             0.7 ($CellContext`dkm/50)^$CellContext`n; $CellContext`Ts = 
             Log[2, $CellContext`mniveis]/($CellContext`fb 
              10^6); $CellContext`Kn = 
             Table[0., {$CellContext`x, $CellContext`numfreq}]; 
            For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
              Increment[$CellContext`i], 
              Part[$CellContext`Kn, $CellContext`i] = Switch[
                N[
                 Part[$CellContext`mniveis, $CellContext`i]], 4., 1., 8., 7., 
                16., 5.5, 64., 15.4]]; $CellContext`Psmp = (
               2.16 $CellContext`Kn) ((
                2 ($CellContext`\[Tau]/
                  10^9)^2)/$CellContext`Ts^2); $CellContext`ms = \
$CellContext`kt[]/($CellContext`\[Eta] $CellContext`Psmp)]; 
