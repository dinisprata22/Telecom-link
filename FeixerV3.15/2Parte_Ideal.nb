($CellContext`fb/$CellContext`largurab)); 
       Print["O n\[UAcute]mero m\[IAcute]nimo de n\[IAcute]veis na modula\
\[CCedilla]\[ATilde]o \[EAcute] de ", 
         $CellContext`numdb[$CellContext`mnivel], 
         " por palavra de c\[OAcute]digo."]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
