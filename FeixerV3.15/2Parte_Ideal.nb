     ButtonBox[
      RowBox[{" ", 
       RowBox[{
       "Indisponibilidade", " ", "devido", " ", "\[AGrave]", " ", "chuva", 
        " "}]}],
      ButtonFunction:>($CellContext`CNforIND[] := 
        Module[{$CellContext`pind, $CellContext`ArainIND, \
$CellContext`CNCIPminIND}, $CellContext`pind = ($CellContext`indchuva 0.3) (
             Max[$CellContext`dliga, 280]/
             2500); $CellContext`ArainIND = \
$CellContext`Arain[$CellContext`pind]; $CellContext`CNCIPminIND = \
$CellContext`CNberIND + $CellContext`ArainIND]; $CellContext`INDchuva = \
$CellContext`CNforIND[]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         If[
         Part[$CellContext`cn, $CellContext`i] >= 
          Part[$CellContext`INDchuva, $CellContext`i], 
          Print["f=", 
           Part[$CellContext`f, $CellContext`i], 
           " - Cl\[AAcute]usula cumprida, (C/N)=", 
