Cell[TextData[{
 StyleBox["\t",
  FontColor->RGBColor[1, 1, 0]],
 "III. Leitura de par\[AHat]metros "
}], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 CellChangeTimes->{3.4537519411466665`*^9},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tEsta vers\[ATilde]o do Feixer possibilita a leitura de um ficheiro com a \
configura\[CCedilla]\[ATilde]o de par\[AHat]metros de um projecto entretanto \
realizado e gravado.
\tAp\[OAcute]s a leitura deste ficheiro \[EAcute] poss\[IAcute]vel correr o \
programa ou parte dele, sem que para tal seja necess\[AAcute]rio voltar a \
configurar par\[AHat]metros.
\tN\[ATilde]o se deve alterar o conte\[UAcute]do do ficheiro de entrada de \
modo a n\[ATilde]o danificar a leitura dos par\[AHat]metros.
\tCaso seja a primeira vez que configura um projecto ou se tenciona correr um \
de raiz, deve passar pela secc\[CCedilla]\[ATilde]o anterior.\
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 CellChangeTimes->{3.453751941147667*^9},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Leitura", " ", "de", " ", "par\[AHat]metros", "  "}]}],
     ButtonFunction:>(Off[
        MessageName[General, "spell"]]; $CellContext`num5c[
         Pattern[$CellContext`form, 
          Blank[]]] := 
       PaddedForm[$CellContext`form, {6, 5}]; $CellContext`directoria = 
       InputString[
        "   Introduza a directoria de onde pretende ler o ficheiro.\n\n   \
Como exemplo refira a directoria, c:\\"]; 
      Print["Directoria escolhida:  ", $CellContext`directoria, " ."]; Off[
        MessageName[General, "spell"]]; 
      SetDirectory[$CellContext`directoria]; $CellContext`nomevar = 
       InputString[
        "   Introduza o nome do ficheiro de vari\[AAcute]veis a ler.\n\n   \
ATEN\[CapitalCCedilla]\[CapitalATilde]O que o ficheiro tem de ter a extens\
\[ATilde]o.\n\n   Como exemplo refira o ficheiro:   dados.txt"]; 
      Get[$CellContext`nomevar]; $CellContext`botn = 1; $CellContext`botaII = 
       1; $CellContext`bota111 = 1; $CellContext`bota112 = 
       1; $CellContext`bota12 = 1; $CellContext`bota13 = 
