         101/10; Print[
         "Folga dada:  ", $CellContext`folga, " m."]; $CellContext`ewl = 
         Table[0., {$CellContext`i, 14}]; $CellContext`ewint = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; \
$CellContext`guias = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`ag = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`i = 
         1; For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
          Increment[$CellContext`j], 
          While[Part[$CellContext`gui, $CellContext`i, 14] < 
            Part[$CellContext`f, $CellContext`j], 
            Increment[$CellContext`i]]; 
          Part[$CellContext`guias, $CellContext`j] = {
             Part[$CellContext`gui, $CellContext`i, 1], $CellContext`i}; 
          Print["O guia el\[IAcute]ptico utilizado \[AGrave] frequ\[EHat]ncia \
de ", 
            Part[$CellContext`f, $CellContext`j], 
            " GHz tem a designa\[CCedilla]\[ATilde]o EW", 
            Part[$CellContext`guias, $CellContext`j, 1], "."]]; 
        For[$CellContext`i = 1, $CellContext`i <= $CellContext`numfreq, 
          Increment[$CellContext`i], $CellContext`j = 1; 
          While[($CellContext`j = $CellContext`j + 1) <= 15, 
            Part[$CellContext`ewl, $CellContext`j - 1] = 
