           Part[$CellContext`rsr4div, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`rsrcriticadiv = $CellContext`rsr5div - \
$CellContext`mcriticaux3; 
       For[$CellContext`i = 
          1; $CellContext`rsroptimadiv = -200, $CellContext`i <= \
$CellContext`numfreq, 
         Increment[$CellContext`i], 
         If[$CellContext`rsroptimadiv < 
          Part[$CellContext`rsrcriticadiv, $CellContext`i], \
$CellContext`foptimadiv = 
           Part[$CellContext`f, $CellContext`i]; $CellContext`rsroptimadiv = 
           Part[$CellContext`rsrcriticadiv, $CellContext`i]]]; \
$CellContext`ymaxauxdiv = $CellContext`mcriticaux3; 
