Cell[CellGroupData[{

Cell[TextData[StyleBox["\t\t\t3.10.8  C/N necess\[AAcute]ria para cumprimento \
da liga\[CCedilla]\[ATilde]o ",
 FontColor->RGBColor[1, 1, 0]]], "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
        RowBox[{"C", "/", "N"}], " ", "necess\[AAcute]ria", " ", "para", " ", 
        "cumprir", " ", "as", " ", "recomenda\[CCedilla]\[OTilde]es", "  "}]}],
      ButtonFunction:>($CellContext`rsrimp = 
        0; $CellContext`rsr1 = $CellContext`CNforSESR[]; $CellContext`rsr2 = \
$CellContext`CNforBBER; $CellContext`rsr3 = $CellContext`CNforESR; \
$CellContext`rsr4 = $CellContext`INDchuva; $CellContext`rsr5 = \
$CellContext`cn; $CellContext`rsr6 = 
        Table[0., {$CellContext`x, $CellContext`numfreq}]; \
$CellContext`margemat1 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr1, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat2 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr2, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat3 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr3, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat4 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr4, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat5 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr5, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat6 = Table[{
           Part[$CellContext`f, $CellContext`x], 
           
           Part[$CellContext`rsr6, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`rsr1x = $CellContext`rsr1; \
$CellContext`rsr2x = $CellContext`rsr2; $CellContext`rsr3x = \
$CellContext`rsr3; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         If[
          Part[$CellContext`rsr1, $CellContext`i] == Null, 
           Part[$CellContext`rsr1x, $CellContext`i] = "*"; 
           Part[$CellContext`rsr1, $CellContext`i] = Infinity]; 
         If[Part[$CellContext`rsr2, $CellContext`i] == Null, 
           Part[$CellContext`rsr2x, $CellContext`i] = "*"; 
           Part[$CellContext`rsr2, $CellContext`i] = Infinity]; 
         If[Part[$CellContext`rsr3, $CellContext`i] == Null, 
           Part[$CellContext`rsr3x, $CellContext`i] = "*"; 
           Part[$CellContext`rsr3, $CellContext`i] = Infinity]]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula SESR \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(SESR\)]\)=", 
         $CellContext`numdb[$CellContext`rsr1x], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula BBER \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(BBER\)]\)=", 
         $CellContext`numdb[$CellContext`rsr2x], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula ESR \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(ESR\)]\)=", 
         $CellContext`numdb[$CellContext`rsr3x], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para as cl\[AAcute]usulas da chuva \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(chuva\)]\)=", 
         $CellContext`numdb[$CellContext`rsr6], " dB."]; 
       Print["   O C/N necess\[AAcute]rio para a cl\[AAcute]usula \
indisponibilidade \[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(IND\)]\)=", 
         $CellContext`numdb[$CellContext`rsr4], 
         " dB."]; $CellContext`grafmargat1 = 
        ListPlot[$CellContext`margemat1, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[1, 0, 1]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat2 = 
        ListPlot[$CellContext`margemat2, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[1, 0, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat3 = 
        ListPlot[$CellContext`margemat3, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 0, 1]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat4 = 
        ListPlot[$CellContext`margemat4, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 1, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat5 = 
        ListPlot[$CellContext`margemat5, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 0, 0]}, DisplayFunction -> 
          Identity]; $CellContext`grafmargat6 = 
        ListPlot[$CellContext`margemat6, Joined -> True, Axes -> False, 
          PlotStyle -> {
            Thickness[0.004], 
            RGBColor[0, 1, 1]}, DisplayFunction -> 
          Identity]; $CellContext`mcriticaux = Table[
          Max[
           Part[$CellContext`rsr1, $CellContext`j], 
           
           Part[$CellContext`rsr2, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcriticaux2 = Table[
          Max[
           Part[$CellContext`mcriticaux, $CellContext`j], 
           
           Part[$CellContext`rsr3, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcriticaux3 = Table[
          Max[
           Part[$CellContext`mcriticaux2, $CellContext`j], 
           
           Part[$CellContext`rsr4, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`rsrcritica = $CellContext`rsr5 - \
$CellContext`mcriticaux3; $CellContext`ymaxaux = 
        Table[0., {$CellContext`x, $CellContext`numfreq}]; 
       For[$CellContext`i = 
          1; $CellContext`rsroptima = -200, $CellContext`i <= \
$CellContext`numfreq, 
         Increment[$CellContext`i], 
         If[$CellContext`rsroptima < 
           Part[$CellContext`rsrcritica, $CellContext`i], \
$CellContext`foptima = 
            Part[$CellContext`f, $CellContext`i]; $CellContext`rsroptima = 
            Part[$CellContext`rsrcritica, $CellContext`i]]; 
         If[Part[$CellContext`mcriticaux3, $CellContext`i] == Infinity, 
           Part[$CellContext`ymaxaux, $CellContext`i] = "*", 
           Part[$CellContext`ymaxaux, $CellContext`i] = 
           Part[$CellContext`mcriticaux3, $CellContext`i]]; 
         If[Part[$CellContext`rsrcritica, $CellContext`i] == -Infinity, 
           Part[$CellContext`rsrcritica, $CellContext`i] = 
            "*"; $CellContext`rsrimp = 1]]; 
       Print["\nA rela\[CCedilla]\[ATilde]o Sinal-Ru\[IAcute]do \
m\[IAcute]nima necess\[AAcute]ria para cumprir todas as cl\[AAcute]usulas \
\[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(NECmin\)]\)=", 
         $CellContext`numdb[$CellContext`ymaxaux], " dB."]; 
       Print["\nA rela\[CCedilla]\[ATilde]o Sinal-Ru\[IAcute]do da liga\
\[CCedilla]\[ATilde]o em condi\[CCedilla]\[OTilde]es ideais de propaga\
\[CCedilla]\[ATilde]o \[EAcute]:\n(C/N\!\(\*SubscriptBox[\()\), \(CIP\)]\)=", \

         $CellContext`numdb[$CellContext`rsr5], " dB."]; 
       For[$CellContext`j = 
          1; $CellContext`ymax = -200, $CellContext`j <= $CellContext`numfreq, 
         Increment[$CellContext`j], 
         If[$CellContext`ymax < 
          Part[$CellContext`ymaxaux, $CellContext`j], $CellContext`ymax = 
          Part[$CellContext`ymaxaux, $CellContext`j]]]; $CellContext`ymin = \
-20; If[$CellContext`ymax < 3, $CellContext`ymax = 10]; 
       If[$CellContext`numfreq =!= 1, 
         Print[
          
          Show[$CellContext`grafmargat1, $CellContext`grafmargat2, \
$CellContext`grafmargat3, $CellContext`grafmargat4, $CellContext`grafmargat5, \
$CellContext`grafmargat6, 
