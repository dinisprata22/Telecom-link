Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.12  Reflex\[OTilde]es no terreno",
 FontFamily->"Verdana",
 FontSize->14,
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tEsta sec\[CCedilla]\[ATilde]o pretende mostrar os poss\[IAcute]veis tro\
\[CCedilla]os da liga\[CCedilla]\[ATilde]o com reflex\[OTilde]es e calcular a \
rela\[CCedilla]\[ATilde]o entre a pot\[EHat]ncia recebida do raio directo com \
a pot\[EHat]ncia  reflectida ou dispersa no solo.\n\tNo segundo \
bot\[ATilde]o, defini\[CCedilla]\[ATilde]o das caracter\[IAcute]sticas do \
terreno, \[EAcute] pedido o valor de s, par\[AHat]metro que caracteriza a \
inclina\[CCedilla]\[ATilde]o das rogusidades da superf\[IAcute]cie (cap\
\[IAcute]tulo 2.8.2 [1]). A introdu\[CCedilla]\[ATilde]o do valor de ",
 StyleBox["s",
  FontSlant->"Italic"],
 " \[EAcute] feita tro\[CCedilla]o a tro\[CCedilla]o. Sabendo de ante-m\
\[ATilde]o que ",
 StyleBox["s c",
  FontSlant->"Italic"],
 "olocar para cada tipo de superf\[IAcute]cie da liga\[CCedilla]\[ATilde]o, \
basta introduzir os pontos referentes ao in\[IAcute]cio e fim de cada tro\
\[CCedilla]o. \tO formato \[EAcute] o seguinte:\n\t\n\t1 \[UAcute]nico tro\
\[CCedilla]o na liga\[CCedilla]\[ATilde]o;\t{{ 1, ponto final, s}}\n\n\t2 tro\
\[CCedilla]os na liga\[CCedilla]\[ATilde]o;\t\t{{ 1, ponto \
interm\[EAcute]dio, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "1"], TraditionalForm]]],
 "},{ ponto interm\[EAcute]dio, ponto final, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "2"], TraditionalForm]]],
 "}}",
 StyleBox["\n\n",
  FontColor->RGBColor[1, 0, 0]],
 "\tOs pontos dos tro\[CCedilla]os, est\[ATilde]o no ficheiro de entrada.\n\t\
Pode observar-se a ",
 StyleBox["c\[OHat]r vermelha",
  FontWeight->"Bold"],
 " os tro\[CCedilla]os com reflex\[OTilde]es na figura apresentada pelo \
primeiro bot\[ATilde]o. A ",
 StyleBox["c\[OHat]r azul",
  FontWeight->"Bold"],
 " visualiza-se a \[AAcute]rea iluminada por duas antenas n\[ATilde]o simult\
\[AHat]neamente."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Tro\[CCedilla]os", " ", "com", " ", "reflex\[OTilde]es", "  "}]}],
      ButtonFunction:>($CellContext`divi = 
        Ceiling[100/$CellContext`l]; $CellContext`numpontos2 = \
($CellContext`l - 1) $CellContext`divi + 1; $CellContext`href = 
        Table[0., {$CellContext`i, $CellContext`numpontos2}]; $CellContext`d2 = 
        Table[0., {$CellContext`i, $CellContext`numpontos2}]; 
       Print["O n\[UAcute]mero de divis\[OTilde]es utilizadas entre dois \
pontos para o c\[AAcute]lculo de reflex\[OTilde]es \[EAcute] de ", \
$CellContext`divi, " ."]; 
       Print["Aten\[CCedilla]\[ATilde]o, este processamento demora algum \
tempo!!! "]; For[$CellContext`i = 1, $CellContext`i < $CellContext`l, 
         Increment[$CellContext`i], $CellContext`increm = (
            Part[$CellContext`d, $CellContext`i + 1] - 
            Part[$CellContext`d, $CellContext`i])/$CellContext`divi; \
$CellContext`dd2 = Part[$CellContext`d, $CellContext`i]; 
         For[$CellContext`j = 0, $CellContext`j <= $CellContext`divi, 
           
           Increment[$CellContext`j], $CellContext`jj = 
            If[$CellContext`i == 1, 1, $CellContext`divi ($CellContext`i - 1) + 
              1]; Part[$CellContext`d2, $CellContext`j + $CellContext`jj] = \
$CellContext`dd2 + $CellContext`j $CellContext`increm]]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`l, 
         Increment[$CellContext`i], 
         For[$CellContext`j = $CellContext`divi ($CellContext`i - 1) + 
           1, $CellContext`j <= $CellContext`divi $CellContext`i + 1, 
          Increment[$CellContext`j], Part[$CellContext`href, $CellContext`j] = 
          Part[$CellContext`h, $CellContext`i] - ((
             Part[$CellContext`d2, $CellContext`j] - 
             Part[$CellContext`d, $CellContext`i])/(
            Part[$CellContext`d, $CellContext`i + 1] - 
            Part[$CellContext`d, $CellContext`i])) (
            Part[$CellContext`h, $CellContext`i] - 
            Part[$CellContext`h, $CellContext`i + 
             1])]]; $CellContext`pontovisivel[
          Pattern[$CellContext`ponto, 
           Blank[]], 
          Pattern[$CellContext`h1, 
           Blank[]], 
          Pattern[$CellContext`h2, 
           Blank[]], 
          Pattern[$CellContext`l1, 
           Blank[]], 
          Pattern[$CellContext`l2, 
           Blank[]]] := ($CellContext`visi1 = 
          True; $CellContext`j = $CellContext`l1; While[
           
           And[$CellContext`visi1, $CellContext`j < $CellContext`ponto], \
$CellContext`visi1 = 
            If[$CellContext`h1 + 
               Part[$CellContext`href, $CellContext`l1] - ((
                 Part[$CellContext`d2, $CellContext`j] - 
                 Part[$CellContext`d2, $CellContext`l1])/(
                Part[$CellContext`d2, $CellContext`ponto] - 
                Part[$CellContext`d2, $CellContext`l1])) ($CellContext`h1 + 
                Part[$CellContext`href, $CellContext`l1] - 
                Part[$CellContext`href, $CellContext`ponto]) < 
              Part[$CellContext`href, $CellContext`j], 
              False, $CellContext`visi1]; Increment[$CellContext`j]]; 
         If[$CellContext`visi1, $CellContext`visi2 = 
            True; $CellContext`j2 = $CellContext`ponto; While[
             
             And[$CellContext`visi2, $CellContext`j2 < $CellContext`l2], \
$CellContext`visi2 = 
              If[Part[$CellContext`href, $CellContext`ponto] - ((
                   Part[$CellContext`d2, $CellContext`j2] - 
                   Part[$CellContext`d2, $CellContext`ponto])/(
                  Part[$CellContext`d2, $CellContext`l2] - 
                  Part[$CellContext`d2, $CellContext`ponto])) (
                  Part[$CellContext`href, $CellContext`ponto] - 
                  Part[$CellContext`href, $CellContext`l2] - $CellContext`h2) < 
                Part[$CellContext`href, $CellContext`j2], 
                False, $CellContext`visi2]; Increment[$CellContext`j2]]]; 
         And[$CellContext`visi1, $CellContext`visi2]); $CellContext`\[Theta][
          Pattern[$CellContext`diam, 
           Blank[]]] := 
        ArcSin[(3.83171/(2 Pi)) (
            Part[$CellContext`\[Lambda], \
$CellContext`freq]/($CellContext`diam/2))]/1; $CellContext`\[Theta]pas[
          Pattern[$CellContext`aef, 
           Blank[]]] := 
        ArcSin[Part[$CellContext`\[Lambda], \
$CellContext`freq]/$CellContext`aef^Rational[1, 2]]/1; 
       If[$CellContext`repetidor, $CellContext`ptsrep = 
         Table[Part[$CellContext`pontospassivo, $CellContext`i] \
$CellContext`divi - ($CellContext`divi - 
           1), {$CellContext`i, $CellContext`passivo}]]; $CellContext`p1[
          Pattern[$CellContext`jj1, 
           Blank[]]] := If[$CellContext`jj1 == 1, 1, 
          Part[$CellContext`ptsrep, $CellContext`jj1 - 1]]; $CellContext`p2[
          Pattern[$CellContext`jj1, 
           Blank[]]] := 
        If[$CellContext`jj1 == $CellContext`passivo + 
           1, $CellContext`numpontos2, 
          Part[$CellContext`ptsrep, $CellContext`jj1]]; $CellContext`ha1[
          Pattern[$CellContext`jj1, 
           Blank[]]] := If[$CellContext`jj1 == 1, $CellContext`hae, 
          
          Part[$CellContext`hemipassivo, $CellContext`jj1 - 
           1]]; $CellContext`ha2[
          Pattern[$CellContext`jj1, 
           Blank[]]] := 
        If[$CellContext`jj1 == $CellContext`passivo + 1, $CellContext`har, 
          
          Part[$CellContext`hrecpassivo, $CellContext`jj1]]; $CellContext`\
\[Alpha]\[Alpha][
          Pattern[$CellContext`jj1, 
           Blank[]]] := ArcTan[(Part[$CellContext`href, 
             $CellContext`p1[$CellContext`jj1]] + \
$CellContext`ha1[$CellContext`jj1] - Part[$CellContext`href, 
            $CellContext`p2[$CellContext`jj1]] - \
$CellContext`ha2[$CellContext`jj1])/(Part[$CellContext`d2, 
            $CellContext`p2[$CellContext`jj1]] - Part[$CellContext`d2, 
           $CellContext`p1[$CellContext`jj1]])]; $CellContext`hluis[
          Pattern[$CellContext`x, 
           Blank[]], 
          Pattern[$CellContext`x1, 
           Blank[]], 
          Pattern[$CellContext`x2, 
           Blank[]]] := 
        Part[$CellContext`href, $CellContext`x1] - ((
           Part[$CellContext`d2, $CellContext`x] - 
           Part[$CellContext`d2, $CellContext`x1])/(
          Part[$CellContext`d2, $CellContext`x2] - 
          Part[$CellContext`d2, $CellContext`x1])) (
          Part[$CellContext`href, $CellContext`x1] - 
          Part[$CellContext`href, $CellContext`x2]); $CellContext`g[
          Pattern[$CellContext`u, 
           Blank[]]] := (($CellContext`t/(8 
           Pi^Rational[1, 2])) ((
            1 + $CellContext`u ($CellContext`rr - 1))/($CellContext`u^2 (
             1 - $CellContext`u)^2))) 
         Exp[(-($CellContext`t^2/16)) ($CellContext`rr/(1 - $CellContext`u) - 
             1/$CellContext`u)^2]; $CellContext`ga[
          Pattern[$CellContext`\[Theta]a, 
           Blank[]], 
          Pattern[$CellContext`raio, 
           
           Blank[]]] := ($CellContext`x = ((2 Pi) ($CellContext`raio/
