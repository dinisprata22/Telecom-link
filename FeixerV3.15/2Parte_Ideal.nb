Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.4  Caracter\[IAcute]sticas das antenas",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tO di\[AHat]metro das antenas emissora e receptora, segundo os \
fabricantes, pode ser:\t0.6, 1, 1.5, 2, 3 e 4,5 metros,\n\n\t\t\t\t\t\t\t\t\t\
\t\t\t2, 4, 6, 8, 10, 12 e 15 p\[EAcute]s (1 p\[EAcute] = 0.3048 m).\n\n\t\
Atrav\[EAcute]s da introdu\[CCedilla]\[ATilde]o do 1\.ba elips\[OAcute]ide de \
Fresnel (n=1) no raio directo, tem-se uma ideia da sua percentagem de \
interrup\[CCedilla]\[ATilde]o. Num varrimento de frequ\[EHat]ncias, apenas se \
apresentam os elips\[OAcute]ides correspondentes aos extremos do vector de \
frequ\[EHat]ncias.\n\n\tA atenua\[CCedilla]\[ATilde]o do espa\[CCedilla]o \
livre \[EAcute] dada pela express\[ATilde]o  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "0"], "=", 
    RowBox[{"32.44", "+", 
     RowBox[{"20", " ", 
      RowBox[{
       SubscriptBox["log", "10"], "(", 
       FractionBox["d", "km"], ")"}]}], "+", 
     RowBox[{"20", " ", 
      RowBox[{
       SubscriptBox["log", "10"], "(", 
       FractionBox["f", "MHz"], ")"}]}]}]}], TraditionalForm]]],
 "  [dB] visto em [1]."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Antena", " ", "de", " ", "emiss\[ATilde]o", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`diame = $CellContext`MyInput[
          "Introduza o di\[AHat]metro da antena emissora em [m]", \
$CellContext`diame]; $CellContext`\[Eta]e = $CellContext`MyInput[
          "Introduza o rendimento da antena de emiss\[ATilde]o", \
$CellContext`\[Eta]e]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Antena", " ", "de", " ", "recep\[CCedilla]\[ATilde]o", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`diamr = $CellContext`MyInput[
          "Introduza o di\[AHat]metro da antena receptora em [m]", \
$CellContext`diamr]; $CellContext`\[Eta]r = $CellContext`MyInput[
          "Introduza o rendimento da antena de recep\[CCedilla]\[ATilde]o", \
$CellContext`\[Eta]r]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "1", "\.ba", " ", "elips\[OAcute]ide", " ", "de", " ", "Fresnel", 
        "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`bota14 = 1; $CellContext`botn = 
         5; $CellContext`aobst = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; \
$CellContext`atenua\[CCedilla]\[ATilde]o[
           Pattern[$CellContext`l1, 
            Blank[]], 
           Pattern[$CellContext`l2, 
            Blank[]], 
           Pattern[$CellContext`\[Lambda]0, 
            Blank[]], 
           Pattern[$CellContext`h1, 
            Blank[]], 
           Pattern[$CellContext`h2, 
            Blank[]]] := 
         Module[{$CellContext`i, $CellContext`aob, $CellContext`v, \
$CellContext`hh, $CellContext`vob}, 
           For[$CellContext`i = $CellContext`l1 + 1; $CellContext`aob = 
              0; $CellContext`lob = 
              1; $CellContext`v = -0.78, $CellContext`i < $CellContext`l2, 
             
             Increment[$CellContext`i], $CellContext`hh = ($CellContext`h1 - \
((Part[$CellContext`d, $CellContext`i] - 
                  Part[$CellContext`d, $CellContext`l1])/(
                 Part[$CellContext`d, $CellContext`l2] - 
                 Part[$CellContext`d, $CellContext`l1])) ($CellContext`h1 - \
$CellContext`h2)) - 
               Part[$CellContext`h, $CellContext`i]; $CellContext`vob = \
(-$CellContext`hh) (
                 2 ((Part[$CellContext`d, $CellContext`l2] - 
                   Part[$CellContext`d, $CellContext`l1])/(($CellContext`\
\[Lambda]0 (Part[$CellContext`d, $CellContext`i] - 
                    Part[$CellContext`d, $CellContext`l1])) (
                   Part[$CellContext`d, $CellContext`l2] - 
                   Part[$CellContext`d, $CellContext`i]))))^Rational[1, 2]; 
             If[$CellContext`vob > $CellContext`v, $CellContext`aob = 
                6.9 + 20 
                  Log[10, (($CellContext`vob - 0.1)^2 + 1)^
                    Rational[1, 2] + $CellContext`vob - 
                    0.1]; $CellContext`lob = $CellContext`i; $CellContext`v = \
$CellContext`vob]]; $CellContext`aob]; $CellContext`aten526[
           Pattern[$CellContext`ll1, 
            Blank[]], 
           Pattern[$CellContext`ll2, 
            Blank[]]] := 
         Module[{$CellContext`j, $CellContext`ap, $CellContext`aob}, \
$CellContext`lp1 = 1; $CellContext`lp2 = 1; $CellContext`lp = 1; 
           For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
             
             Increment[$CellContext`j], $CellContext`aob = \
$CellContext`atenua\[CCedilla]\[ATilde]o[$CellContext`ll1, $CellContext`ll2, 
                
                Part[$CellContext`\[Lambda], $CellContext`j], \
$CellContext`h1, $CellContext`h2]; 
             If[$CellContext`aob == 0, 
               Part[$CellContext`aobst, $CellContext`j] = 
               0, $CellContext`ap = $CellContext`aob; $CellContext`lp = \
$CellContext`lob; $CellContext`a1 = \
$CellContext`atenua\[CCedilla]\[ATilde]o[$CellContext`ll1, $CellContext`lp, 
                  
                  Part[$CellContext`\[Lambda], $CellContext`j], \
$CellContext`h1, 
                  
                  Part[$CellContext`h, $CellContext`lp]]; $CellContext`lp1 = \
$CellContext`lob; $CellContext`a2 = \
$CellContext`atenua\[CCedilla]\[ATilde]o[$CellContext`lp, $CellContext`ll2, 
                  Part[$CellContext`\[Lambda], $CellContext`j], 
                  
                  Part[$CellContext`h, $CellContext`lp], $CellContext`h2]; \
$CellContext`lp2 = $CellContext`lob; $CellContext`t = 
                If[$CellContext`ap <= 6, $CellContext`ap/6, 
                  1]; $CellContext`c = 
                8 + 0.04 (
                   Part[$CellContext`d, $CellContext`l]/$CellContext`km); 
               Part[$CellContext`aobst, $CellContext`j] = $CellContext`ap + \
$CellContext`t ($CellContext`a1 + $CellContext`a2 + $CellContext`c)]]; \
$CellContext`aobst]; $CellContext`atenlamina[
           Pattern[$CellContext`ll1, 
            Blank[]], 
           Pattern[$CellContext`ll2, 
            Blank[]]] := Module[{$CellContext`i}, 
           Table[
            $CellContext`atenua\[CCedilla]\[ATilde]o[$CellContext`ll1, \
$CellContext`ll2, 
             
             Part[$CellContext`\[Lambda], $CellContext`i], $CellContext`h1, \
$CellContext`h2], {$CellContext`i, $CellContext`numfreq}]]; \
$CellContext`atendeygout[
           Pattern[$CellContext`lll11, 
            Blank[]], 
           Pattern[$CellContext`lll22, 
            Blank[]], 
           Pattern[$CellContext`rep, 
            Blank[]]] := 
         Module[{$CellContext`i, $CellContext`j}, 
           For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
             Increment[$CellContext`j], 
             Clear[$CellContext`aten]; $CellContext`atenua = 
              0; $CellContext`aten[
                Pattern[$CellContext`l1, 
                 Blank[]], 
                Pattern[$CellContext`l2, 
                 Blank[]]] := 
              Module[{$CellContext`ll1, $CellContext`ll2, $CellContext`lpp}, \
$CellContext`h1 = If[$CellContext`l1 == 1, 
                   Part[$CellContext`h, 1] + $CellContext`hae, 
                   Part[$CellContext`h, $CellContext`l1]]; $CellContext`h2 = 
                 If[$CellContext`l2 == $CellContext`l, 
                   Part[$CellContext`h, $CellContext`l] + $CellContext`har, 
                   Part[$CellContext`h, $CellContext`l2]]; 
                If[$CellContext`rep != 0, 
                  
                  For[$CellContext`i = 
                   1, $CellContext`i <= $CellContext`passivo, 
                   
                   Increment[$CellContext`i], $CellContext`h1 = 
                    If[$CellContext`l1 == 
                    Part[$CellContext`pontospassivo, $CellContext`i], 
                    Part[$CellContext`h, $CellContext`l1] + 
                    Part[$CellContext`hemipassivo, $CellContext`i], \
$CellContext`h1]; $CellContext`h2 = 
                    If[$CellContext`l2 == 
                    Part[$CellContext`pontospassivo, $CellContext`i], 
                    Part[$CellContext`h, $CellContext`l2] + 
                    Part[$CellContext`hrecpassivo, $CellContext`i], \
$CellContext`h2]]]; $CellContext`ll2 = $CellContext`l2; $CellContext`ll1 = \
$CellContext`l1; $CellContext`aob = \
$CellContext`atenua\[CCedilla]\[ATilde]o[$CellContext`ll1, $CellContext`ll2, 
                   
                   Part[$CellContext`\[Lambda], $CellContext`j], \
$CellContext`h1, $CellContext`h2]; $CellContext`lpp = $CellContext`lob; 
                If[$CellContext`aob == 
                  0, $CellContext`ll1 = ($CellContext`ll2 = 
                   1), $CellContext`atenua = $CellContext`atenua + \
$CellContext`aob]; $CellContext`aten[$CellContext`ll1, $CellContext`ll2] = \
$CellContext`aten[$CellContext`ll1, $CellContext`lpp] + \
$CellContext`aten[$CellContext`lpp, $CellContext`ll2]; $CellContext`atenua]; \
$CellContext`aten[1, 1] = 0; 
             Part[$CellContext`aobst, $CellContext`j] = \
$CellContext`aten[$CellContext`lll11, $CellContext`lll22]]; \
$CellContext`aobst]; 
        Print["O di\[AHat]metro da antena emissora \[EAcute] de ", \
$CellContext`diame, 
          " m, sendo o seu rendimento de \[Eta]e= ", $CellContext`\[Eta]e, 
          " ."]; Print[
         "O di\[AHat]metro da antena receptora \[EAcute] de ", \
$CellContext`diamr, 
          " m, sendo o seu rendimento de \[Eta]r= ", $CellContext`\[Eta]r, 
          " ."]; $CellContext`afe = (Pi/
           4) $CellContext`diame^2; $CellContext`afr = (Pi/
           4) $CellContext`diamr^2; $CellContext`aefce = $CellContext`afe \
$CellContext`\[Eta]e; $CellContext`aefcr = $CellContext`afr $CellContext`\
\[Eta]r; Print[
         "A \[AAcute]rea f\[IAcute]sica da antena de emiss\[ATilde]o \
\[EAcute] afe=", 
          $CellContext`numdb[
           N[$CellContext`afe]], 
          " \!\(\*SuperscriptBox[\(m\), \(2\)]\), correspondendo a uma \
\[AAcute]rea efectiva de \!\(\*SubscriptBox[\(aef\), \(e\)]\)=", 
          $CellContext`numdb[
           N[$CellContext`aefce]], " \!\(\*SuperscriptBox[\(m\), \(2\)]\)."]; 
        Print["A \[AAcute]rea f\[IAcute]sica da antena de recep\[CCedilla]\
\[ATilde]o \[EAcute] afr=", 
          $CellContext`numdb[
           N[$CellContext`afr]], 
          " \!\(\*SuperscriptBox[\(m\), \(2\)]\), correspondendo a uma \
\[AAcute]rea efectiva de \!\(\*SubscriptBox[\(aef\), \(r\)]\)=", 
          $CellContext`numdb[
           N[$CellContext`aefcr]], 
          " \!\(\*SuperscriptBox[\(m\), \(2\)]\)."]; $CellContext`ge = 
         10 Log[10, ((4 
              Pi)/$CellContext`\[Lambda]^2) $CellContext`aefce]; \
$CellContext`gp = $CellContext`ge; $CellContext`gpri = 
         10^($CellContext`ge/
           10); $CellContext`diampri = $CellContext`diame; \
$CellContext`\[Eta]pri = $CellContext`\[Eta]e; $CellContext`diamsec = \
$CellContext`diame; $CellContext`\[Eta]sec = $CellContext`\[Eta]e; \
$CellContext`gs = $CellContext`ge; $CellContext`gsec = $CellContext`gpri; \
$CellContext`Gr = 
         10 Log[10, ((4 Pi)/$CellContext`\[Lambda]^2) $CellContext`aefcr]; 
        Print["Ganho da antena de emiss\[ATilde]o:\nge=", 
          $CellContext`numdb[$CellContext`ge], " dBi."]; 
        Print["Ganho da antena de recep\[CCedilla]\[ATilde]o:\ngr=", 
          $CellContext`numdb[$CellContext`Gr], 
          " dBi."]; $CellContext`elipfresnel[
           Pattern[$CellContext`\[Lambda]0, 
            Blank[]], 
           Pattern[$CellContext`l1, 
            Blank[]], 
           Pattern[$CellContext`l2, 
            Blank[]], 
           Pattern[$CellContext`hemi, 
            Blank[]], 
           Pattern[$CellContext`hrec, 
            Blank[]]] := (
          Clear[$CellContext`fresnelup, $CellContext`fresnellow]; \
$CellContext`fresnelup = 
           Table[{0.}, {$CellContext`i, $CellContext`l2 - $CellContext`l1 + 
              1}]; $CellContext`fresnellow = 
           Table[{0.}, {$CellContext`i, $CellContext`l2 - $CellContext`l1 + 
              1}]; For[$CellContext`i = $CellContext`l1, $CellContext`i <= \
$CellContext`l2, 
            
            Increment[$CellContext`i], $CellContext`nfresn = 
             1; $CellContext`fresup = (
               Part[$CellContext`h, $CellContext`l1] + $CellContext`hemi - ((
                 Part[$CellContext`d, $CellContext`i] - 
                 Part[$CellContext`d, $CellContext`l1])/(
                Part[$CellContext`d, $CellContext`l2] - 
                Part[$CellContext`d, $CellContext`l1])) (
                Part[$CellContext`h, $CellContext`l1] + $CellContext`hemi - 
                Part[$CellContext`h, $CellContext`l2] - $CellContext`hrec)) + \
(($CellContext`nfresn ((Part[$CellContext`d, $CellContext`i] - 
                   Part[$CellContext`d, $CellContext`l1]) ((
                    Part[$CellContext`d, $CellContext`l2] - 
                    Part[$CellContext`d, $CellContext`i])/(
                   Part[$CellContext`d, $CellContext`l2] - 
                   Part[$CellContext`d, $CellContext`l1])))) $CellContext`\
\[Lambda]0)^Rational[1, 2]; $CellContext`freslow = (
               Part[$CellContext`h, $CellContext`l1] + $CellContext`hemi - ((
                 Part[$CellContext`d, $CellContext`i] - 
                 Part[$CellContext`d, $CellContext`l1])/(
                Part[$CellContext`d, $CellContext`l2] - 
                Part[$CellContext`d, $CellContext`l1])) (
                Part[$CellContext`h, $CellContext`l1] + $CellContext`hemi - 
                Part[$CellContext`h, $CellContext`l2] - $CellContext`hrec)) - \
(($CellContext`nfresn ((Part[$CellContext`d, $CellContext`i] - 
                  Part[$CellContext`d, $CellContext`l1]) ((
                   Part[$CellContext`d, $CellContext`l2] - 
                   Part[$CellContext`d, $CellContext`i])/(
                  Part[$CellContext`d, $CellContext`l2] - 
                  Part[$CellContext`d, $CellContext`l1])))) $CellContext`\
\[Lambda]0)^Rational[1, 2]; 
            Part[$CellContext`fresnelup, $CellContext`i - $CellContext`l1 + 
               1] = {Part[$CellContext`d, $CellContext`i]/$CellContext`km, \
$CellContext`fresup}; 
            Part[$CellContext`fresnellow, $CellContext`i - $CellContext`l1 + 
               1] = {Part[$CellContext`d, $CellContext`i]/$CellContext`km, \
$CellContext`freslow}]); $CellContext`elipfresnel[
          Part[$CellContext`\[Lambda], 1], 
          1, $CellContext`l, $CellContext`hae, $CellContext`har]; \
$CellContext`linhaup1 = 
         ListPlot[$CellContext`fresnelup, Joined -> True, PlotStyle -> 
           Hue[0.3, 0.8, 0.8], DisplayFunction -> 
           Identity]; $CellContext`linhalow1 = 
         ListPlot[$CellContext`fresnellow, Joined -> True, PlotStyle -> 
           Hue[0.3, 0.8, 0.8], DisplayFunction -> 
           Identity]; $CellContext`elipfresnel[
          Part[$CellContext`\[Lambda], $CellContext`numfreq], 
          1, $CellContext`l, $CellContext`hae, $CellContext`har]; \
$CellContext`linhaup2 = 
         ListPlot[$CellContext`fresnelup, Joined -> True, PlotStyle -> 
           Hue[0.3, 0.8, 0.4], DisplayFunction -> 
           Identity]; $CellContext`linhalow2 = 
         ListPlot[$CellContext`fresnellow, Joined -> True, PlotStyle -> 
           Hue[0.3, 0.8, 0.4], DisplayFunction -> 
           Identity]; $CellContext`grafico3 = 
         If[$CellContext`numfreq != 0, $CellContext`elipfresnel[
             Part[$CellContext`\[Lambda], $CellContext`numfreq], 
             1, $CellContext`l, $CellContext`hae, $CellContext`har]; \
$CellContext`linhaup2 = 
            ListPlot[$CellContext`fresnelup, Joined -> True, PlotStyle -> 
              Hue[0.3, 0.8, 0.4], DisplayFunction -> 
              Identity]; $CellContext`linhalow2 = 
            ListPlot[$CellContext`fresnellow, Joined -> True, PlotStyle -> 
              Hue[0.3, 0.8, 0.4], DisplayFunction -> Identity]; 
           Show[$CellContext`grafico2, $CellContext`linhaup1, \
$CellContext`linhalow1, $CellContext`linhaup2, $CellContext`linhalow2, 
             ImageSize -> {400, 400}], 
           
           Show[$CellContext`grafico2, $CellContext`linhaup1, \
$CellContext`linhalow1, ImageSize -> {400, 400}]]; 
        Print[$CellContext`grafico3]; $CellContext`atenuacaoespacolivre[
           Pattern[$CellContext`f0, 
            Blank[]], 
           Pattern[$CellContext`l1, 
            Blank[]], 
           Pattern[$CellContext`l2, 
            Blank[]]] := 
         32.44778 + 
          20 Log[10, (Part[$CellContext`d, $CellContext`l2] - 
              Part[$CellContext`d, $CellContext`l1])/$CellContext`km] + 
          20 Log[10, $CellContext`f0]; $CellContext`L0 = \
$CellContext`atenuacaoespacolivre[$CellContext`fMhz, 1, $CellContext`l]; 
        Print["   A atenua\[CCedilla]\[ATilde]o em espa\[CCedilla]o livre \
entre antenas \[EAcute]:\nL0=", 
          $CellContext`numdb[$CellContext`L0], " dB."]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236006140625*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

