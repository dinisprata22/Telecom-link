Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.6  Atenua\[CCedilla]\[ATilde]o \
atmosf\[EAcute]rica",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tHabitualmente, os sistemas de feixes hertzianos utilizam \
frequ\[EHat]ncias entre 1 e 55 GHz.\n\tO c\[AAcute]lculo da atenua\[CCedilla]\
\[ATilde]o atmosf\[EAcute]rica \[EAcute] calculado com base em algoritmos \
segundo a norma P676-5 ds ITU-R referenciada no cap\[IAcute]tulo 2.5.2 de \
[1].\n\tEm Portugal os valores do conte\[UAcute]do de vapor de \[AAcute]gua \
no ar  \[Rho] s\[ATilde]o:\n\t\n\t\t\t\t",
 Cell[BoxData[
  StyleBox[GridBox[{
     {"Portugal", 
      RowBox[{"Temperatura", " ", "[", "\.baC", "]"}], 
      RowBox[{"Humidade", " ", "[", "%", "]"}], 
      RowBox[{"   ", 
       RowBox[{"\[Rho]", " ", "[", 
        RowBox[{"g", "/", 
         SuperscriptBox["m", "3"]}], "]"}], "  "}]},
     {"Inverno", "10", "85", "7.3"},
     {"Ver\[ATilde]o", "25", "50", "11.3"}
    },
    GridBoxDividers->{
     "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
      "RowsIndexed" -> {}}],
   FontFamily->"Verdana"]]]
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

