Cell[CellGroupData[{

Cell[TextData[StyleBox["\t\t\t3.10.4  Cl\[AAcute]usula SESR devido \[AGrave] \
chuva ",
 FontColor->RGBColor[1, 1, 0]]], "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{" ", 
       RowBox[{"SESR", " ", "devido", " ", "\[AGrave]", " ", "chuva", " "}]}],
      
      ButtonFunction:>($CellContext`MuSESR = $CellContext`cn - \
$CellContext`CNberSESR; $CellContext`muSESR = 
        10^($CellContext`MuSESR/10); $CellContext`mrSESR = 
        1/(1/$CellContext`muSESR + 
         1/$CellContext`Ms); $CellContext`Ases = ($CellContext`MrSESR = 
         10. Log[10, $CellContext`mrSESR]); $CellContext`paSES = 
        Table[0, {$CellContext`a, $CellContext`numfreq}]; \
$CellContext`calcpaSES[
          Pattern[$CellContext`n, 
           Blank[]]] := Part[
          FindRoot[Part[
             $CellContext`Arain[$CellContext`p], $CellContext`n] == 
           Part[$CellContext`Ases, $CellContext`n], {$CellContext`p, 0.001}], 
          1, 2]; For[$CellContext`i = 
         1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         If[
          Not[Part[
             $CellContext`Arain[1], $CellContext`i] < 
           Part[$CellContext`Ases, $CellContext`i] < Part[
             $CellContext`Arain[1/10^3], $CellContext`i]], 
          Part[$CellContext`paSES, $CellContext`i] = Infinity, 
          Part[$CellContext`paSES, $CellContext`i] = \
$CellContext`calcpaSES[$CellContext`i]]]; $CellContext`pwSES = \
($CellContext`paSES/0.3)^(1/1.15); $CellContext`PwSES = $CellContext`pwSES/
         100; $CellContext`sesrch = 
        Table[0, {$CellContext`a, $CellContext`numfreq}]; $CellContext`Y = 0; 
       Print["Valor da norma SESR = ", $CellContext`SESR]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], If[
           
           And[$CellContext`Y == 0, Part[$CellContext`pwSES, $CellContext`i] == 
            Infinity], Part[$CellContext`sesrch, $CellContext`i] = 0, 
           Part[$CellContext`sesrch, $CellContext`i] = $CellContext`Y 
            Part[$CellContext`PwSES, $CellContext`i]]; 
         If[Part[$CellContext`sesrch, $CellContext`i] <= $CellContext`SESR, 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula cumprida, sesrchuva=", 
            Part[$CellContext`sesrch, $CellContext`i]], 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula n\[ATilde]o cumprida, sesrchuva=", 
            Part[$CellContext`sesrch, $CellContext`i]]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236008875*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

