Cell[CellGroupData[{

Cell[TextData[StyleBox["\t\t\t1.1.2  Perfil do percurso com Terra \
esf\[EAcute]rica",
 FontColor->RGBColor[1, 1, 0]]], "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tA recomenda\[CCedilla]\[ATilde]o da ITU-R [2], prop\[OTilde]e um crit\
\[EAcute]rio em que o valor  ",
 StyleBox["K",
  FontSlant->"Italic"],
 "  (definido como o coeficiente entre o raio aparente e real da Terra) e a \
frac\[CCedilla]\[ATilde]o do primeiro elips\[OAcute]ide de Fresnel a \
libertar, \[EAcute] fun\[CCedilla]\[ATilde]o do comprimento do percurso  ",
 StyleBox["d",
  FontSlant->"Italic"],
 "  e das condi\[CCedilla]\[OTilde]es de propaga\[CCedilla]\[ATilde]o.\n\tOs \
pontos de  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "e"], TraditionalForm]]],
 StyleBox[" ",
  FontSlant->"Italic"],
 " foram extra\[IAcute]dos de [2] mas podem igualmente ser vistos em [1], \
figura 2.35 e no bot\[ATilde]o, figura de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "min"], TraditionalForm]]],
 "(d). Estes representam os valores de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "e"], TraditionalForm]]],
 " excedidos em aproximadamente 99.9% do tempo do pior m\[EHat]s em clima \
temperado continental.\n\n\tNo projecto da liga\[CCedilla]\[ATilde]o deve \
procurar garantir-se o cumprimento da mais severa das seguintes condi\
\[CCedilla]\[OTilde]es:\n\n\t",
 StyleBox["1.",
  FontWeight->"Bold"],
 " liberta\[CCedilla]\[ATilde]o de  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"1", "e"}]], TraditionalForm]]],
 " para o valor de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "e"], TraditionalForm]]],
 " apropriado ao local da liga\[CCedilla]\[ATilde]o (habitualmente  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "e"], TraditionalForm]]],
 "= 4/3);\n\t\n\t",
 StyleBox["2.",
  FontWeight->"Bold"],
 " liberta\[CCedilla]\[ATilde]o de  0.6 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"1", "e"}]], TraditionalForm]]],
 " para o  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "min"], TraditionalForm]]],
 "(d), para d > 30 km, em climas tropicais;\n\t\n\t",
 StyleBox["3.",
  FontWeight->"Bold"],
 " liberta\[CCedilla]\[ATilde]o do raio directo (incid\[EHat]ncia rasante), \
para  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "min"], TraditionalForm]]],
 "(d), em clima temperado se existir apenas um obst\[AAcute]culo ao raio \
directo no percurso;\n\t\n\t",
 StyleBox["4.",
  FontWeight->"Bold"],
 " liberta\[CCedilla]\[ATilde]o de  0.3 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"1", "e"}]], TraditionalForm]]],
 " para ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "min"], TraditionalForm]]],
 "(d), em clima temperado, se existir um obst\[AAcute]culo extenso no \
percurso.\n\n\tA utiliza\[CCedilla]\[ATilde]o de K= 4/3 (que corresponde ao \
valor usual de K em pa\[IAcute]ses de clima temperado) e a exig\[EHat]ncia de \
liberta\[CCedilla]\[ATilde]o completa do primeiro elips\[OAcute]ide de \
Fresnel \[EAcute] comum a v\[AAcute]rios pa\[IAcute]ses.\n\tO efeito \
provocado pela curvatura dos raios \[OAcute]pticos, num modelo de Terra esf\
\[EAcute]rica com atmosfera, deve considerar-se um raio equivalente da Terra, \
dado por  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SubscriptBox["r", "0"],
     TraditionalForm], "=", 
    RowBox[{"K", "\[Times]", 
     SubscriptBox["r", "T"]}]}], TraditionalForm]]],
 ".\n\n\t[2]- Recomenda\[CCedilla]\[ATilde]o da ITU-R, P.530-8, figura 2."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Figura", " ", "de", " ", 
