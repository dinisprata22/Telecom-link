 Background->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "N\[UAcute]mero", " ", "de", " ", "n\[IAcute]veis", " ", "por", " ", 
        "palavra", "  "}]}],
      ButtonFunction:>($CellContext`mniveis = $CellContext`MyInput[
        "Introduza o n\[UAcute]mero de n\[IAcute]veis por palavra com base no \
resultado da sec\[CCedilla]\[ATilde]o 3.1 .No caso de fazer um varrimento de \
