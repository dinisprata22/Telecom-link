 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 StyleBox["Telefonia m\[UAcute]ltipla:\n\n",
  FontColor->GrayLevel[0.333333]],
 "\tConsultar o cap\[IAcute]tulo 4.5 e tabela 4.9 [1].",
 StyleBox["\n\nVideo:",
  FontColor->GrayLevel[0.333333]],
 "\n\n\tAltera\[CCedilla]\[ATilde]o da rela\[CCedilla]\[ATilde]o sinal/ru\
\[IAcute]do t\[EAcute]rmico pela introdu\[CCedilla]\[ATilde]o da acentua\
\[CCedilla]\[ATilde]o e desacentua\[CCedilla]\[ATilde]o recomendadas, cap\
\[IAcute]tulo 4.4.5 e tabela 4.8 de [1].\n\tPot\[EHat]ncia de ru\[IAcute]do \
\[AGrave] sa\[IAcute]da do circuito de pondera\[CCedilla]\[ATilde]o supondo \
\[AGrave] entrada uma pot\[EHat]ncia de ru\[IAcute]do de 0 dBm, \
cap\[IAcute]tulo 4.5 e tabela 4.12 de [1].\t\n\tAs express\[OTilde]es \
apresentadas para a rela\[CCedilla]\[ATilde]o sinal/ru\[IAcute]do consideram \
que o sinal modulante \[EAcute] sinusoidal com uma amplitude tal que conduz \
ao desvio m\[AAcute]ximo da portadora. No caso da televis\[ATilde]o, nos \
pontos de jun\[CCedilla]\[ATilde]o video, o sinal modulante com amplitude \
pico a pico de 1 Volt produz o desvio m\[AAcute]ximo de 6 dB."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 CellChangeTimes->{{3.4550263372390003`*^9, 3.455026340443*^9}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

