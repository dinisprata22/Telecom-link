Cell[CellGroupData[{

Cell["\t\t\t3.12.1  Diversidade", "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tO processo de c\[AAcute]lculo da diversidade tem como base as express\
\[OTilde]es do cap\[IAcute]tulo 3.9 [1].
\tO limite de validade para o factor de melhoria pela utiliza\[CCedilla]\
\[ATilde]o de diversidade \[EAcute] colocado no Feixer a 1 dB. Abaixo deste \
valor n\[ATilde]o h\[AAcute] melhoria pela utiliza\[CCedilla]\[ATilde]o \
desta.
\tOs valores relativos \[AGrave]s caracter\[IAcute]sticas das antenas, s\
\[ATilde]o por omiss\[ATilde]o, iguais \[AGrave] antena de emiss\[ATilde]o.
\t
\tAten\[CCedilla]\[ATilde]o:\tN\[ATilde]o esquecer que s\[ATilde]o precisos \
dois repetidores passivos - se tiver a utilizar algum - para garantir a \
diversidade no espa\[CCedilla]o.\
\>", "Text",
 CellMargins->{{36, 47}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Caracter\[IAcute]sticas", " ", "das", " ", "antenas", "  "}]}],
      ButtonFunction:>($CellContext`diampri = $CellContext`MyInput[
         "Introduza o di\[AHat]metro da antena principal em [m]", \
$CellContext`diampri]; $CellContext`\[Eta]pri = $CellContext`MyInput[
         "Introduza o rendimento da antena principal", \
$CellContext`\[Eta]pri]; $CellContext`diamsec = 
        Input["Introduza o di\[AHat]metro da antena secund\[AAcute]ria em \
[m]", $CellContext`diamsec]; $CellContext`\[Eta]sec = 
        Input["Introduza o rendimento da antena secund\[AAcute]ria.", \
$CellContext`\[Eta]sec]; $CellContext`afpri = 
        Pi ($CellContext`diampri^2/4); $CellContext`afsec = 
        Pi ($CellContext`diamsec^2/
          4); $CellContext`aefcpri = $CellContext`afpri \
$CellContext`\[Eta]pri; $CellContext`aefcsec = $CellContext`afsec \
$CellContext`\[Eta]sec; $CellContext`gp = 
        10 Log[10, (4 
            Pi) ($CellContext`aefcpri/$CellContext`\[Lambda]^2)]; \
$CellContext`gpri = 10^($CellContext`gp/10); $CellContext`gs = 
        10 Log[10, (4 
            Pi) ($CellContext`aefcsec/$CellContext`\[Lambda]^2)]; \
$CellContext`gsec = 10^($CellContext`gs/10)),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Diversidade", " ", "no", " ", "espa\[CCedilla]o", "  "}]}],
      ButtonFunction:>($CellContext`divers = $CellContext`sim; \
$CellContext`Dc = $CellContext`MyInput[
         "Introduza a dist\[AHat]ncia entre os centros das antenas em [m]", \
$CellContext`Dc]; 
       Print["Dist\[AHat]ncia entre o centro das antenas:  Dc= ", \
$CellContext`Dc, " m."]; 
       Print["  O di\[AHat]metro da antena principal \[EAcute] de ", \
$CellContext`diampri, 
         " m, sendo o seu rendimento de \[Eta]p= ", $CellContext`\[Eta]pri, 
         " ."]; Print[
        "  O di\[AHat]metro da antena secund\[AAcute]ria \[EAcute] de ", \
$CellContext`diamsec, 
         " m, sendo o seu rendimento de \!\(\*SubscriptBox[\(\[Eta]\), \(s\)]\
\)= ", $CellContext`\[Eta]sec, " ."]; 
       Print["Ganho da antena principal:  \!\(\*SubscriptBox[\(g\), \(p\)]\)= \
", 
         $CellContext`numdb[$CellContext`gp], " dB."]; 
       Print["Ganho da antena secund\[AAcute]ria:  \!\(\*SubscriptBox[\(g\), \
\(s\)]\)= ", 
         $CellContext`numdb[$CellContext`gs], 
         " dB."]; $CellContext`kesp = (1 - 
          Exp[-((3.34 $CellContext`Dc^0.87) ($CellContext`dkm^0.48/((
              10^4 $CellContext`f^0.12) $CellContext`kt[]^1.04)))]) \
($CellContext`gsec/$CellContext`gpri); $CellContext`muSESR = 
        10^($CellContext`MuSESR/10); $CellContext`murber = 
        10^($CellContext`Murber/10); $CellContext`mrSESR = 
        1/(1/$CellContext`muSESR + 1/$CellContext`Ms); $CellContext`mrrber = 
        1/(1/$CellContext`murber + 
         1/$CellContext`Ms); $CellContext`idivberSES = $CellContext`kesp \
$CellContext`mrSESR; $CellContext`idivrber = $CellContext`kesp \
$CellContext`mrrber; $CellContext`idivms = $CellContext`kesp $CellContext`Ms; \
$CellContext`idiv = $CellContext`kesp; 
       For[$CellContext`j = 1, $CellContext`j < $CellContext`numfreq + 1, 
         Increment[$CellContext`j], 
         If[Part[$CellContext`idivberSES, $CellContext`j] > 200, 
           Part[$CellContext`idivberSES, $CellContext`j] = 200]; 
         If[Part[$CellContext`idivrber, $CellContext`j] > 200, 
           Part[$CellContext`idivrber, $CellContext`j] = 200]; 
         If[Part[$CellContext`idivms, $CellContext`j] > 200, 
           Part[$CellContext`idivms, $CellContext`j] = 200]; 
         If[Part[$CellContext`idiv, $CellContext`j] > 200, 
           Part[$CellContext`idiv, $CellContext`j] = 200]]; 
       Print["   O factor de melhoria da margem real \!\(\*SubscriptBox[\(ber\
\), \(SES\)]\), devido \[AGrave] utiliza\[CCedilla]\[ATilde]o de diversidade \
na espa\[CCedilla]o \[EAcute]:\n\!\(\*SubscriptBox[\(idiv\), \(berSES\)]\)=", \

         $CellContext`numdb[$CellContext`idivberSES]]; 
       Print["   O factor de melhoria da margem real rber, devido \[AGrave] \
utiliza\[CCedilla]\[ATilde]o de diversidade na espa\[CCedilla]o \[EAcute]:\n\
\!\(\*SubscriptBox[\(idiv\), \(rber\)]\)=", 
         $CellContext`numdb[$CellContext`idivrber]]; 
       Print["   O factor de melhoria da margem selectiva, devido \[AGrave] \
utiliza\[CCedilla]\[ATilde]o de diversidade na espa\[CCedilla]o \[EAcute]:\n\
\!\(\*SubscriptBox[\(idiv\), \(ms\)]\)=", 
         $CellContext`numdb[$CellContext`idivms]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Diversidade", " ", "na", " ", "frequ\[EHat]ncia", "  "}]}],
      ButtonFunction:>($CellContext`divers = $CellContext`sim; \
$CellContext`bota391 = 1; $CellContext`botn = 
        92/10; $CellContext`\[CapitalDelta]f = $CellContext`MyInput[
         "Introduza a separa\[CCedilla]\[ATilde]o entre portadoras em [GHz].\n\
No caso de fazer um varrimento de frequ\[EHat]ncias, coloque-as com o \
seguinte formato:\n   ex: 3 frequ\[EHat]ncias => {0.2,0.2,0.2} GHz", \
$CellContext`\[CapitalDelta]f]; 
       Print["Separa\[CCedilla]\[ATilde]o entre portadoras:  \
\[CapitalDelta]f= ", $CellContext`\[CapitalDelta]f, " GHz."]; 
       Print["  O di\[AHat]metro da antena principal \[EAcute] de ", \
$CellContext`diampri, 
         " m, sendo o seu rendimento de \[Eta]p= ", $CellContext`\[Eta]pri, 
         " ."]; Print[
        "  O di\[AHat]metro da antena secund\[AAcute]ria \[EAcute] de ", \
$CellContext`diamsec, 
         " m, sendo o seu rendimento de \!\(\*SubscriptBox[\(\[Eta]\), \(s\)]\
\)= ", $CellContext`\[Eta]sec, " ."]; 
       Print["Ganho da antena principal:  \!\(\*SubscriptBox[\(g\), \(p\)]\)= \
", 
         $CellContext`numdb[$CellContext`gp], " dB."]; 
       Print["Ganho da antena secund\[AAcute]ria:  \!\(\*SubscriptBox[\(g\), \
\(s\)]\)= ", 
         $CellContext`numdb[$CellContext`gs], 
         " dB."]; $CellContext`kfreq = (
          80.5 $CellContext`\[CapitalDelta]f) \
($CellContext`gsec/((($CellContext`f $CellContext`dkm) $CellContext`f) \
$CellContext`gpri)); $CellContext`muSESR = 
        10^($CellContext`MuSESR/10); $CellContext`murber = 
        10^($CellContext`Murber/10); $CellContext`mrSESR = 
        1/(1/$CellContext`muSESR + 1/$CellContext`Ms); $CellContext`mrrber = 
        1/(1/$CellContext`murber + 
         1/$CellContext`Ms); $CellContext`idivberSES = $CellContext`kfreq \
$CellContext`mrSESR; $CellContext`idivrber = $CellContext`kfreq \
$CellContext`mrrber; $CellContext`idivms = $CellContext`kfreq $CellContext`Ms; \
$CellContext`idiv = $CellContext`kfreq; 
       For[$CellContext`j = 1, $CellContext`j < $CellContext`numfreq + 1, 
         Increment[$CellContext`j], 
         If[Part[$CellContext`idivberSES, $CellContext`j] > 200, 
           Part[$CellContext`idivberSES, $CellContext`j] = 200]; 
         If[Part[$CellContext`idivrber, $CellContext`j] > 200, 
           Part[$CellContext`idivrber, $CellContext`j] = 200]; 
         If[Part[$CellContext`idivms, $CellContext`j] > 200, 
           Part[$CellContext`idivms, $CellContext`j] = 200]; 
         If[Part[$CellContext`idiv, $CellContext`j] > 200, 
           Part[$CellContext`idiv, $CellContext`j] = 200]]; 
       Print["   O factor de melhoria da margem real \!\(\*SubscriptBox[\(ber\
\), \(SES\)]\), devido \[AGrave] utiliza\[CCedilla]\[ATilde]o de diversidade \
na frequ\[EHat]ncia \[EAcute]:\n\!\(\*SubscriptBox[\(idiv\), \(berSES\)]\)=", \

         $CellContext`numdb[$CellContext`idivberSES]]; 
       Print["   O factor de melhoria da margem real rber, devido \[AGrave] \
utiliza\[CCedilla]\[ATilde]o de diversidade na frequ\[EHat]ncia \[EAcute]:\n\
\!\(\*SubscriptBox[\(idiv\), \(rber\)]\)=", 
         $CellContext`numdb[$CellContext`idivrber]]; 
       Print["   O factor de melhoria da margem selectiva, devido \[AGrave] \
utiliza\[CCedilla]\[ATilde]o de diversidade na frequ\[EHat]ncia \[EAcute]:\n\
\!\(\*SubscriptBox[\(idiv\), \(ms\)]\)=", 
