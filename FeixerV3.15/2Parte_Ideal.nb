   SubscriptBox["p", "equip"], TraditionalForm]]],
 " = 40 %\n\t1.10.  Indisponibilidade, percentagem de outras causas\t\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "outros"], TraditionalForm]]],
 " = 50 %\n\t1.10.  Fiabilidade, tempo m\[EAcute]dio entre avarias do emissor\
\t\t",
 Cell[BoxData[
  FormBox["MTBFemissor", TraditionalForm]]],
 " = 120 000 h\n\t1.10.  Fiabilidade, tempo m\[EAcute]dio entre avarias do \
desmodulador\t",
 Cell[BoxData[
  FormBox["MTBFdesmodulador", TraditionalForm]]],
 " = 140 000 h\n\t1.10.  Fiabilidade, tempo m\[EAcute]dio entre avarias do \
modulador\t",
 Cell[BoxData[
  FormBox["MTBFmodulador", TraditionalForm]]],
 " = 200 000 h\n\t1.10.  Fiabilidade, tempo m\[EAcute]dio entre avarias do \
receptor\t\t",
 Cell[BoxData[
  FormBox["MTBFreceptor", TraditionalForm]]],
 " = 200 000 h\n\t1.10.  Tempo para detec\[CCedilla]\[ATilde]o, repara\
\[CCedilla]\[ATilde]o e reposi\[CCedilla]\[ATilde]o da avaria\tMTTR = 6 h\n\t\
1.11.  Intensidade da chuva\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox["Rint", TraditionalForm]]],
 " = 42 mm/h\n\t1.12.  Folga dos guias\t\t\t\t\t\tfolga = 10 m\n\t1.14.  \
Desvanecimento---consultar cap. 3.3 [1]\t\t\tc0 = 6\n\t1.14.  \
Desvanecimento---consultar cap. 3.3 [1]\t\t\tclat = 0\n\t1.14.  \
Desvanecimento---consultar cap. 3.3 [1]\t\t\tclong = 3\n\t1.14.  \
Desvanecimento---consultar cap. 3.3 [1]\t\t\t",
