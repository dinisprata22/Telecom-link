Cell[BoxData[
 ButtonBox[
  RowBox[{"  ", 
   RowBox[{"Margens", " ", "cr\[IAcute]ticas", "  "}]}],
  ButtonFunction:>If[
    Or[$CellContext`bota20 =!= 1, $CellContext`bota21 =!= 
