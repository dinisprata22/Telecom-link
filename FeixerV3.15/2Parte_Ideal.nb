Cell[CellGroupData[{

Cell[TextData[StyleBox["\t3.4  Tipo de modula\[CCedilla]\[ATilde]o da \
portadora",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tNesta sec\[CCedilla]\[ATilde]o, tem a hip\[OAcute]tese de escolher uma das \
seguintes modula\[CCedilla]\[OTilde]es:\tAM, FSK, PSK ou QAM.
\tSe optar pela modula\[CCedilla]\[ATilde]o em amplitude (AM), escolhe-se o c\
\[OAcute]digo do sinal em banda de base, unipolar, bipolar ou \
multin\[IAcute]vel.
\tSe optar pela modula\[CCedilla]\[ATilde]o por desvio na frequ\[EHat]ncia \
(FSK), escolhe-se o processo de desmodula\[CCedilla]\[ATilde]o, coerente ou \
incoerente.\
\>", "Text",
 CellMargins->{{36, 47}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Modula\[CCedilla]\[ATilde]o", " ", "da", " ", "portadora", "  "}]}],
      ButtonFunction:>(Clear[$CellContext`modula, $CellContext`port]; While[
         And[$CellContext`modula =!= $CellContext`AM, $CellContext`modula =!= \
$CellContext`FSK, $CellContext`modula =!= $CellContext`PSK, \
$CellContext`modula =!= $CellContext`QAM], $CellContext`modula = \
$CellContext`MyInput[
          "Introduza a modula\[CCedilla]\[ATilde]o do sinal, AM, FSK, PSK ou \
QAM.\nPor favor, coloque em LETRA MAI\[CapitalUAcute]SCULA.\n\
Modula\[CCedilla]\[ATilde]o por omiss\[ATilde]o:  PSK", $CellContext`modula]]; 
       If[$CellContext`modula == $CellContext`AM, $CellContext`port = \
$CellContext`MyInput[
           "Introduza o c\[OAcute]digo do sinal em banda de base: unipolar, \
bipolar ou multinivel.", $CellContext`port]; While[
           
           And[$CellContext`port =!= $CellContext`unipolar, $CellContext`port =!= \
$CellContext`bipolar, $CellContext`port =!= $CellContext`multinivel], \
$CellContext`port = $CellContext`MyInput[
            "Introduza o c\[OAcute]digo do sinal em banda de base: unipolar, \
bipolar ou multinivel.", $CellContext`port]]; 
         Print["C\[OAcute]digo do sinal introduzido:  ", $CellContext`port, 
           " ."]]; If[$CellContext`modula == $CellContext`FSK, While[
           
           And[$CellContext`port =!= $CellContext`coerente, $CellContext`port =!= \
$CellContext`incoerente], $CellContext`port = $CellContext`MyInput[
             "   Introduza o processo de desmodula\[CCedilla]\[ATilde]o: \
coerente ou incoerente.", $CellContext`port]; $CellContext`port = \
$CellContext`MyInput[
             "   Introduza o processo de desmodula\[CCedilla]\[ATilde]o: \
coerente ou incoerente.", $CellContext`port]]; 
         Print["Processo de desmodula\[CCedilla]\[ATilde]o introduzido:  ", \
$CellContext`port, " ."]]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Taxa", " ", "de", " ", "erros", " ", "bin\[AAcute]ria", "  "}]}],
      ButtonFunction:>($CellContext`bota34 = 1; 
       Print["Modula\[CCedilla]\[ATilde]o colocada:  ", $CellContext`modula, 
         " ."]; If[
         And[$CellContext`modula =!= $CellContext`AM, $CellContext`modula =!= \
$CellContext`FSK, $CellContext`modula =!= $CellContext`PSK, \
$CellContext`modula =!= $CellContext`QAM], 
         Print["Introduza primeiro a modula\[CCedilla]\[ATilde]o!"], 
         If[$CellContext`modula == $CellContext`AM, 
           If[$CellContext`port == $CellContext`unipolar, $CellContext`pber[
               Pattern[$CellContext`cno, 
                Blank[]]] := (1/2) 
              Erfc[((1/2) 10^($CellContext`cno/10))^Rational[1, 2]]]; 
           If[$CellContext`port == $CellContext`bipolar, $CellContext`pber[
               Pattern[$CellContext`cno, 
                Blank[]]] := (3/4) 
              Erfc[((1/2) 10^($CellContext`cno/10))^Rational[1, 2]]]; 
           If[$CellContext`port == $CellContext`multin\[IAcute]vel, \
$CellContext`pber[
               Pattern[$CellContext`cno, 
                Blank[]]] := ((1/Log[
                2, $CellContext`mniveis]) (($CellContext`mniveis - 
                 1)/$CellContext`mniveis)) 
              Erfc[(1/($CellContext`mniveis - 1)) (10^($CellContext`cno/10))^
                 Rational[1, 2]]]]; 
         If[$CellContext`modula == $CellContext`FSK, 
           If[$CellContext`port == $CellContext`coerente, $CellContext`pber[
               Pattern[$CellContext`cno, 
                Blank[]]] := (1/2) 
              Erfc[((1/2) 10^($CellContext`cno/10))^Rational[1, 2]]]; 
           If[$CellContext`port == $CellContext`incoerente, $CellContext`pber[
              
               Pattern[$CellContext`cno, 
                Blank[]]] := (1/2) Exp[(-(1/2)) 10^($CellContext`cno/10)]]]; 
         If[$CellContext`modula == $CellContext`PSK, $CellContext`pber[
             Pattern[$CellContext`cno, 
              Blank[]]] := (1/Log[2, $CellContext`mniveis]) 
            Erfc[
             Sin[Pi/$CellContext`mniveis] (10^($CellContext`cno/10))^
               Rational[1, 2]]]; 
         If[$CellContext`modula == $CellContext`QAM, $CellContext`pber[
             Pattern[$CellContext`cno, 
              Blank[]]] := ((2/Log[
              2, $CellContext`mniveis]) (($CellContext`mniveis^Rational[1, 2] - 
               1)/$CellContext`mniveis^Rational[1, 2])) 
            Erfc[(10^($CellContext`cno/10)/2)^
               Rational[1, 2]/($CellContext`mniveis^Rational[1, 2] - 1)]]; 
         For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
           Increment[$CellContext`i], 
           Print[
           "A taxa de erros bin\[AAcute]ria em fun\[CCedilla]\[ATilde]o da \
rela\[CCedilla]\[ATilde]o \!\(\*FractionBox[\(C\), SubscriptBox[\(N\), \
\(0\)]]\) para a f = ", 
            Part[$CellContext`f, $CellContext`i], " e n\.ba niveis = ", 
            Part[$CellContext`mniveis, $CellContext`i], 
            " \[EAcute] \!\(\*SubscriptBox[\(P\), \(ber\)]\)= ", 
            Part[
             $CellContext`pber[C/Subscript[N, 0]], $CellContext`i], " ."]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236008390625*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Modula\[CCedilla]\[ATilde]o colocada:  \"\>", 
   "\[InvisibleSpace]", "PSK", "\[InvisibleSpace]", "\<\" .\"\>"}],
  SequenceForm[
  "Modula\[CCedilla]\[ATilde]o colocada:  ", $CellContext`PSK, " ."],
  Editable->False]], "Print",
 CellChangeTimes->{3.9557769743459663`*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"A taxa de erros bin\[AAcute]ria em fun\[CCedilla]\[ATilde]o da \
rela\[CCedilla]\[ATilde]o \\!\\(\\*FractionBox[\\(C\\), SubscriptBox[\\(N\\), \
\\(0\\)]]\\) para a f = \"\>", "\[InvisibleSpace]", "6", 
   "\[InvisibleSpace]", "\<\" e n\.ba niveis = \"\>", "\[InvisibleSpace]", 
   "4", "\[InvisibleSpace]", "\<\" \[EAcute] \\!\\(\\*SubscriptBox[\\(P\\), \
\\(ber\\)]\\)= \"\>", "\[InvisibleSpace]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Erfc", "[", 
     FractionBox[
      SqrtBox[
       SuperscriptBox["10", 
        FractionBox["C", 
         RowBox[{"10", " ", 
          SubscriptBox["N", "0"]}]]]], 
      SqrtBox["2"]], "]"}]}], "\[InvisibleSpace]", "\<\" .\"\>"}],
  SequenceForm[
  "A taxa de erros bin\[AAcute]ria em fun\[CCedilla]\[ATilde]o da rela\
\[CCedilla]\[ATilde]o \!\(\*FractionBox[\(C\), SubscriptBox[\(N\), \(0\)]]\) \
para a f = ", 6, " e n\.ba niveis = ", 4, 
   " \[EAcute] \!\(\*SubscriptBox[\(P\), \(ber\)]\)= ", Rational[1, 2] 
   Erfc[2^Rational[-1, 2] (10^(Rational[1, 10] C/Subscript[N, 0]))^
      Rational[1, 2]], " ."],
  Editable->False]], "Print",
 CellChangeTimes->{3.955776974396804*^9}]
}, Open  ]]
}, Open  ]],

