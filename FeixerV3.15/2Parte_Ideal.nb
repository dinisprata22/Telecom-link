             "(C/N)nec da cl\[AAcute]usula ESR", FontSize -> 11, FontWeight -> 
              Bold, FontColor -> 
              RGBColor[0, 0, 1]], {(1/2) (
               Part[$CellContext`f, $CellContext`numfreq] + 
