Cell["\<\
\tA temperatura vista pelas antenas \[EAcute] de 293 K.\
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Factor", " ", "de", " ", "ru\[IAcute]do", "  "}]}],
     ButtonFunction:>($CellContext`uotrei = $CellContext`sim; \
$CellContext`nfr = $CellContext`MyInput[
        "Introduza, para cada frequ\[EHat]ncia, o factor de ru\[IAcute]do, em \
dB.\nIndique os valores ENTRE CHAVETAS.\nExemplo: {7.2,7.4,7.6,7.8,8.}\n\n\
Alternativamente, introduza a express\[ATilde]o do factor de ru\[IAcute]do em \
dB.\nA vari\[AAcute]vel  f  indica a frequ\[EHat]ncia.\nExemplo:  7.0+0.1*f", \
$CellContext`nfr]; 
      Print["O factor de ru\[IAcute]do da liga\[CCedilla]\[ATilde]o \
\[EAcute]:\n\!\(\*SubscriptBox[\(n\), \(f\)]\)=", 
        $CellContext`numdb[$CellContext`nfr], " dB."]),
     Evaluator->Automatic], 
    ButtonBox[
     RowBox[{"  ", 
      RowBox[{"Rela\[CCedilla]\[ATilde]o", "  ", 
       RowBox[{"portadora", "/", "ru\[IAcute]do"}], " ", "em", " ", "RF", 
       "  "}]}],
     ButtonFunction:>($CellContext`bota35 = 1; $CellContext`botn = 7; 
      If[$CellContext`uotrei == $CellContext`sim, 
        Print["Temperatura observada pela antena:  T= 293 K."]; \
$CellContext`n0[
           Pattern[$CellContext`banrf, 
            Blank[]]] := 
         10 Log[10, (((1.380658 10^(-23)) 293) $CellContext`banrf) 
            10^6]; $CellContext`N0 = $CellContext`n0[$CellContext`brf/(
           1 + $CellContext`\[Beta]exb)]; 
        Print["O ru\[IAcute]do t\[EAcute]rmico \[EAcute] \
\!\(\*SubscriptBox[\(n\), \(0\)]\)=", 
          $CellContext`numdb[$CellContext`N0], 
          " dBW."]; $CellContext`nruido = $CellContext`N0 + $CellContext`nfr; 
        Print["   O ru\[IAcute]do aos terminais do desmodulador \[EAcute]:\n\
\!\(\*SubscriptBox[\(n\), \(ru\[IAcute]do\)]\)=", 
          $CellContext`numdb[$CellContext`nruido], 
          " dBW."]; $CellContext`cn = $CellContext`pr - $CellContext`nruido; 
        Print["   A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do em \
condi\[CCedilla]\[OTilde]es ideais de propaga\[CCedilla]\[ATilde]o \[EAcute]:\
\n(\!\(\*FractionBox[\(C\), \(N\)]\)\!\(\*SubscriptBox[\()\), \(rf\)]\)= ", 
          $CellContext`numdb[$CellContext`cn], " dB."]]),
     Evaluator->Automatic]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.5152360084375*^9},
