       RowBox[{"Zona", " ", "K"}]}], 
      RowBox[{"  ", 
       RowBox[{
        RowBox[{
         RowBox[{"Percentagem", " ", "de", " ", "tempo"}], ",", "\n", "   ", 
         RowBox[{"no", " ", "ano"}], ",", 
         RowBox[{"em", " ", "que", " ", "o", " ", "valor"}]}], "\n", "      ", 
        RowBox[{"da", " ", "intensidade", " ", "de"}], "\n", 
        RowBox[{
        "precipita\[CCedilla]\[ATilde]o", " ", "\[EAcute]", " ", 
         "excedido"}]}]}]},
     {"2", "1.5", "1"},
     {"4", "4.2", "0.3"},
     {"10", "12", "0.1"},
     {"18", "23", "0.03"},
     {"32", 
      StyleBox["42",
       FontWeight->"Bold",
       FontColor->GrayLevel[0],
       Background->None], 
      StyleBox["0.01",
       FontWeight->"Bold",
       FontColor->GrayLevel[0],
