   RowBox[{"{", "0.04996540966666667`", "}"}], 
   "\[InvisibleSpace]", "\<\" m.\"\>"}],
  SequenceForm[
  "O comprimento de onda em utiliza\[CCedilla]\[ATilde]o \[EAcute] \
\[Lambda]=", {0.04996540966666667}, " m."],
  Editable->False]], "Print",
 CellChangeTimes->{3.9557767926969814`*^9}]
}, Open  ]]
