Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{" ", "ESR", " "}],
      ButtonFunction:>($CellContext`esrcn[
          Pattern[$CellContext`cn, 
           Blank[]]] := 
        Module[{$CellContext`Murber, $CellContext`murber, \
$CellContext`mrrber, $CellContext`Prber, $CellContext`sesr, \
$CellContext`mabs, $CellContext`\[Alpha]33, $CellContext`esr}, \
$CellContext`Murber = $CellContext`cn - $CellContext`CNrber; \
$CellContext`murber = 10^($CellContext`Murber/10); $CellContext`mrrber = 
           1/(1/$CellContext`murber + 
            1/$CellContext`Ms); $CellContext`Prber = \
$CellContext`kt[]/$CellContext`mrrber; $CellContext`sesr = \
$CellContext`sesrcn[$CellContext`cn]; $CellContext`mabs = 
           Abs[Log[10, $CellContext`rber/$CellContext`berSESR[]]/Log[
             10, $CellContext`Prber/$CellContext`sesr]]; \
$CellContext`\[Alpha]33 = 
           1; $CellContext`esr = $CellContext`sesr $CellContext`nn[]^(
               1/$CellContext`mabs) + ($CellContext`nn[] $CellContext`Nb[]) \
($CellContext`rber/$CellContext`\[Alpha]33)]; $CellContext`CNforESR = 
        Table[0, {$CellContext`a, $CellContext`numfreq}]; \
$CellContext`calcCNforESR[
          Pattern[$CellContext`n, 
           Blank[]]] := Part[
          FindRoot[Part[
             $CellContext`esrcn[$CellContext`CN], $CellContext`n] == \
$CellContext`ESR, {$CellContext`CN, 30.}], 1, 2]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         Part[$CellContext`CNforESR, $CellContext`i] = \
$CellContext`calcCNforESR[$CellContext`i]]; $CellContext`esr = \
$CellContext`esrcn[$CellContext`cn]; 
       Print["Valor da norma ESR = ", $CellContext`ESR]; 
       For[$CellContext`i = 0, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         If[Part[$CellContext`esr, $CellContext`i] <= $CellContext`ESR, 
          Print["f=", 
           Part[$CellContext`f, $CellContext`i], 
           " - Cl\[AAcute]usula cumprida, esr=", 
           Part[$CellContext`esr, $CellContext`i]], 
          Print["f=", 
           Part[$CellContext`f, $CellContext`i], 
           " - Cl\[AAcute]usula n\[ATilde]o cumprida, esr=", 
           Part[$CellContext`esr, $CellContext`i]]]]; 
       Print["A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do necess\
\[AAcute]ria para cumprir a cl\[AAcute]usula ESR \[EAcute] \
(\!\(\*FractionBox[\(C\), \(N\)]\)\!\(\*SubscriptBox[\()\), \(CIP_ESR\)]\)=", \

         $CellContext`numdb[$CellContext`CNforESR], " dB."]),
