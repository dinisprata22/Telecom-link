Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["\t",
  FontColor->RGBColor[1, 1, 0]],
 "3.2  Fiabilidade do equipamento"
}], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell["\<\
\tNa caracteriza\[CCedilla]\[ATilde]o da fiabilidade de um equipamento \
\[EAcute] habitual considerar que as avarias t\[EHat]m uma distribui\
\[CCedilla]\[ATilde]o exponencial negativa, caracterizada por um tempo m\
\[EAcute]dio entre acontecimentos. A indisponibilidade do equipamento, por \
liga\[CCedilla]\[ATilde]o bidireccional, deve cumprir a recomenda\[CCedilla]\
\[ATilde]o da ITU-R.\
\>", "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"MTBF", " ", "/", " ", "MTTR", "  "}]}],
      ButtonFunction:>($CellContext`MTBFemissor = $CellContext`MyInput[
         "Introduza o tempo m\[EAcute]dio entre avarias do emissor em \
[horas]", $CellContext`MTBFemissor]; $CellContext`MTBFdesmodulador = \
$CellContext`MyInput[
         "Introduza o tempo m\[EAcute]dio entre avarias do desmodulador em \
[horas]", $CellContext`MTBFdesmodulador]; $CellContext`MTBFmodulador = \
$CellContext`MyInput[
         "Introduza o tempo m\[EAcute]dio entre avarias do modulador em \
[horas]", $CellContext`MTBFmodulador]; $CellContext`MTBFreceptor = \
$CellContext`MyInput[
         "Introduza o tempo m\[EAcute]dio entre avarias do receptor em \
[horas]", $CellContext`MTBFreceptor]; $CellContext`mttr = \
$CellContext`MyInput[
         "Introduza o tempo m\[EAcute]dio para detec\[CCedilla]\[ATilde]o, \
repara\[CCedilla]\[ATilde]o e reposi\[CCedilla]\[ATilde]o de uma avaria em \
[horas]", $CellContext`mttr]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Fiabilidade", " ", "base", "  "}]}],
      ButtonFunction:>($CellContext`introu = $CellContext`sim; 
       Print["O tempo m\[EAcute]dio entre avarias do emissor: \
\!\(\*SubscriptBox[\(MTBF\), \(emissor\)]\)= ", 
         $CellContext`numpr[$CellContext`MTBFemissor], " h ."]; 
       Print["O tempo m\[EAcute]dio entre avarias do desmodulador: \
\!\(\*SubscriptBox[\(MTBF\), \(desmodulador\)]\)= ", 
         $CellContext`numpr[$CellContext`MTBFdesmodulador], " h ."]; 
       Print["O tempo m\[EAcute]dio entre avarias do modulador: \
\!\(\*SubscriptBox[\(MTBF\), \(modulador\)]\)= ", 
         $CellContext`numpr[$CellContext`MTBFmodulador], " h ."]; 
       Print["O tempo m\[EAcute]dio entre avarias do receptor: \
\!\(\*SubscriptBox[\(MTBF\), \(receptor\)]\)= ", 
         $CellContext`numpr[$CellContext`MTBFreceptor], " h ."]; 
       Print[
        "O tempo m\[EAcute]dio para detec\[CCedilla]\[ATilde]o, repara\
\[CCedilla]\[ATilde]o e reposi\[CCedilla]\[ATilde]o de uma avaria: MTTR= ", 
         $CellContext`numpr[$CellContext`mttr], " h ."]; 
       Print["   Recorda-se que a indisponibilidade devida ao equipamento \
recomendada \[EAcute] \!\(\*SubscriptBox[\(\[ScriptCapitalI]\), \(equip\)]\)= \
", 
         $CellContext`numpr[$CellContext`\[ScriptCapitalI]equip], 
         " ."]; $CellContext`MTBFbi1 = (1/2)/(1/$CellContext`MTBFemissor + 
         1/$CellContext`MTBFdesmodulador + 1/$CellContext`MTBFmodulador + 
         1/$CellContext`MTBFreceptor); 
       Print["   Tempo m\[EAcute]dio entre avarias de uma s\[EAcute]rie de \
elementos usando 1 canal bidireccional:  \!\(\*SubscriptBox[\(MTBF\), \(bi\)]\
\)= ", 
         N[$CellContext`MTBFbi1], 
         " h ."]; $CellContext`\[ScriptCapitalI]equip1 = \
$CellContext`mttr/$CellContext`MTBFbi1; 
       Print["   A indisponibilidade devida ao equipamento usando 1 canal \
bidireccional \[EAcute] \!\(\*SubscriptBox[\(\[ScriptCapitalI]\), \(equip1\)]\
\)= ", 
         $CellContext`numpr[
          N[$CellContext`\[ScriptCapitalI]equip1]], " ."]; 
       If[$CellContext`\[ScriptCapitalI]equip <= $CellContext`\
\[ScriptCapitalI]equip1, 
         Print[
         "   A indisponibilidade n\[ATilde]o cumpre a recomenda\[CCedilla]\
\[ATilde]o, aconselha-se a adop\[CCedilla]\[ATilde]o de uma configura\
\[CCedilla]\[ATilde]o com canal de reserva.\nA instala\[CCedilla]\[ATilde]o \
de 1 canal de reserva implica a exist\[EHat]ncia de 2 comutadores (um em cada \
terminal)."], 
         Print[
         "A indisponibilidade devido ao equipamento cumpre a recomenda\
\[CCedilla]\[ATilde]o da ITU-R."]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Canal", " ", "de", " ", "reserva", "  "}]}],
      ButtonFunction:>(Clear[$CellContext`reserva, $CellContext`elementos]; 
       If[$CellContext`introu == $CellContext`sim, $CellContext`reserva = \
$CellContext`MyInput[
           "Introduza o n\[UAcute]mero de elementos de reserva (habitualmente \
apenas 1).", $CellContext`reserva]; While[
           
           And[$CellContext`reserva =!= 1, $CellContext`reserva =!= 
            2, $CellContext`reserva =!= 
            3], $CellContext`reserva = $CellContext`MyInput[
            "Introduza o n\[UAcute]mero de elementos de reserva \
(habitualmente apenas 1).", $CellContext`reserva]]; 
         Print["O n\[UAcute]mero de elementos de reserva:  ", \
$CellContext`reserva, " ."]; $CellContext`elementos = $CellContext`MyInput[
           "Introduza o n\[UAcute]mero de elementos de servi\[CCedilla]o em \
paralelo (usualmente 1, 2, 3 ou 4).", $CellContext`elementos]; While[
           
           And[$CellContext`elementos =!= 1, $CellContext`elementos =!= 
            2, $CellContext`elementos =!= 3, $CellContext`elementos =!= 
            4], $CellContext`elementos = $CellContext`MyInput[
            "Introduza o n\[UAcute]mero de elementos de servi\[CCedilla]o em \
paralelo (usualmente 1, 2, 3 ou 4).", $CellContext`elementos]]; 
         Print["O n\[UAcute]mero de elementos de servi\[CCedilla]o em \
paralelo:  ", $CellContext`elementos, " ."]; 
         If[$CellContext`elementos == 
           1, $CellContext`MTBFcomutador1 = $CellContext`MyInput[
             "Introduza o tempo m\[EAcute]dio entre avarias do comutador 1+1 \
em [horas]", 90000]; 
           Print["O tempo m\[EAcute]dio entre avarias do comutador 1+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador1\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador1], 
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador1]; 
         If[$CellContext`elementos == 
           2, $CellContext`MTBFcomutador2 = $CellContext`MyInput[
             "Introduza o tempo m\[EAcute]dio entre avarias do comutador 2+1 \
em [horas]", 78000]; 
           Print["O tempo m\[EAcute]dio entre avarias do comutador 2+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador2\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador2], 
             
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador2]; 
         If[$CellContext`elementos == 
           3, $CellContext`MTBFcomutador3 = $CellContext`MyInput[
             "Introduza o tempo m\[EAcute]dio entre avarias do comutador 3+1 \
em [horas]", 72000]; 
           Print["O tempo m\[EAcute]dio entre avarias do comutador 3+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador3\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador3], 
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador3]; 
         If[$CellContext`elementos == 
           4, $CellContext`MTBFcomutador4 = $CellContext`MyInput[
             "Introduza o tempo m\[EAcute]dio entre avarias do comutador 4+1 \
em [horas]", 67000]; 
           Print["O tempo m\[EAcute]dio entre avarias do comutador 4+1:  \!\(\
\*SubscriptBox[\(MTBF\), \(comutador4\)]\)= ", 
             $CellContext`numpr[$CellContext`MTBFcomutador4], 
             " h ."]; $CellContext`MTBFcomutador = \
$CellContext`MTBFcomutador4]; If[
           
           And[$CellContext`elementos != 1, $CellContext`elementos != 
            2, $CellContext`elementos != 3, $CellContext`elementos != 4], 
           Print[
           "Aten\[CCedilla]\[ATilde]o -> Coloque 1, 2, 3 ou 4 elementos \
emissor/receptor."]]; $CellContext`MTBFcomut = $CellContext`MTBFcomutador/2; 
         Print["   Tempo m\[EAcute]dio entre avarias dos comutadores, numa \
liga\[CCedilla]\[ATilde]o bidireccional:  \!\(\*SubscriptBox[\(MTBF\), \
\(comut\)]\)= ", 
           N[$CellContext`MTBFcomut], 
           " h ."]; $CellContext`MTBFligacao = $CellContext`mttr/(
           Binomial[$CellContext`elementos + $CellContext`reserva, \
$CellContext`reserva + 
             1] ($CellContext`mttr/$CellContext`MTBFbi1)^($CellContext`\
reserva + 1)); 
         Print["   Tempo m\[EAcute]dio entre avarias da liga\[CCedilla]\
\[ATilde]o, excluindo os comutadores:  \!\(\*SubscriptBox[\(MTBF\), \(liga\
\[CCedilla]\[ATilde]o\)]\)= ", 
           N[$CellContext`MTBFligacao], 
           " h ."]; $CellContext`MTBFbir = (1/$CellContext`MTBFligacao + 
            1/$CellContext`MTBFcomut)^(-1); 
         Print["   Tempo m\[EAcute]dio entre avarias da liga\[CCedilla]\
\[ATilde]o:  \!\(\*SubscriptBox[\(MTBF\), \(bir\)]\)= ", 
           N[$CellContext`MTBFbir], 
           " h ."]; $CellContext`\[ScriptCapitalI]equipr = \
$CellContext`mttr/$CellContext`MTBFbir; 
         Print["   A indisponibilidade devida ao equipamento usando ", \
$CellContext`reserva, 
           " canal de reserva \[EAcute] \
\!\(\*SubscriptBox[\(\[ScriptCapitalI]\), \(equipr\)]\)= ", 
           $CellContext`numpr[
            N[$CellContext`\[ScriptCapitalI]equipr]], " ."]; 
         If[$CellContext`\[ScriptCapitalI]equip <= $CellContext`\
\[ScriptCapitalI]equipr, 
           Print[
           "   A indisponibilidade n\[ATilde]o cumpre a recomenda\[CCedilla]\
\[ATilde]o pois ", 
            $CellContext`numpr[
             N[$CellContext`\[ScriptCapitalI]equipr]], " > ", 
            $CellContext`numpr[
             N[$CellContext`\[ScriptCapitalI]equip]], " ."], 
           Print[
           "A indisponibilidade devido ao equipamento cumpre a recomenda\
\[CCedilla]\[ATilde]o da ITU-R."]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236008296875*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

