         10^((1 - $CellContext`rcl) 
            Log[10, $CellContext`kfgt] + (0.5 $CellContext`rcl) (
             Log[10, $CellContext`kcl] + Log[10, $CellContext`kcm])); 
        If[$CellContext`classif == $CellContext`terrestre, $CellContext`kgeo = \
$CellContext`kfgt; 
          Print["   O factor geoclim\[AAcute]tico no m\[EHat]s mais desfavor\
\[AAcute]vel, no percurso terrestre \[EAcute] K= ", 
            $CellContext`numpr[$CellContext`kgeo], " ."]]; 
        If[$CellContext`classif == $CellContext`costeiro, $CellContext`kgeo = \
$CellContext`kfgc; 
          Print["   O factor geoclim\[AAcute]tico no m\[EHat]s mais desfavor\
\[AAcute]vel, no percurso costeiro \[EAcute] K= ", 
            $CellContext`numpr[$CellContext`kgeo], " ."]]; $CellContext`h11[
           Pattern[$CellContext`ll, 
            Blank[]]] := If[$CellContext`ll == 1, $CellContext`hae, 
           
           Part[$CellContext`hemipassivo, $CellContext`ll - 
            1]]; $CellContext`l11[
           Pattern[$CellContext`ll, 
            Blank[]]] := If[$CellContext`ll == 1, 1, 
           
           Part[$CellContext`pontospassivo, $CellContext`ll - 
            1]]; $CellContext`h22[
           Pattern[$CellContext`ll, 
            Blank[]]] := 
         If[$CellContext`ll == $CellContext`passivo + 1, $CellContext`har, 
           Part[$CellContext`hrecpassivo, $CellContext`ll]]; $CellContext`l22[
          
           Pattern[$CellContext`ll, 
            Blank[]]] := 
         If[$CellContext`ll == $CellContext`passivo + 1, $CellContext`l, 
           
           Part[$CellContext`pontospassivo, $CellContext`ll]]; \
$CellContext`ppn[
           Pattern[$CellContext`aaux, 
            Blank[]]] := 
         10^(-($CellContext`aaux/10)); $CellContext`\[Epsilon]p[
           Pattern[$CellContext`cotar, 
            Blank[]], 
           Pattern[$CellContext`cotae, 
            Blank[]], 
           Pattern[$CellContext`dista, 
            Blank[]]] := 
         Abs[$CellContext`cotar - $CellContext`cotae]/$CellContext`dista; \
$CellContext`prob1[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := ((($CellContext`kgeo $CellContext`dist14^3.6) 
            Part[$CellContext`f, $CellContext`jj]^0.89) (1 + 
             Abs[$CellContext`\[Epsilon]14])^(-1.4)) \
$CellContext`ppn[$CellContext`aaux]; $CellContext`qav[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := (-20) (
           Log[10, -
             Log[1 - $CellContext`prob1[$CellContext`aaux, \
$CellContext`jj]]]/$CellContext`aaux); $CellContext`qtv[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            
            Blank[]]] := ($CellContext`qav[$CellContext`aaux, \
$CellContext`jj] - 2)/((1 + 0.3 10^(-($CellContext`aaux/20))) 
           10^((-0.016) $CellContext`aaux)) - 
          4.3 (10^(-($CellContext`aaux/20)) + $CellContext`aaux/
            800); $CellContext`qa[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`ii, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := 
         2 + ((1 + 0.3 10^(-($CellContext`aaux/20))) 
            10^((-0.016) $CellContext`aaux)) (
            Part[$CellContext`qt, $CellContext`ii, $CellContext`jj] + 
            4.3 (10^(-($CellContext`aaux/20)) + $CellContext`aaux/
               800)); $CellContext`prob2[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`ii, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := 
         1 - Exp[-10^((-$CellContext`qa[$CellContext`aaux, $CellContext`ii, \
$CellContext`jj]) ($CellContext`aaux/20))]; 
        For[$CellContext`i = 1, $CellContext`i <= $CellContext`passivo + 1, 
          
          Increment[$CellContext`i], $CellContext`dist14 = (
             Part[$CellContext`d, 
               $CellContext`l22[$CellContext`i]] - Part[$CellContext`d, 
              $CellContext`l11[$CellContext`i]])/$CellContext`km; \
$CellContext`hemi14 = Part[$CellContext`h, 
              $CellContext`l11[$CellContext`i]] + \
$CellContext`h11[$CellContext`i]; $CellContext`hrec14 = Part[$CellContext`h, 
              $CellContext`l22[$CellContext`i]] + \
$CellContext`h22[$CellContext`i]; $CellContext`\[Epsilon]14 = $CellContext`\
\[Epsilon]p[$CellContext`hrec14, $CellContext`hemi14, $CellContext`dist14]; \
$CellContext`desvan = 
           Table[0., {$CellContext`j, $CellContext`numfreq}]; \
$CellContext`metodo2 = Table[0., {$CellContext`j, $CellContext`numfreq}]; 
          For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
            Increment[$CellContext`j], 
            Part[$CellContext`desvan, $CellContext`j] = 
             If[$CellContext`qtv[$CellContext`desvanec, $CellContext`j] > 0, 
               25, 35]; 
            Part[$CellContext`qt, $CellContext`i, $CellContext`j] = \
$CellContext`qtv[
               Part[$CellContext`desvan, $CellContext`j], $CellContext`j]; 
            Part[$CellContext`metodo2, $CellContext`j] = $CellContext`prob2[
               
               Part[$CellContext`desvan, $CellContext`j], $CellContext`i, \
$CellContext`j]]; 
          If[$CellContext`passivo >= 1, 
            Print["Tro\[CCedilla]o ", $CellContext`i, 
              " da liga\[CCedilla]\[ATilde]o:"]; 
            Print["   O m\[OAcute]dulo da inclina\[CCedilla]\[ATilde]o \
\[EAcute] \!\(\*SubscriptBox[\(\[Epsilon]\), \(p\)]\)=", 
              $CellContext`numdb[
               N[$CellContext`\[Epsilon]14]], " miliradianos."]; 
            Print["   O par\[AHat]metro \!\(\*SubscriptBox[\(q\), \(t\)]\) \
calculado com um desvanecimento de ", $CellContext`desvan, 
              " dB, \[EAcute]:\n   qt=", 
              $CellContext`numdb[
               Part[$CellContext`qt, $CellContext`i]], "."]; 
            Print["   A frac\[CCedilla]\[ATilde]o de tempo calculada pelo 2\
\.ba m\[EAcute]todo da Rec. P.530-8 \[EAcute]:\n   PA2=", 
              $CellContext`numpr[$CellContext`metodo2], 
              "."]; $CellContext`PA2 = $CellContext`PA2 + \
$CellContext`metodo2]]; 
        If[$CellContext`passivo == 0, 
          Print["   O m\[OAcute]dulo da inclina\[CCedilla]\[ATilde]o da liga\
\[CCedilla]\[ATilde]o \[EAcute] \!\(\*SubscriptBox[\(\[Epsilon]\), \(p\)]\)=", 
            $CellContext`numdb[
             N[$CellContext`\[Epsilon]14]], " miliradianos."]; 
          Print["   O par\[AHat]metro \!\(\*SubscriptBox[\(q\), \(t\)]\) \
calculado com um desvanecimento de ", $CellContext`desvan, 
            " dB, \[EAcute]:\n   qt=", 
            $CellContext`numdb[
             Part[$CellContext`qt, 1]], 
            "."]; $CellContext`PA2 = $CellContext`metodo2]; 
        Print["Liga\[CCedilla]\[ATilde]o total:"]; 
        Print["   A frac\[CCedilla]\[ATilde]o de tempo calculada pelo 2\.ba m\
\[EAcute]todo da Rec. P.530-8, correspondente \[AGrave] liga\[CCedilla]\
\[ATilde]o total \[EAcute]:\n   PA2=", 
          $CellContext`numpr[$CellContext`PA2], "."]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
