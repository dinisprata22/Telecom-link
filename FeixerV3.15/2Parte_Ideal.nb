      Part[$CellContext`hin, $CellContext`i] = 
       Part[$CellContext`in, $CellContext`i, 2]; 
      If[Part[$CellContext`hin, $CellContext`i] >= $CellContext`pico, \
$CellContext`pico = 
         Part[$CellContext`hin, $CellContext`i]; $CellContext`mh = \
$CellContext`i]]; $CellContext`dm = 
     Part[$CellContext`d, $CellContext`l]; $CellContext`dkm = \
$CellContext`dm/$CellContext`km; $CellContext`planin = 
     ListPlot[$CellContext`in, Joined -> True, PlotStyle -> 
       Hue[0.7, 0.7, 0.5], Frame -> True, PlotLabel -> 
       Style[$CellContext`nomlig, FontSize -> 12], FrameLabel -> {
         Style["Dist\[AHat]ncia [km]", FontSize -> 12], 
         Style["Cota [m]", FontSize -> 12]}, 
       PlotRange -> {{0, $CellContext`dkm}, {0, $CellContext`pico + 20}}, 
       ImageSize -> {400, 400}]; 
    For[$CellContext`j = 1; $CellContext`npontos = 
       0, $CellContext`j <= $CellContext`l, 
      Increment[$CellContext`j], 
      If[Part[$CellContext`hin, $CellContext`j] <= 100, 
       Increment[$CellContext`npontos]]]; $CellContext`rcl = \
$CellContext`npontos/$CellContext`l; 
    Print[$CellContext`planin, 
      "\nO percurso tem uma percentagem de cotas inferiores a 100 m de rc=", 
      $CellContext`numdb[
       N[$CellContext`rcl 100]], "%."]; 
    Print["A dist\[AHat]ncia total da liga\[CCedilla]\[ATilde]o \[EAcute] de \
", $CellContext`dkm, " km.\n"]],
  Evaluator->Automatic]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.51523600578125*^9},
 FontColor->RGBColor[1, 1, 0]],

