    "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela \
sec\[CCedilla]\[ATilde]o 2.", 
     N[$CellContext`botn]], $CellContext`bota291 = 1; 
    If[$CellContext`analog == $CellContext`telefonia, $CellContext`m1 = \
$CellContext`SNbf - $CellContext`f20 - $CellContext`SNbf20; $CellContext`m2 = \
$CellContext`SNbf - $CellContext`f01 - $CellContext`SNbf01; $CellContext`m3 = \
$CellContext`SNbf - $CellContext`f3 - $CellContext`pondt - \
$CellContext`SNbfch]; 
    If[$CellContext`analog == $CellContext`video, $CellContext`m1 = \
$CellContext`SNbf - 
        57; $CellContext`m2 = $CellContext`SNbf - $CellContext`f01 - 
        45; $CellContext`m3 = $CellContext`SNbf - $CellContext`f3 - \
$CellContext`pondv - $CellContext`SNbfch]; $CellContext`lts = \
$CellContext`nruido + 11; 
    Print["   A margem cr\[IAcute]tica para a 1\.aa cl\[AAcute]usula:\nm1=", 
      $CellContext`numdb[$CellContext`m1], " dB."]; 
    Print["   A margem cr\[IAcute]tica para a 2\.aa cl\[AAcute]usula:\nm2=", 
      $CellContext`numdb[$CellContext`m2], " dB."]; 
    Print["   A margem cr\[IAcute]tica para o corte:\nm3=", 
      $CellContext`numdb[$CellContext`m3], " dB."]; $CellContext`margemat1 = 
     Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m1, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margemat2 = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m2, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margematch = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`m3, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`margelts = Table[{
        Part[$CellContext`f, $CellContext`x], 
        Part[$CellContext`lts, $CellContext`x]}, {$CellContext`x, \
$CellContext`numfreq}]; $CellContext`grafmargat1 = 
     ListPlot[$CellContext`margemat1, Joined -> True, PlotStyle -> 
       RGBColor[1, 0, 1], DisplayFunction -> 
       Identity]; $CellContext`grafmargat2 = 
     ListPlot[$CellContext`margemat2, Joined -> True, PlotStyle -> 
       RGBColor[0, 0, 1], DisplayFunction -> 
       Identity]; $CellContext`grafmargatch = 
     ListPlot[$CellContext`margematch, Joined -> True, PlotStyle -> 
       GrayLevel[0], DisplayFunction -> Identity]; $CellContext`graflts = 
     ListPlot[$CellContext`margelts, Joined -> True, PlotStyle -> 
       RGBColor[0, 0, 0], DisplayFunction -> 
       Identity]; $CellContext`mcriticaux = Table[
       Min[
        Part[$CellContext`m1, $CellContext`j], 
        Part[$CellContext`m2, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`mcritica = Table[
       Min[
        Part[$CellContext`mcriticaux, $CellContext`j], 
        Part[$CellContext`m3, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; 
    For[$CellContext`i = 
       1; $CellContext`moptima = -200, $CellContext`i <= $CellContext`numfreq, 
      Increment[$CellContext`i], 
      If[$CellContext`moptima < 
       Part[$CellContext`mcritica, $CellContext`i], $CellContext`foptima = 
        Part[$CellContext`f, $CellContext`i]; $CellContext`moptima = 
        Part[$CellContext`mcritica, $CellContext`i]]]; $CellContext`ymaxaux1 = 
     Table[
       Max[
        Part[$CellContext`m1, $CellContext`j], 
        Part[$CellContext`m2, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; $CellContext`ymaxaux2 = Table[
       Max[
        Part[$CellContext`ymaxaux1, $CellContext`j], 
        Part[$CellContext`m3, $CellContext`j]], {$CellContext`j, \
$CellContext`numfreq}]; 
    For[$CellContext`j = 
       1; $CellContext`ymax = -200, $CellContext`j <= $CellContext`numfreq, 
      Increment[$CellContext`j], 
      If[$CellContext`ymax < 
       Part[$CellContext`ymaxaux2, $CellContext`j], $CellContext`ymax = 
       Part[$CellContext`ymaxaux2, $CellContext`j]]]; 
    For[$CellContext`j = 1; $CellContext`ymin = 
       100, $CellContext`j <= $CellContext`numfreq, 
      Increment[$CellContext`j], 
      If[$CellContext`ymin > 
       Part[$CellContext`mcritica, $CellContext`j], $CellContext`ymin = 
       Part[$CellContext`mcritica, $CellContext`j]]]; 
    If[$CellContext`ymax < 3, $CellContext`ymax = 10]; 
    If[$CellContext`numfreq =!= 1, 
      Show[$CellContext`grafmargat1, $CellContext`grafmargat2, \
$CellContext`grafmargatch, $CellContext`graflts, 
       Graphics[{
         Dashing[{0.01, 0.01}], 
         Line[{{
            Part[$CellContext`f, 1], 3}, {
            Part[$CellContext`f, $CellContext`numfreq], 3}}]}], 
       Graphics[
        Text[
         StyleForm["LTS", FontSize -> 11, FontColor -> RGBColor[0, 0, 0]], {
          Part[$CellContext`f, 
           Floor[$CellContext`numfreq/3]], Part[$CellContext`lts, 
            Floor[$CellContext`numfreq/2]] + 2}]], 
       Graphics[
        Text[
         StyleForm[
         "Margem da 1\.aa cl\[AAcute]usula", FontSize -> 11, FontColor -> 
          RGBColor[1, 0, 1]], {
          Part[$CellContext`f, 
           Floor[$CellContext`numfreq/2]], Part[$CellContext`m1, 
            Floor[$CellContext`numfreq/2]] + 2}]], 
       Graphics[
        Text[
         StyleForm[
         "Margem da 2\.aa cl\[AAcute]usula", FontSize -> 11, FontColor -> 
          RGBColor[0, 0, 1]], {
          Part[$CellContext`f, 
           Floor[$CellContext`numfreq/2]], Part[$CellContext`m2, 
            Floor[$CellContext`numfreq/2]] + 2}]], 
       Graphics[
        Text[
         StyleForm[
         "Margem da 3\.aa cl\[AAcute]usula", FontSize -> 11, FontColor -> 
          GrayLevel[0]], {
          Part[$CellContext`f, 
           Floor[$CellContext`numfreq/2]], Part[$CellContext`m3, 
            Floor[$CellContext`numfreq/2]] + 2}]], PlotRange -> {{
          Part[$CellContext`f, 1], 
          Part[$CellContext`f, $CellContext`numfreq]}, {$CellContext`ymin - 
          10, $CellContext`ymax + 10}}, Frame -> True, 
       ImageSize -> {400, 400}, PlotLabel -> 
       StyleForm[$CellContext`nomlig, FontSize -> 11], FrameLabel -> {
         StyleForm["Frequ\[EHat]ncia [GHz]", FontSize -> 11], 
         StyleForm["Margens cr\[IAcute]ticas [dB]", FontSize -> 11]}, 
       DisplayFunction -> $DisplayFunction]]; $CellContext`margem3 = 0; 
    Print["   A margem cr\[IAcute]tica da liga\[CCedilla]\[ATilde]o \
\[EAcute]:\nm=", 
      $CellContext`numdb[$CellContext`mcritica], " dB."]; 
    Print["A frequ\[EHat]ncia \[OAcute]ptima \[EAcute] f=", 
      $CellContext`numhz[$CellContext`foptima], " GHz."]; 
    Print["A margem \[OAcute]ptima da liga\[CCedilla]\[ATilde]o \[EAcute] m=", 
      $CellContext`numdb[$CellContext`moptima], " dB."]],
  Evaluator->Automatic]],
