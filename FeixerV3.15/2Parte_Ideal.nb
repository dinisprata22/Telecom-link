Cell[TextData[{
 "\tA pot\[EHat]ncia de recep\[CCedilla]\[ATilde]o \[EAcute] calculada pela f\
\[OAcute]rmula de Friis, para valores de zona distante da antena de maiores \
dimens\[OTilde]es,   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "min"], "\[LessEqual]", 
    FractionBox[
     RowBox[{"2", "\[Times]", 
      SuperscriptBox[
       SubscriptBox["D", "ant"], "2"]}], "\[Lambda]"]}], TraditionalForm]]],
 " . No caso desta n\[ATilde]o estar na zona distante, introduza uma atenua\
\[CCedilla]\[ATilde]o suplementar (consultar cap\[IAcute]tulo 2.12, fig. 2.62 \
[1])."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

