Cell[TextData[StyleBox["\tO desvanecimento r\[AAcute]pido \[EAcute] calculado \
segundo m\[EAcute]todo da Recomenda\[CCedilla]\[ATilde]o P.530-8 da ITU-R \
(cap\[IAcute]tulo 3.3 [1]).\n\t",
 FontFamily->"Verdana",
 FontSize->11]], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Classifica\[CCedilla]\[ATilde]o", " ", "do", " ", "percurso", "  "}]}],
      ButtonFunction:>(Clear[$CellContext`classif]; If[
         Or[$CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
          1, $CellContext`bota17 =!= 1, $CellContext`bota18 =!= 
          1, $CellContext`bota19 =!= 1], 
         Print[
         "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
          N[$CellContext`botn]], If[
           Or[$CellContext`bota1101 =!= 1, $CellContext`bota1102 =!= 1], 
           Print[
           "Aten\[CCedilla]\[ATilde]o!!  Se desejar colocar um repetidor \
passivo volte \[AGrave] sec\[CCedilla]\[ATilde]o 1.", 
            
            N[$CellContext`botn]]]; $CellContext`classif = \
$CellContext`MyInput[
           "Introduza a classifica\[CCedilla]\[ATilde]o da liga\[CCedilla]\
\[ATilde]o.\nO percurso classifica-se por ser terrestre ou costeiro.", \
$CellContext`classif]; While[
           
           And[$CellContext`classif =!= $CellContext`terrestre, \
$CellContext`classif =!= $CellContext`costeiro], $CellContext`classif = \
$CellContext`MyInput[
            "Introduza a classifica\[CCedilla]\[ATilde]o da liga\[CCedilla]\
\[ATilde]o.\nO percurso classifica-se por ser terrestre ou costeiro.", \
$CellContext`classif]]; $CellContext`c0 = $CellContext`MyInput[
           "Introduza o valor de C0, que depende da menor das cotas das \
antenas terminais e do tipo de terreno.\nConsulte o cap. 3.3 [1].", \
$CellContext`c0]; $CellContext`clat = $CellContext`MyInput[
           "Introduza o valor de Clat, fun\[CCedilla]\[ATilde]o da latitude m\
\[EAcute]dia da liga\[CCedilla]\[ATilde]o.\nConsulte o cap. 3.3 [1].", \
$CellContext`clat]; $CellContext`clong = $CellContext`MyInput[
           "Introduza o valor de Clong, fun\[CCedilla]\[ATilde]o da longitude \
m\[EAcute]dia da liga\[CCedilla]\[ATilde]o.\nConsulte o cap. 3.3 [1].", \
$CellContext`clong]; $CellContext`pL = $CellContext`MyInput[
           
           "Introduza o tempo em que o gradiente m\[EAcute]dio da \
refractividade nos 100 m inferiores da atmosfera \[EAcute] inferior a -100 \
N/km, em [%].\nConsulte o cap. 3.3 [1].", $CellContext`pL]; $CellContext`\
\[Eta]Lat = $CellContext`MyInput[
           "Introduza a latitude do percurso em [\[Degree]]", $CellContext`\
\[Eta]Lat]]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Probabilidade", "    ", 
        SubscriptBox["\[ScriptCapitalP]", "A"], "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
         1, $CellContext`bota17 =!= 1, $CellContext`bota18 =!= 
         1, $CellContext`bota19 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], If[
          Or[$CellContext`bota1101 =!= 1, $CellContext`bota1102 =!= 1], 
          Print[
          "Aten\[CCedilla]\[ATilde]o!!  Se desejar colocar um repetidor \
passivo volte \[AGrave] sec\[CCedilla]\[ATilde]o 1.", 
           N[$CellContext`botn], 
           "\nOs calculos seguintes s\[ATilde]o para uma liga\[CCedilla]\
\[ATilde]o em raio directo."]]; $CellContext`bota121 = 1; $CellContext`botn = 
         13; $CellContext`desvanec = 35; 
        Print["Valor de \!\(\*SubscriptBox[\(c\), \(0\)]\):  ", \
$CellContext`c0, " ."]; 
        Print["Valor de \!\(\*SubscriptBox[\(c\), \(Lat\)]\):  ", \
$CellContext`clat, " ."]; 
        Print["Valor de \!\(\*SubscriptBox[\(c\), \(Long\)]\):  ", \
$CellContext`clong, " ."]; 
        Print["Tempo em que o gradiente m\[EAcute]dio da refractividade \
\[EAcute] inferior a -100 N/km:  pL= ", $CellContext`pL, " %."]; 
        Print["Latitude do percurso colocada:  \[Eta]Lat= ", $CellContext`\
\[Eta]Lat, "\[Degree] ."]; 
        Print["Classifica\[CCedilla]\[ATilde]o do percurso:  ", \
$CellContext`classif, " ."]; $CellContext`PA1 = 0; $CellContext`PA2 = 
         0; $CellContext`qt = 
         Table[
          0., {$CellContext`i, $CellContext`passivo + 
            1}, {$CellContext`j, $CellContext`numfreq}]; $CellContext`kfgt = \
((5 10^(-9)) 
           10^((-0.1) ($CellContext`c0 - $CellContext`clat - \
$CellContext`clong))) $CellContext`pL^1.5; $CellContext`kcl = (2.3 10^(-6)) 
          10^((-0.1) $CellContext`c0 - 0.011 
            Abs[$CellContext`\[Eta]Lat]); $CellContext`kcm = 
         10^(0.5 (Log[10, $CellContext`kfgt] + 
            Log[10, $CellContext`kcl])); $CellContext`kfgc = 
         10^((1 - $CellContext`rcl) 
            Log[10, $CellContext`kfgt] + (0.5 $CellContext`rcl) (
             Log[10, $CellContext`kcl] + Log[10, $CellContext`kcm])); 
        If[$CellContext`classif == $CellContext`terrestre, $CellContext`kgeo = \
$CellContext`kfgt; 
          Print["   O factor geoclim\[AAcute]tico no m\[EHat]s mais desfavor\
\[AAcute]vel, no percurso terrestre \[EAcute] K= ", 
            $CellContext`numpr[$CellContext`kgeo], " ."]]; 
        If[$CellContext`classif == $CellContext`costeiro, $CellContext`kgeo = \
$CellContext`kfgc; 
          Print["   O factor geoclim\[AAcute]tico no m\[EHat]s mais desfavor\
\[AAcute]vel, no percurso costeiro \[EAcute] K= ", 
            $CellContext`numpr[$CellContext`kgeo], " ."]]; $CellContext`h11[
           Pattern[$CellContext`ll, 
            Blank[]]] := If[$CellContext`ll == 1, $CellContext`hae, 
           
           Part[$CellContext`hemipassivo, $CellContext`ll - 
            1]]; $CellContext`l11[
           Pattern[$CellContext`ll, 
            Blank[]]] := If[$CellContext`ll == 1, 1, 
           
           Part[$CellContext`pontospassivo, $CellContext`ll - 
            1]]; $CellContext`h22[
           Pattern[$CellContext`ll, 
            Blank[]]] := 
         If[$CellContext`ll == $CellContext`passivo + 1, $CellContext`har, 
           Part[$CellContext`hrecpassivo, $CellContext`ll]]; $CellContext`l22[
          
           Pattern[$CellContext`ll, 
            Blank[]]] := 
         If[$CellContext`ll == $CellContext`passivo + 1, $CellContext`l, 
           
           Part[$CellContext`pontospassivo, $CellContext`ll]]; \
$CellContext`ppn[
           Pattern[$CellContext`aaux, 
            Blank[]]] := 
         10^(-($CellContext`aaux/10)); $CellContext`\[Epsilon]p[
           Pattern[$CellContext`cotar, 
            Blank[]], 
           Pattern[$CellContext`cotae, 
            Blank[]], 
           Pattern[$CellContext`dista, 
            Blank[]]] := 
         Abs[$CellContext`cotar - $CellContext`cotae]/$CellContext`dista; \
$CellContext`prob1[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := ((($CellContext`kgeo $CellContext`dist14^3.6) 
            Part[$CellContext`f, $CellContext`jj]^0.89) (1 + 
             Abs[$CellContext`\[Epsilon]14])^(-1.4)) \
$CellContext`ppn[$CellContext`aaux]; $CellContext`qav[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := (-20) (
           Log[10, -
             Log[1 - $CellContext`prob1[$CellContext`aaux, \
$CellContext`jj]]]/$CellContext`aaux); $CellContext`qtv[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            
            Blank[]]] := ($CellContext`qav[$CellContext`aaux, \
$CellContext`jj] - 2)/((1 + 0.3 10^(-($CellContext`aaux/20))) 
           10^((-0.016) $CellContext`aaux)) - 
          4.3 (10^(-($CellContext`aaux/20)) + $CellContext`aaux/
            800); $CellContext`qa[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`ii, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := 
         2 + ((1 + 0.3 10^(-($CellContext`aaux/20))) 
            10^((-0.016) $CellContext`aaux)) (
            Part[$CellContext`qt, $CellContext`ii, $CellContext`jj] + 
            4.3 (10^(-($CellContext`aaux/20)) + $CellContext`aaux/
               800)); $CellContext`prob2[
           Pattern[$CellContext`aaux, 
            Blank[]], 
           Pattern[$CellContext`ii, 
            Blank[]], 
           Pattern[$CellContext`jj, 
            Blank[]]] := 
         1 - Exp[-10^((-$CellContext`qa[$CellContext`aaux, $CellContext`ii, \
$CellContext`jj]) ($CellContext`aaux/20))]; 
        For[$CellContext`i = 1, $CellContext`i <= $CellContext`passivo + 1, 
          
          Increment[$CellContext`i], $CellContext`dist14 = (
             Part[$CellContext`d, 
               $CellContext`l22[$CellContext`i]] - Part[$CellContext`d, 
              $CellContext`l11[$CellContext`i]])/$CellContext`km; \
$CellContext`hemi14 = Part[$CellContext`h, 
              $CellContext`l11[$CellContext`i]] + \
$CellContext`h11[$CellContext`i]; $CellContext`hrec14 = Part[$CellContext`h, 
              $CellContext`l22[$CellContext`i]] + \
$CellContext`h22[$CellContext`i]; $CellContext`\[Epsilon]14 = $CellContext`\
\[Epsilon]p[$CellContext`hrec14, $CellContext`hemi14, $CellContext`dist14]; \
$CellContext`desvan = 
           Table[0., {$CellContext`j, $CellContext`numfreq}]; \
$CellContext`metodo2 = Table[0., {$CellContext`j, $CellContext`numfreq}]; 
          For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
            Increment[$CellContext`j], 
            Part[$CellContext`desvan, $CellContext`j] = 
             If[$CellContext`qtv[$CellContext`desvanec, $CellContext`j] > 0, 
               25, 35]; 
            Part[$CellContext`qt, $CellContext`i, $CellContext`j] = \
$CellContext`qtv[
               Part[$CellContext`desvan, $CellContext`j], $CellContext`j]; 
            Part[$CellContext`metodo2, $CellContext`j] = $CellContext`prob2[
               
               Part[$CellContext`desvan, $CellContext`j], $CellContext`i, \
$CellContext`j]]; 
          If[$CellContext`passivo >= 1, 
            Print["Tro\[CCedilla]o ", $CellContext`i, 
              " da liga\[CCedilla]\[ATilde]o:"]; 
            Print["   O m\[OAcute]dulo da inclina\[CCedilla]\[ATilde]o \
\[EAcute] \!\(\*SubscriptBox[\(\[Epsilon]\), \(p\)]\)=", 
              $CellContext`numdb[
               N[$CellContext`\[Epsilon]14]], " miliradianos."]; 
            Print["   O par\[AHat]metro \!\(\*SubscriptBox[\(q\), \(t\)]\) \
calculado com um desvanecimento de ", $CellContext`desvan, 
              " dB, \[EAcute]:\n   qt=", 
              $CellContext`numdb[
               Part[$CellContext`qt, $CellContext`i]], "."]; 
            Print["   A frac\[CCedilla]\[ATilde]o de tempo calculada pelo 2\
\.ba m\[EAcute]todo da Rec. P.530-8 \[EAcute]:\n   PA2=", 
              $CellContext`numpr[$CellContext`metodo2], 
              "."]; $CellContext`PA2 = $CellContext`PA2 + \
$CellContext`metodo2]]; 
        If[$CellContext`passivo == 0, 
          Print["   O m\[OAcute]dulo da inclina\[CCedilla]\[ATilde]o da liga\
\[CCedilla]\[ATilde]o \[EAcute] \!\(\*SubscriptBox[\(\[Epsilon]\), \(p\)]\)=", 
