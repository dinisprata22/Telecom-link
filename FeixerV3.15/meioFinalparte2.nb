    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Defini\[CCedilla]\[ATilde]o", " ", "das", " ", 
        "caracter\[IAcute]sticas", " ", "do", " ", "terreno", "  "}]}],
      ButtonFunction:>($CellContext`ss = $CellContext`MyInput[
         "Introduza os pontos de {{ inicio , fim , s }} para os \
tro\[CCedilla]os, ENTRE DUPLAS CHAVETAS, separados por v\[IAcute]rgulas.\n\
Exemplo com a defini\[CCedilla]\[ATilde]o de dois tro\[CCedilla]os:\n{{ 1 , \
25 , 0.01 },{ 25 ,50 , 0.001 }}\nNota: \[CapitalEAcute] necess\[AAcute]rio \
definir tro\[CCedilla]os com o respectivo s, que cubram todos os pontos do \
percurso.", $CellContext`ss]; $CellContext`Erros = If[
          Or[Part[$CellContext`ss, 1, 1] != 1, Part[$CellContext`ss, 
             Length[$CellContext`ss], 2] != $CellContext`l], False, True]; 
       For[$CellContext`i = 1, 
         And[$CellContext`i <= 
          Length[$CellContext`ss] - 1, $CellContext`Erros], 
         Increment[$CellContext`i], $CellContext`Erros = 
         If[Part[$CellContext`ss, $CellContext`i, 2] == 
           Part[$CellContext`ss, $CellContext`i + 1, 1], True, False]]; 
       If[$CellContext`Erros, 
         For[$CellContext`i = 1, $CellContext`i <= Length[$CellContext`ss], 
           Increment[$CellContext`i], 
           Print[
           "   O valor de s para o tro\[CCedilla]o definido entre os pontos ", 
            Part[$CellContext`ss, $CellContext`i, 1], " e ", 
            Part[$CellContext`ss, $CellContext`i, 2], " \[EAcute] ", 
            Part[$CellContext`ss, $CellContext`i, 3], " ."]]; $CellContext`s = 
          Table[{Part[$CellContext`ss, $CellContext`i, 
                1] $CellContext`divi - ($CellContext`divi - 1), 
             Part[$CellContext`ss, $CellContext`i, 
                2] $CellContext`divi - ($CellContext`divi - 1), 
             Part[$CellContext`ss, $CellContext`i, 3]}, {$CellContext`i, 
             Length[$CellContext`ss]}], 
         Print[
         "   Erro nos dados introduzidos.\n   N\[ATilde]o se \
esque\[CCedilla]a de colocar os tro\[CCedilla]os entre duplas chavetas.\n   \
Os tro\[CCedilla]os, entre chavetas e separados por v\[IAcute]rgulas, \
t\[EHat]m o seguinte formato:\n                 {{ ponto inicial do tro\
\[CCedilla]o , ponto final do tro\[CCedilla]o , valor de s neste tro\
\[CCedilla]o }}\n   Note que \[EAcute] necess\[AAcute]rio definir tro\
\[CCedilla]os, nem que seja apenas um, que cubra todos os pontos do \
perfil."]]),
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
