Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.7  Distribui\[CCedilla]\[ATilde]o da \
indisponibilidade",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tComprimentos m\[AAcute]ximos das sec\[CCedilla]\[OTilde]es \
r\[AAcute]dioel\[EAcute]ctricas e objectivos de indisponibilidade para cada \
uma das classes de qualidade de liga\[CCedilla]\[ATilde]o r\[AAcute]dioel\
\[EAcute]ctrica, nos termos da recomenda\[CCedilla]\[ATilde]o F.696-2 da \
ITU-R.\n\n\t\t\t\t\t",
 Cell[BoxData[
  StyleBox[GridBox[{
     {"Classe", 
      RowBox[{"Comprimento", "  ", "[", "km", "]"}], 
      RowBox[{"Indisponibilidade", "  ", "[", "%", "]"}]},
     {
      StyleBox["1",
       FontWeight->"Bold",
       FontColor->GrayLevel[0]], 
      StyleBox["280",
       FontWeight->"Bold",
       FontColor->GrayLevel[0]], 
      StyleBox["0.033",
       FontWeight->"Bold",
       FontColor->GrayLevel[0]]},
     {"2", "280", "0.05"},
     {"3", "50", "0.05"},
     {"4", "50", "0.1"}
    },
    GridBoxDividers->{
     "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
      "RowsIndexed" -> {}}],
   FontFamily->"Verdana",
   FontSize->11]]],
 "\n\t\t\t\t\t\n\n\tNo sentido da despenaliza\[CCedilla]\[ATilde]o das liga\
\[CCedilla]\[OTilde]es muito curtas, a recomenda\[CCedilla]\[ATilde]o F.695 \
da ITU-R sugere limitar o valor da dist\[AHat]ncia de \
liga\[CCedilla]\[ATilde]o (dkm)",
 "  ao m\[IAcute]nimo de 280",
 ".\n\tCompete ao projectista da liga\[CCedilla]\[ATilde]o distribuir a \
indisponibilidade total pelas diferentes causas."
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Comprimento", " ", "da", " ", "liga\[CCedilla]\[ATilde]o", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
         1, $CellContext`bota14 =!= 1, $CellContext`bota15 =!= 
         1, $CellContext`bota16 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`dlig = $CellContext`MyInput[
         "Introduza o comprimento do circuito fict\[IAcute]cio de \
refer\[EHat]ncia da liga\[CCedilla]\[ATilde]o em [km]\n(O valor do \
comprimento da liga\[CCedilla]\[ATilde]o est\[AAcute] na sec\[CCedilla]\
\[ATilde]o 1.1)", $CellContext`dlig]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Distribui\[CCedilla]\[ATilde]o", " ", "da", " ", "indisponibilidade", 
        " ", "m\[AAcute]xima", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
         1, $CellContext`bota14 =!= 1, $CellContext`bota15 =!= 
         1, $CellContext`bota16 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`percchuva = $CellContext`MyInput[
          "Introduza a percentagem da indisponibilidade m\[AAcute]xima para a \
chuva", $CellContext`percchuva]; $CellContext`percequip = \
$CellContext`MyInput[
          "Introduza a percentagem da indisponibilidade m\[AAcute]xima para o \
equipamento", $CellContext`percequip]; $CellContext`percoutros = 
         100 - $CellContext`percchuva - $CellContext`percequip],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", "Indisponibilidade", "  "}],
      ButtonFunction:>If[
        Or[$CellContext`bota12 =!= 1, $CellContext`bota13 =!= 
         1, $CellContext`bota14 =!= 1, $CellContext`bota15 =!= 
         1, $CellContext`bota16 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`bota17 = 1; $CellContext`botn = 
         8; Print[
         "Comprimento do circuito fict\[IAcute]cio de refer\[EHat]ncia da \
liga\[CCedilla]\[ATilde]o:  ", $CellContext`dlig, " km."]; 
        Print["Frac\[CCedilla]\[ATilde]o da indisponibilidade m\[AAcute]xima \
para a chuva:  ", 
          N[$CellContext`percchuva/100], " ."]; 
        Print["Frac\[CCedilla]\[ATilde]o da indisponibilidade m\[AAcute]xima \
para o equipamento:  ", 
          N[$CellContext`percequip/100], " ."]; 
        Print["Frac\[CCedilla]\[ATilde]o da indisponibilidade m\[AAcute]xima \
para outras causas:  ", 
          N[$CellContext`percoutros/100], 
          " ."]; $CellContext`\[ScriptCapitalI]max = (
           0.3 ($CellContext`dlig/2500)) (1/100); 
        Print["A indisponibilidade m\[AAcute]xima para a liga\[CCedilla]\
\[ATilde]o \[EAcute] \!\(\*SubscriptBox[\(\[ScriptCapitalI]\), \
\(m\[AAcute]x\)]\)= ", 
          $CellContext`numpr[$CellContext`\[ScriptCapitalI]max], 
          " ."]; $CellContext`\[ScriptCapitalI]chuva = \
($CellContext`percchuva/
           100) $CellContext`\[ScriptCapitalI]max; $CellContext`Panual = \
$CellContext`\[ScriptCapitalI]chuva; $CellContext`panual = 
         100 $CellContext`Panual; 
        Print["   A frac\[CCedilla]\[ATilde]o da indisponibilidade devida \
\[AGrave] precipita\[CCedilla]\[ATilde]o \[EAcute] \[ScriptCapitalI]chuva= ", \

          $CellContext`numpr[$CellContext`\[ScriptCapitalI]chuva], 
          " ."]; $CellContext`\[ScriptCapitalI]equip = \
($CellContext`percequip/100) $CellContext`\[ScriptCapitalI]max; 
        Print["   A frac\[CCedilla]\[ATilde]o da indisponibilidade devida ao \
equipamento \[EAcute] \!\(\*SubscriptBox[\(\[ScriptCapitalI]\), \(equip\)]\)= \
", 
          $CellContext`numpr[$CellContext`\[ScriptCapitalI]equip], 
          
          " ."]; $CellContext`\[ScriptCapitalI]outros = \
($CellContext`percoutros/100) $CellContext`\[ScriptCapitalI]max; 
        Print["   A frac\[CCedilla]\[ATilde]o da indisponibilidade devida a \
outras causas \[EAcute] \!\(\*SubscriptBox[\(\[ScriptCapitalI]\), \(outros\)]\
\)= ", 
          $CellContext`numpr[$CellContext`\[ScriptCapitalI]outros], " ."]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236006390625*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

