       Print["Valor da norma ESR = ", $CellContext`ESR]; \
$CellContext`esrchuvadiv = Table[0, {$CellContext`a, $CellContext`numfreq}]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         Part[$CellContext`esrchuvadiv, $CellContext`i] = ($CellContext`nn[] \
$CellContext`Nb[]) ($CellContext`rber/$CellContext`\[Alpha]33); 
         If[Part[$CellContext`esrchuvadiv, $CellContext`i] <= \
$CellContext`ESR, 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula cumprida, esrchuva=", 
            Part[$CellContext`esrchuvadiv, $CellContext`i]], 
           Print["f=", 
            Part[$CellContext`f, $CellContext`i], 
            " - Cl\[AAcute]usula n\[ATilde]o cumprida, esrchuva=", 
            Part[$CellContext`esrchuvadiv, $CellContext`i]]]]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
