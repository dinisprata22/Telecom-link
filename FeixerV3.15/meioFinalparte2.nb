Cell[CellGroupData[{

Cell[TextData[StyleBox["\t1.8  Atenua\[CCedilla]\[ATilde]o provocada por \
hidrometeoritos",
 FontColor->RGBColor[1, 1, 0]]], "Section",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->14,
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[TextData[{
 "\tOs valores de \[Kappa] e \[Alpha]  (fun\[CCedilla]\[OTilde]es da frequ\
\[EHat]ncia, da temperatura, da forma e distribui\[CCedilla]\[ATilde]o estat\
\[IAcute]stica da dimens\[ATilde]o das gotas de \[AAcute]gua), para as \
polariza\[CCedilla]\[OTilde]es horizontal e vertical, est\[ATilde]o descritas \
pela recomenda\[CCedilla]\[ATilde]o P.838-1 da ITU-R.\n\tA distribui\
\[CCedilla]\[ATilde]o acumulada da intensidade da precipita\[CCedilla]\
\[ATilde]o ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]]],
 " (mm/h) nas zonas H e K (a do continente Europeu) observa-se da seguinte \
tabela (esta faz parte da recomenda\[CCedilla]\[ATilde]o P.837-1 da ITU-R).\n\
\n\t\t\t\t",
 Cell[BoxData[
  StyleBox[GridBox[{
     {
      RowBox[{
       RowBox[{"Intensidade", " ", "de"}], "\n", "  ", 
       "precipita\[CCedilla]\[ATilde]o", "\n", "\t\t\t", 
       RowBox[{"(", 
        RowBox[{"mm", "/", "h"}], ")"}], "\n", "\t      ", 
       RowBox[{"Zona", " ", "H"}]}], 
      RowBox[{
       RowBox[{"Intensidade", " ", "de"}], "\n", "  ", 
       "precipita\[CCedilla]\[ATilde]o", "\n", "\t\t\t", 
       RowBox[{"(", 
        RowBox[{"mm", "/", "h"}], ")"}], "\n", "\t      ", 
       RowBox[{"Zona", " ", "K"}]}], 
      RowBox[{"  ", 
       RowBox[{
        RowBox[{
         RowBox[{"Percentagem", " ", "de", " ", "tempo"}], ",", "\n", "   ", 
         RowBox[{"no", " ", "ano"}], ",", 
         RowBox[{"em", " ", "que", " ", "o", " ", "valor"}]}], "\n", "      ", 
        RowBox[{"da", " ", "intensidade", " ", "de"}], "\n", 
        RowBox[{
        "precipita\[CCedilla]\[ATilde]o", " ", "\[EAcute]", " ", 
         "excedido"}]}]}]},
     {"2", "1.5", "1"},
     {"4", "4.2", "0.3"},
     {"10", "12", "0.1"},
     {"18", "23", "0.03"},
     {"32", 
      StyleBox["42",
       FontWeight->"Bold",
       FontColor->GrayLevel[0],
       Background->None], 
      StyleBox["0.01",
       FontWeight->"Bold",
       FontColor->GrayLevel[0],
       Background->None]},
     {"55", "70", "0.003"},
     {
      RowBox[{Cell[""], "83"}], "100", "0.001"}
    },
    GridBoxDividers->{
     "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
      "RowsIndexed" -> {}}],
   FontFamily->"Verdana"]]],
 "\n\t\t\t\t"
}], "Text",
 CellMargins->{{36, 48}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontSize->11,
 FontColor->RGBColor[0, 0, 1],
 Background->None],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Intensidade", " ", "de", " ", "precipita\[CCedilla]\[ATilde]o", 
        "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota13 =!= 1, $CellContext`bota14 =!= 
         1, $CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
         1, $CellContext`bota17 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`Rint = $CellContext`MyInput[
         "Introduza a intensidade de precipita\[CCedilla]\[ATilde]o em \
[mm/h]", $CellContext`Rint]],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{
       "Percentagem", " ", "de", " ", "tempo", " ", "no", " ", "ano", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota13 =!= 1, $CellContext`bota14 =!= 
         1, $CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
         1, $CellContext`bota17 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`Panual = $CellContext`MyInput[
          "Introduza a frac\[CCedilla]\[ATilde]o anual n\[ATilde]o excedida \
de tempo, devida \[AGrave] precipita\[CCedilla]\[ATilde]o no percurso.\nEste \
valor \[EAcute] dado pela indisponibilidade associada \[AGrave] chuva, sec\
\[CCedilla]\[ATilde]o 1.7 .\nO expoente \[EAcute] feito com um ^ .", \
$CellContext`Panual]; $CellContext`panual = 100 $CellContext`Panual],
      Evaluator->Automatic],
     FontColor->GrayLevel[1]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Polariza\[CCedilla]\[ATilde]o", " ", "vertical", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota13 =!= 1, $CellContext`bota14 =!= 
         1, $CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
         1, $CellContext`bota17 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`bota18 = 1; $CellContext`botn = 
         9; $CellContext`i = 1; $CellContext`\[Kappa]1 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`\
\[Kappa]2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`\
\[Alpha]1 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`\
\[Alpha]2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`f1 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`f2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; 
        For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
          Increment[$CellContext`j], 
          While[Part[$CellContext`rh, $CellContext`i, 1] < 
            Part[$CellContext`f, $CellContext`j], $CellContext`i = \
$CellContext`i + 1]; 
          Part[$CellContext`f1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 1] 10^9; 
          Part[$CellContext`f2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 1] 10^9; 
          Part[$CellContext`\[Kappa]1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 3]; 
          Part[$CellContext`\[Kappa]2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 3]; 
          Part[$CellContext`\[Alpha]1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 5]; 
          Part[$CellContext`\[Alpha]2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 5]]; $CellContext`\[Kappa] = 
         10^(Log[10, $CellContext`\[Kappa]1] + ((
              Log[10, $CellContext`\[Kappa]2] - Log[
              10, $CellContext`\[Kappa]1])/(Log[10, $CellContext`f2] - Log[
             10, $CellContext`f1])) (Log[10, $CellContext`fhz] - Log[
             10, $CellContext`f1])); 
        Print["\nAntenas utilizando polariza\[CCedilla]\[ATilde]o vertical:"]; 
        Print["Intensidade de precipita\[CCedilla]\[ATilde]o:  ", \
$CellContext`Rint, " mm/h."]; 
        Print["Frac\[CCedilla]\[ATilde]o de tempo no ano em que o valor da \
intensidade de precipita\[CCedilla]\[ATilde]o \[EAcute] excedido:  ", 
          $CellContext`numpr[$CellContext`Panual], " ."]; 
        Print["Valor de \[Kappa] \[AGrave] frequ\[EHat]ncia imposta \
\[EAcute]:\n\[Kappa]=", 
          $CellContext`numpr[$CellContext`\[Kappa]], 
          "."]; $CellContext`\[Alpha] = $CellContext`\[Alpha]1 + \
(($CellContext`\[Alpha]2 - $CellContext`\[Alpha]1)/(Log[10, $CellContext`f2] - 
            Log[10, $CellContext`f1])) (Log[10, $CellContext`fhz] - Log[
            10, $CellContext`f1]); 
        Print["Valor de \[Alpha] \[AGrave] frequ\[EHat]ncia imposta \
\[EAcute]:\n\[Alpha]=", 
          $CellContext`numhz[$CellContext`\[Alpha]], 
          "."]; $CellContext`\[Gamma] = $CellContext`\[Kappa] \
$CellContext`Rint^$CellContext`\[Alpha]; 
        Print["O coeficiente de atenua\[CCedilla]\[ATilde]o por unidade de \
comprimento:\n\[Gamma]=", 
          $CellContext`numhz[$CellContext`\[Gamma]], 
          "."]; $CellContext`Def = $CellContext`dkm/(
          1 + $CellContext`dkm/(35 Exp[(-0.015) $CellContext`Rint])); 
        Print["O comprimento eficaz do percurso \[EAcute] Def=", 
          $CellContext`numhz[$CellContext`Def], 
          " km."]; $CellContext`Ar = $CellContext`\[Gamma] $CellContext`Def; 
        Print["Atenua\[CCedilla]\[ATilde]o da chuva n\[ATilde]o excedida em \
mais de 0.01% do tempo:\nAr=", 
          $CellContext`numdb[$CellContext`Ar], " dB."]; $CellContext`Arain[
           Pattern[$CellContext`pp, 
            Blank[]]] := ($CellContext`Ar 
           0.12) $CellContext`pp^(-(0.546 + 
             0.043 Log[
               10, $CellContext`pp])); $CellContext`achuva = \
$CellContext`Arain[$CellContext`panual]; 
        Print["Atenua\[CCedilla]\[ATilde]o da chuva n\[ATilde]o excedida em \
mais de Panual= ", 
          $CellContext`numpr[$CellContext`Panual], " do tempo:\nachuva=", 
          $CellContext`numdb[$CellContext`achuva], " dB."]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]], 
    StyleBox[
     ButtonBox[
      RowBox[{"  ", 
       RowBox[{"Polariza\[CCedilla]\[ATilde]o", " ", "horizontal", "  "}]}],
      ButtonFunction:>If[
        Or[$CellContext`bota13 =!= 1, $CellContext`bota14 =!= 
         1, $CellContext`bota15 =!= 1, $CellContext`bota16 =!= 
         1, $CellContext`bota17 =!= 1], 
        Print[
        "Aten\[CCedilla]\[ATilde]o!!  Passe primeiro pela sec\[CCedilla]\
\[ATilde]o 1.", 
         N[$CellContext`botn]], $CellContext`bota18 = 1; $CellContext`botn = 
         9; $CellContext`i = 1; $CellContext`\[Kappa]1 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`\
\[Kappa]2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`\
\[Alpha]1 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`\
\[Alpha]2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`f1 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; $CellContext`f2 = 
         Table[0., {$CellContext`i, $CellContext`numfreq}]; 
        For[$CellContext`j = 1, $CellContext`j <= $CellContext`numfreq, 
          Increment[$CellContext`j], 
          While[Part[$CellContext`rh, $CellContext`i, 1] < 
            Part[$CellContext`f, $CellContext`j], $CellContext`i = \
$CellContext`i + 1]; 
          Part[$CellContext`f1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 1] 10^9; 
          Part[$CellContext`f2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 1] 10^9; 
          Part[$CellContext`\[Kappa]1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 2]; 
          Part[$CellContext`\[Kappa]2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 2]; 
          Part[$CellContext`\[Alpha]1, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i - 1, 4]; 
          Part[$CellContext`\[Alpha]2, $CellContext`j] = 
           Part[$CellContext`rh, $CellContext`i, 4]]; $CellContext`\[Kappa] = 
         10^(Log[10, $CellContext`\[Kappa]1] + ((
              Log[10, $CellContext`\[Kappa]2] - Log[
              10, $CellContext`\[Kappa]1])/(Log[10, $CellContext`f2] - Log[
             10, $CellContext`f1])) (Log[10, $CellContext`fhz] - Log[
             10, $CellContext`f1])); 
        Print["\nAntenas utilizando polariza\[CCedilla]\[ATilde]o \
horizontal:"]; 
        Print["Intensidade de precipita\[CCedilla]\[ATilde]o:  ", \
$CellContext`Rint, " mm/h."]; 
        Print["Frac\[CCedilla]\[ATilde]o de tempo no ano em que o valor da \
intensidade de precipita\[CCedilla]\[ATilde]o \[EAcute] excedido:  ", 
          $CellContext`numpr[$CellContext`Panual], " %."]; 
        Print["Valor de \[Kappa] \[AGrave] frequ\[EHat]ncia imposta \
\[EAcute]:\n\[Kappa]=", 
          $CellContext`numpr[$CellContext`\[Kappa]], 
          "."]; $CellContext`\[Alpha] = $CellContext`\[Alpha]1 + \
(($CellContext`\[Alpha]2 - $CellContext`\[Alpha]1)/(Log[10, $CellContext`f2] - 
            Log[10, $CellContext`f1])) (Log[10, $CellContext`fhz] - Log[
            10, $CellContext`f1]); 
        Print["   Valor de \[Alpha] \[AGrave] frequ\[EHat]ncia imposta \
\[EAcute]:\n\[Alpha]=", 
          $CellContext`numhz[$CellContext`\[Alpha]], 
          "."]; $CellContext`\[Gamma] = $CellContext`\[Kappa] \
$CellContext`Rint^$CellContext`\[Alpha]; 
        Print["O coeficiente de atenua\[CCedilla]\[ATilde]o por unidade de \
comprimento:\n\[Gamma]=", 
          $CellContext`numhz[$CellContext`\[Gamma]], 
          "."]; $CellContext`Def = $CellContext`dkm/(
          1 + $CellContext`dkm/(35 Exp[(-0.015) $CellContext`Rint])); 
        Print["   O comprimento eficaz do percurso \[EAcute] Def=", 
          $CellContext`numhz[$CellContext`Def], 
          " km."]; $CellContext`Ar = $CellContext`\[Gamma] $CellContext`Def; 
        Print["Atenua\[CCedilla]\[ATilde]o da chuva n\[ATilde]o excedida em \
mais de 0.01% do tempo:\nAr=", 
          $CellContext`numdb[$CellContext`Ar], " dB."]; $CellContext`Arain[
           Pattern[$CellContext`pp, 
            Blank[]]] := ($CellContext`Ar 
           0.12) $CellContext`pp^(-(0.546 + 
             0.043 Log[
               10, $CellContext`pp])); $CellContext`achuva = \
$CellContext`Arain[$CellContext`panual]; 
        Print["Atenua\[CCedilla]\[ATilde]o da chuva n\[ATilde]o excedida em \
mais de Panual= ", 
          $CellContext`numpr[$CellContext`Panual], " % do tempo:\nachuva=", 
          $CellContext`numdb[$CellContext`achuva], " dB."]],
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
