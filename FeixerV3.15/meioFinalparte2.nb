Cell[CellGroupData[{

Cell[TextData[StyleBox["\t\t\t3.10.7  Cl\[AAcute]usula da indisponibilidade \
devido \[AGrave] chuva ",
 FontColor->RGBColor[1, 1, 0]]], "Subsubsection",
 CellFrame->True,
 CellMargins->{{19, 10}, {Inherited, Inherited}},
 FontFamily->"Verdana",
 FontColor->GrayLevel[1],
 Background->RGBColor[0, 0, 1]],

Cell[BoxData[GridBox[{
   {
    StyleBox[
     ButtonBox[
      RowBox[{" ", 
       RowBox[{
       "Indisponibilidade", " ", "devido", " ", "\[AGrave]", " ", "chuva", 
        " "}]}],
      ButtonFunction:>($CellContext`CNforIND[] := 
        Module[{$CellContext`pind, $CellContext`ArainIND, \
$CellContext`CNCIPminIND}, $CellContext`pind = ($CellContext`indchuva 0.3) (
             Max[$CellContext`dliga, 280]/
             2500); $CellContext`ArainIND = \
$CellContext`Arain[$CellContext`pind]; $CellContext`CNCIPminIND = \
$CellContext`CNberIND + $CellContext`ArainIND]; $CellContext`INDchuva = \
$CellContext`CNforIND[]; 
       For[$CellContext`i = 1, $CellContext`i < $CellContext`numfreq + 1, 
         Increment[$CellContext`i], 
         If[
         Part[$CellContext`cn, $CellContext`i] >= 
          Part[$CellContext`INDchuva, $CellContext`i], 
          Print["f=", 
           Part[$CellContext`f, $CellContext`i], 
           " - Cl\[AAcute]usula cumprida, (C/N)=", 
           Part[$CellContext`cn, $CellContext`i], " dB; (C/N)min=", 
           Part[$CellContext`INDchuva, $CellContext`i], " dB"], 
          Print["f=", 
           Part[$CellContext`f, $CellContext`i], 
           " - Cl\[AAcute]usula n\[ATilde]o cumprida, (C/N)=", 
           Part[$CellContext`cn, $CellContext`i], " dB; (C/N)min=", 
           Part[$CellContext`INDchuva, $CellContext`i], " dB"]]]; 
       Print["A rela\[CCedilla]\[ATilde]o portadora/ru\[IAcute]do necess\
\[AAcute]ria para cumprir a cl\[AAcute]usula da indisponibilidade devido \
\[AGrave] chuva \[EAcute] (\!\(\*FractionBox[\(C\), \
\(N\)]\)\!\(\*SubscriptBox[\()\), \(CIP_ind\)]\)=", 
         $CellContext`numdb[
          $CellContext`CNforIND[]], " dB."]),
      Evaluator->Automatic],
     FontColor->RGBColor[1, 1, 0]]}
  }]],
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.515236009*^9},
 ButtonBoxOptions->{Background->RGBColor[0, 0, 1]}],

